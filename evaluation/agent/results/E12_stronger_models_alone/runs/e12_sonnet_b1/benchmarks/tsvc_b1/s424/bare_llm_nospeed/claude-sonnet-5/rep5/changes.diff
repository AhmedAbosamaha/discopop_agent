@@ -18,8 +18,17 @@
     int vl = 63;
     xx = flat_2d_array + vl;
     for (int nl = 0; nl < R; nl++) {
-        for (int i = 0; i < LEN_1D - 1; i++) {
-            xx[i+1] = flat_2d_array[i] + a[i];
+        /* xx[i+1] aliases flat_2d_array[i+vl+1], so this loop writes index i+64
+         * while reading index i: a true recurrence of stride vl+1=64. Indices
+         * with the same (i mod (vl+1)) form an independent chain that must run
+         * in increasing order; chains for different residues never touch the
+         * same element, so the residue loop below is safe to parallelize while
+         * each chain itself stays sequential. */
+        #pragma omp parallel for default(none) firstprivate(vl) shared(xx, flat_2d_array, a)
+        for (int r = 0; r <= vl; r++) {
+            for (int i = r; i < LEN_1D - 1; i += vl + 1) {
+                xx[i+1] = flat_2d_array[i] + a[i];
+            }
         }
         pb_mix(nl);
     }
