 /* Between two repetitions a few INPUT elements change, so no repetition can be skipped,
  * merged with another or run out of order: the repetition loop is sequential by a true
@@ -15,13 +16,31 @@
 
 static real_t kernel_s211(void)
 {
+    /* Heap buffer holding the new values of b for one repetition, so that the
+     * loop reading old b[i+1] never overlaps with the writes to b[i]. */
+    real_t *bt = (real_t *)malloc(sizeof(real_t) * (size_t)LEN_1D);
     for (int nl = 0; nl < R; nl++) {
+        if (LEN_1D > 2) {
+            /* i = 1: b[0] is never written, so a[1] uses the unchanged b[0]. */
+            a[1]  = b[0] + c[1] * d[1];
+            bt[1] = b[2] - e[1] * d[1];
+        }
+        /* For i >= 2 the original reads the new b[i-1] = old b[i] - e[i-1]*d[i-1];
+         * recompute it from the old (still unmodified) b with the same rounding. */
+        #pragma omp parallel for default(none) shared(a, b, c, d, e, bt) schedule(static)
+        for (int i = 2; i < LEN_1D-1; i++) {
+            real_t bn = b[i] - e[i - 1] * d[i - 1];
+            a[i]  = bn + c[i] * d[i];
+            bt[i] = b[i + 1] - e[i] * d[i];
+        }
+        /* All reads of old b are done; commit the new values. */
+        #pragma omp parallel for default(none) shared(b, bt) schedule(static)
         for (int i = 1; i < LEN_1D-1; i++) {
-            a[i] = b[i - 1] + c[i] * d[i];
-            b[i] = b[i + 1] - e[i] * d[i];
+            b[i] = bt[i];
         }
         pb_mix(nl);
     }
+    free(bt);
     return (real_t)0;
 }
 
