 /* Between two repetitions a few INPUT elements change, so no repetition can be skipped,
  * merged with another or run out of order: the repetition loop is sequential by a true
@@ -15,13 +16,28 @@
 
 static real_t kernel_s211(void)
 {
+    /* Scratch buffer for the new values of b: heap-allocated, size grows with LEN_1D. */
+    real_t *tmp = (real_t *)malloc((size_t)LEN_1D * sizeof(real_t));
     for (int nl = 0; nl < R; nl++) {
+        /* Peeled i = 1: b[0] is never written, so a[1] reads the original b[0]. */
+        a[1] = b[0] + c[1] * d[1];
+        /* a[i] depends on the NEW b[i-1] = b_old[i] - e[i-1]*d[i-1]; recompute it from the
+         * old b[i] so iterations are independent.  New b[i] goes into tmp (reads old b[i+1]). */
+        #pragma omp parallel for shared(a, b, c, d, e, tmp)
+        for (int i = 2; i < LEN_1D-1; i++) {
+            real_t bm1 = b[i] - e[i - 1] * d[i - 1];
+            a[i] = bm1 + c[i] * d[i];
+            tmp[i] = b[i + 1] - e[i] * d[i];
+        }
+        tmp[1] = b[2] - e[1] * d[1];
+        /* Copy the new b values back once every old b has been consumed. */
+        #pragma omp parallel for shared(b, tmp)
         for (int i = 1; i < LEN_1D-1; i++) {
-            a[i] = b[i - 1] + c[i] * d[i];
-            b[i] = b[i + 1] - e[i] * d[i];
+            b[i] = tmp[i];
         }
         pb_mix(nl);
     }
+    free(tmp);
     return (real_t)0;
 }
 
