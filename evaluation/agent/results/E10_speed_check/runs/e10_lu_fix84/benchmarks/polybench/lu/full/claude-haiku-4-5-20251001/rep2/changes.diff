--- original.c
+++ final.c
@@ -62,8 +62,13 @@
 #pragma scop
   for (k = 0; k < _PB_N; k++)
     {
+      /* Normalize pivot row: each j iteration is independent */
+#pragma omp parallel for shared(A) firstprivate(k)
       for (j = k + 1; j < _PB_N; j++)
 	A[k][j] = A[k][j] / A[k][k];
+
+      /* Eliminate: collapse both loops for fine-grained parallelism */
+#pragma omp parallel for collapse(2) shared(A) firstprivate(k)
       for(i = k + 1; i < _PB_N; i++)
 	for (j = k + 1; j < _PB_N; j++)
 	  A[i][j] = A[i][j] - A[i][k] * A[k][j];
