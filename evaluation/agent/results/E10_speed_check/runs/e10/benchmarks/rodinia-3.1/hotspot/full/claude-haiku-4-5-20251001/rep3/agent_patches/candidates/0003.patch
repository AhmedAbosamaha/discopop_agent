+                /* Compute next thermal state: read from src, write to dst */
+                single_iteration(dst, src, power, row, col, Cap_1, Rx_1, Ry_1, Rz_1, step);
+
+                /* Prepare for next iteration: swap buffers so dst output becomes src input */
+                FLOAT* tmp = src;
+                src = dst;
+                dst = tmp;
+            }
