 void s151s(real_t a[LEN_1D], real_t b[LEN_1D],  int m)
 {
+    real_t *temp = malloc((LEN_1D-1) * sizeof(real_t));
+
+    /* Parallelize computation into temporary buffer: each iteration i independently
+     * computes temp[i] from a[i+m] and b[i]. No loop-carried dependence since each
+     * thread writes to unique temp[i] and reads from shared a, b (no writes to them).
+     */
+    #pragma omp parallel for shared(a, b, temp, m)
     for (int i = 0; i < LEN_1D-1; i++) {
-        a[i] = a[i + m] + b[i];
+        temp[i] = a[i + m] + b[i];
     }
+
+    /* Parallelize copying results back to array a: each iteration i independently
+     * copies from temp[i] to a[i]. No loop-carried dependence.
+     */
+    #pragma omp parallel for shared(a, temp)
+    for (int i = 0; i < LEN_1D-1; i++) {
+        a[i] = temp[i];
+    }
+
+    free(temp);
 }
 
