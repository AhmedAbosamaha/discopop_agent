 void s151s(real_t a[LEN_1D], real_t b[LEN_1D],  int m)
 {
+    /* Allocate temporary buffer to break anti-dependence:
+     * read from unchanging copy, write to distinct array locations */
+    real_t *a_copy = malloc(LEN_1D * sizeof(real_t));
+    memcpy(a_copy, a, LEN_1D * sizeof(real_t));
+
+    #pragma omp parallel for shared(a, a_copy, b)
     for (int i = 0; i < LEN_1D-1; i++) {
-        a[i] = a[i + m] + b[i];
+        a[i] = a_copy[i + m] + b[i];
     }
+
+    free(a_copy);
 }
 
