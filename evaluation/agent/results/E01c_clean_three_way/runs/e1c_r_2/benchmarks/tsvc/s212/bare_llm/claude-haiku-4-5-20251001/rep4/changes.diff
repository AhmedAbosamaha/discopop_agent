 static real_t kernel_s212(void)
 {
+    /* Snapshot of 'a' at start of each nl iteration to resolve anti-dependence:
+       iteration i reads a[i+1], iteration i+1 writes a[i+1].
+       Using a snapshot lets all i iterations run in parallel. */
+    real_t *a_read = (real_t*)malloc((size_t)LEN_1D * sizeof(real_t));
+
     for (int nl = 0; nl < R; nl++) {
+        /* Copy current state of a[] for all iterations to read */
+        memcpy(a_read, a, (size_t)LEN_1D * sizeof(real_t));
+
+        /* Parallel loop: each iteration i accesses different elements of a, b, c, d, a_read.
+           All reads from a_read[i+1] are independent (snapshot taken before loop).
+           All writes to a[i] and b[i] are independent (different elements per iteration). */
+        #pragma omp parallel for
         for (int i = 0; i < LEN_1D-1; i++) {
             a[i] *= c[i];
-            b[i] += a[i + 1] * d[i];
+            b[i] += a_read[i + 1] * d[i];
         }
         pb_mix(nl);
     }
+    free(a_read);
     return (real_t)0;
 }
 
