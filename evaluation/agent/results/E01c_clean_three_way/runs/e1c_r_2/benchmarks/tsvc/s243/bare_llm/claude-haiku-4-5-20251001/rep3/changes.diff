@@ -130,14 +130,28 @@
 
 static real_t kernel_s243(void)
 {
+    real_t *a_old = (real_t*)malloc((size_t)LEN_1D * sizeof(real_t));
+    if (!a_old) return (real_t)0;
+
     for (int nl = 0; nl < R; nl++) {
+        /* Copy current values of a to a_old to break the forward dependence
+           (iteration i reads a[i+1], which would be modified by iteration i+1) */
+        for (int i = 0; i < LEN_1D; i++) {
+            a_old[i] = a[i];
+        }
+
+        /* Inner loop can now be parallelized: iteration i reads a_old[i+1] (invariant),
+           and each iteration i writes independently to a[i] and b[i].
+           No dependence: i reads a_old[i+1], i+1 reads a_old[i+2] - different locations */
+        #pragma omp parallel for shared(a, b, c, d, e, a_old)
         for (int i = 0; i < LEN_1D-1; i++) {
             a[i] = b[i] + c[i  ] * d[i];
             b[i] = a[i] + d[i  ] * e[i];
-            a[i] = b[i] + a[i+1] * d[i];
+            a[i] = b[i] + a_old[i+1] * d[i];
         }
         pb_mix(nl);
     }
+    free(a_old);
     return (real_t)0;
 }
 
