 static real_t kernel_s244(void)
 {
+    real_t *a_temp = (real_t*)malloc((size_t)LEN_1D * sizeof(real_t));
+    real_t *a_temp_1 = (real_t*)malloc((size_t)LEN_1D * sizeof(real_t));
+
     for (int nl = 0; nl < R; nl++) {
+        /* Initialize a_temp from current values of a */
+        #pragma omp parallel for shared(a_temp, a)
+        for (int i = 0; i < LEN_1D; ++i) {
+            a_temp[i] = a[i];
+        }
+
+        /* Main computation: uses temporary arrays to break output dependence.
+         * a_temp[i] = b[i] + c[i] * d[i];  (final value for a[i], for i < LEN_1D-1)
+         * a_temp_1[i+1] = b[i] + a[i+1] * d[i];  (intermediate, overwritten by next iteration's write to a[i+1])
+         * After this loop, each iteration has written to distinct locations. */
+        #pragma omp parallel for shared(a_temp, a_temp_1, b, c, d, a)
         for (int i = 0; i < LEN_1D-1; ++i) {
-            a[i] = b[i] + c[i] * d[i];
+            a_temp[i] = b[i] + c[i] * d[i];
             b[i] = c[i] + b[i];
-            a[i+1] = b[i] + a[i+1] * d[i];
+            a_temp_1[i+1] = b[i] + a[i+1] * d[i];
         }
+
+        /* Copy results back to a: a[i<LEN_1D-1] from a_temp, a[LEN_1D-1] from a_temp_1 */
+        #pragma omp parallel for shared(a, a_temp)
+        for (int i = 0; i < LEN_1D-1; ++i) {
+            a[i] = a_temp[i];
+        }
+        a[LEN_1D-1] = a_temp_1[LEN_1D-1];
+
         pb_mix(nl);
     }
+
+    free(a_temp);
+    free(a_temp_1);
     return (real_t)0;
 }
 
