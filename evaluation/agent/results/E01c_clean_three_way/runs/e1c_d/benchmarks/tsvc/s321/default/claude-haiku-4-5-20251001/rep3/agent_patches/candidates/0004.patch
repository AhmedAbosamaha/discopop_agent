 static real_t kernel_s321(void)
 {
+    real_t *a_tmp = (real_t*)malloc((size_t)LEN_1D * sizeof(real_t));
+    if (!a_tmp) return (real_t)0;
+
     for (int nl = 0; nl < R; nl++) {
+        memcpy(a_tmp, a, (size_t)LEN_1D * sizeof(real_t));
+
+        // Stage 1: Compute products into a_tmp (embarrassingly parallel - no loop-carried dep)
         for (int i = 1; i < LEN_1D; i++) {
-            a[i] += a[i-1] * b[i];
+            a_tmp[i] = a[i] + a[i-1] * b[i];
         }
+
+        // Stage 2: Propagate cumulative updates sequentially to match original order
+        for (int i = 2; i < LEN_1D; i++) {
+            a_tmp[i] += (a_tmp[i-1] - a[i-1]) * b[i];
+        }
+
+        memcpy(a, a_tmp, (size_t)LEN_1D * sizeof(real_t));
         pb_mix(nl);
     }
+    free(a_tmp);
     return (real_t)0;
 }
 