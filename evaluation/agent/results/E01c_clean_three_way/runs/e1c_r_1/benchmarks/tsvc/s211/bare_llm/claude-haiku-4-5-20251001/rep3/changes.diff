 static real_t kernel_s211(void)
 {
     for (int nl = 0; nl < R; nl++) {
+        /* Phase 1: Compute all new b values in parallel.
+         * Each iteration i reads b[i+1] (original/immutable in parallel execution)
+         * and computes b[i]. No iteration reads b[i] within this phase, so
+         * iterations are independent (no loop-carried flow dependence).
+         * Variables: i (private, loop var); a,b,c,d,e (shared); no updates needed. */
+        #pragma omp parallel for
