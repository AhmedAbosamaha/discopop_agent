 static real_t kernel_s211(void)
 {
+    real_t* b_start = (real_t*)malloc(LEN_1D * sizeof(real_t));
+
     for (int nl = 0; nl < R; nl++) {
+        /* Cache the current state of b at the start of each inner loop iteration.
+         * This allows us to parallelize the inner loop: each iteration reads from
+         * the cached b_start (no race), writes to unique a[i] and b[i] indices
+         * (no race), and produces identical results because a[i] and b[i] depend
+         * only on the initial b state, not on updates within this iteration. */
+        memcpy(b_start, b, LEN_1D * sizeof(real_t));
+
+        #pragma omp parallel for shared(a, b, c, d, e, b_start)
         for (int i = 1; i < LEN_1D-1; i++) {
-            a[i] = b[i - 1] + c[i] * d[i];
-            b[i] = b[i + 1] - e[i] * d[i];
+            /* Derived formula: a[i] and b[i] depend only on b_start (initial b state),
+             * not on updates within this loop. For i>1, b[i-1] has been updated from
+             * b_start[i] by subtracting e[i-1]*d[i-1]. This formula reconstructs
+             * the sequential behavior: a[i] reads the updated b[i-1], which is
+             * b_start[i] - e[i-1]*d[i-1]. b[i] always reads b_start[i+1]. */
+            a[i] = (i == 1 ? b_start[0] : b_start[i] - e[i-1]*d[i-1]) + c[i]*d[i];
+            b[i] = b_start[i+1] - e[i]*d[i];
         }
+
         pb_mix(nl);
     }
+
+    free(b_start);
     return (real_t)0;
 }
 
