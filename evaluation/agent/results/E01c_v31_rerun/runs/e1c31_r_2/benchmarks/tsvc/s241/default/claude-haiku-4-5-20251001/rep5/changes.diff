 static real_t kernel_s241(void)
 {
+    // Allocate buffer outside loop to hold pre-iteration snapshot of a
+    real_t *a_save = (real_t*)malloc(LEN_1D * sizeof(real_t));
+
     for (int nl = 0; nl < R; nl++) {
+        // Save a values from start of loop to preserve a[i+1] reads
+        #pragma omp parallel for shared(a_save) 
+        for (int i = 0; i < LEN_1D; i++) {
+            a_save[i] = a[i];
+        }
+
+        // Compute new a[i] values
+        #pragma omp parallel for 
         for (int i = 0; i < LEN_1D-1; i++) {
             a[i] = b[i] * c[i  ] * d[i];
-            b[i] = a[i] * a[i+1] * d[i];
         }
+
+        // Compute b[i] using new a[i] and saved a[i+1]
+        #pragma omp parallel for shared(a_save) 
+        for (int i = 0; i < LEN_1D-1; i++) {
+            b[i] = a[i] * a_save[i+1] * d[i];
+        }
+
         pb_mix(nl);
     }
+
+    free(a_save);
     return (real_t)0;
 }
 
