+     * the modified state left by previous iterations. pb_mix() still modifies
+     * the original a, preserving its side effects. */
+    real_t *a_snapshot = (real_t *)malloc((size_t)LEN_1D * sizeof(real_t));
+    memcpy(a_snapshot, a, (size_t)LEN_1D * sizeof(real_t));
+
     for (int nl = 0; nl < R; nl++) {
         j = -1;
         for (int i = 0; i < LEN_1D; i++) {
-            if (a[i] < (real_t)0.) {
+            if (a_snapshot[i] < (real_t)0.) {
                 j = i;
             }
         }
         chksum = (real_t) j;
         pb_mix(nl);
     }
+
+    free(a_snapshot);
     return j+1;
 }
 