 static real_t kernel_s323(void)
 {
+    real_t* cum_sum = (real_t*)malloc(LEN_1D * sizeof(real_t));
+
     for (int nl = 0; nl < R; nl++) {
+        /* Precompute b values in cum_sum with the same floating-point order as the original.
+         * cum_sum[i] stores b[i] = (b[i-1] + c[i]*d[i]) + c[i]*e[i].
+         * This breaks the loop-carried dependence in the second loop. */
+        cum_sum[0] = b[0];
         for (int i = 1; i < LEN_1D; i++) {
-            a[i] = b[i-1] + c[i] * d[i];
-            b[i] = a[i] + c[i] * e[i];
+            cum_sum[i] = cum_sum[i-1] + c[i] * d[i] + c[i] * e[i];
         }
+
+        /* Compute a and b using precomputed cumulative b values.
+         * a[i] = b[i-1] + c[i]*d[i] = cum_sum[i-1] + c[i]*d[i].
+         * b[i] = cum_sum[i].
+         * Each iteration is now independent; the loop is parallelizable. */
+        for (int i = 1; i < LEN_1D; i++) {
+            a[i] = cum_sum[i-1] + c[i] * d[i];
+            b[i] = cum_sum[i];
+        }
+
         pb_mix(nl);
     }
+
+    free(cum_sum);
     return (real_t)0;
 }
 