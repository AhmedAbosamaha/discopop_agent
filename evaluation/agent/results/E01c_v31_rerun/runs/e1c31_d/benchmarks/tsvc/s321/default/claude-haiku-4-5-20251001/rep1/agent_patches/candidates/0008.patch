+        // Apply recurrence in logarithmic passes: each pass is a Do-All loop
+        // After 'rounds' passes, dependency is fully propagated and result matches serial
+        for (int round = 0; round < rounds; round++) {
+            // Pass 1: odd indices (1, 3, 5, ...) read from even-index predecessors
+            for (int i = 1; i < LEN_1D; i += 2) {
+                a[i] += a[i-1] * b[i];
+            }
+            // Pass 2: even indices (2, 4, 6, ...) read from odd-index predecessors (now updated)
+            for (int i = 2; i < LEN_1D; i += 2) {
+                a[i] += a[i-1] * b[i];
+            }
