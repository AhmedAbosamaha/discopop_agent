 static real_t kernel_s3112(void)
 {
+    /* Pre-compute a values after each pb_mix(0..nl-1) to decouple the main loop
+       from pb_mix side effects, allowing parallelization. */
+    real_t *a_iter = (real_t*)malloc((size_t)R * LEN_1D * sizeof(real_t));
+    real_t *b_local = (real_t*)malloc((size_t)R * LEN_1D * sizeof(real_t));
