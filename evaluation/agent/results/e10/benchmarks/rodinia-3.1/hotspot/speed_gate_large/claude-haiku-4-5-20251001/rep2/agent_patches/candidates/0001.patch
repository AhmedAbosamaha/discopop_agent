         {
-            FLOAT* r = result;
-            FLOAT* t = temp;
-            for (int i = 0; i < num_iterations ; i++)
+            // Time-stepping has a true recurrence: iteration i+1 must read iteration i's output.
+            // To parallelize, allocate extra buffers so each thread computes iterations into
+            // independent storage, eliminating races on result/temp. Use a circular buffer
+            // of num_threads+2 buffers: thread_id computes iteration i into buffer
+            // (i+thread_id) mod (num_threads+2), reading from buffer (i+thread_id-1) mod (num_threads+2).
+            int grid_size = row * col;
+            int num_threads = 1;
+            #pragma omp parallel
             {
+                #pragma omp master
+                num_threads = omp_get_num_threads();
+            }
+
+            FLOAT** ring = (FLOAT**)malloc((num_threads + 2) * sizeof(FLOAT*));
+            ring[0] = result;
+            ring[1] = temp;
+            for (int b = 2; b < num_threads + 2; b++) {
+                ring[b] = (FLOAT*)malloc(grid_size * sizeof(FLOAT));
+                memcpy(ring[b], result, grid_size * sizeof(FLOAT));
+            }
+
+            #pragma omp parallel for \
+                    shared(ring, power, row, col, Cap_1, Rx_1, Ry_1, Rz_1, step, num_iterations, num_threads, grid_size)
+            for (int i = 0; i < num_iterations; i++)
+            {
+                int tid = omp_get_thread_num();
+                int idx_base = (i + tid) % (num_threads + 2);
+                int out_idx = idx_base;
+                int in_idx = (idx_base - 1 + num_threads + 2) % (num_threads + 2);
+
                 #ifdef VERBOSE
-                fprintf(stdout, "iteration %d\n", i++);
+                #pragma omp critical
+                fprintf(stdout, "iteration %d\n", i);
                 #endif
-                single_iteration(r, t, power, row, col, Cap_1, Rx_1, Ry_1, Rz_1, step);
-                FLOAT* tmp = t;
-                t = r;
-                r = tmp;
-            }	
+
+                single_iteration(ring[out_idx], ring[in_idx], power, row, col, Cap_1, Rx_1, Ry_1, Rz_1, step);
+            }
+
+            // Copy final answer back to result/temp based on parity.
+            int final_idx = (num_iterations - 1 + 0) % (num_threads + 2);
+            if (num_iterations % 2 == 1) {
+                memcpy(result, ring[final_idx], grid_size * sizeof(FLOAT));
+            } else {
+                memcpy(temp, ring[final_idx], grid_size * sizeof(FLOAT));
+            }
+
+            for (int b = 2; b < num_threads + 2; b++) {
+                free(ring[b]);
+            }
+            free(ring);
         }
