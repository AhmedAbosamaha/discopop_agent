-            }	
+                single_iteration(result, temp, power, row, col, Cap_1, Rx_1, Ry_1, Rz_1, step);
+            }
+            /* Implicit barrier at end of loop; result now contains state after even iterations */
+
+            /* Phase 2: Odd-indexed iterations (1, 3, 5, ...)
+               All read from result (just updated by phase 1), all write to temp. */
+            #pragma omp parallel for schedule(static)
+            for (int i = 1; i < num_iterations; i += 2)
+            {
+                #ifdef VERBOSE
+                fprintf(stdout, "iteration %d\n", i);
+                #endif
+                single_iteration(temp, result, power, row, col, Cap_1, Rx_1, Ry_1, Rz_1, step);
+            }
