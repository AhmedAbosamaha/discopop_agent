+               Each phase runs its iterations in parallel using distinct buffer assignments
+               derived from iteration parity, with an implicit barrier between phases. */
+
+            /* Phase 1: Even-indexed iterations (0, 2, 4, ...)
+               All read from temp, all write to result. No loop-carried pointer dependence. */
+            #pragma omp parallel for schedule(static)
+            for (int i = 0; i < num_iterations; i += 2)
             {
                 #ifdef VERBOSE
-                fprintf(stdout, "iteration %d\n", i++);
