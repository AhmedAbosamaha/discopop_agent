@@ -15,8 +15,16 @@
 static real_t kernel_k36(void)
 {
     for (int nl = 0; nl < R; nl++) {
+        /* Pass 1: finish every u[i].  Reads v and c only (neither is written
+         * here), so iterations are independent. */
+#pragma omp parallel for schedule(static) shared(u, v, c)
         for (long i = 1; i < LEN_1D; i++) {
             u[i] += AT1(v, i) * c[i];
+        }
+        /* Pass 2: every v[i] from the completed u.  u is only read here,
+         * each v[i] is written by exactly one iteration. */
+#pragma omp parallel for schedule(static) shared(u, v, c, d)
+        for (long i = 1; i < LEN_1D; i++) {
             v[i] = AT2(u, i) * d[i] + c[i];
         }
         pb_mix(nl);
