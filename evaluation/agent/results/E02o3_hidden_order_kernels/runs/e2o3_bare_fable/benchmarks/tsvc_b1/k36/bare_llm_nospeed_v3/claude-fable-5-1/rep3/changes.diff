@@ -15,8 +15,18 @@
 static real_t kernel_k36(void)
 {
     for (int nl = 0; nl < R; nl++) {
+        /* Loop fission: statement 1 only reads v values that statement 2 has
+         * not yet overwritten in the original order, so all of statement 1
+         * can run first (independent iterations, each writes its own u[i]). */
+#pragma omp parallel for shared(u, v, c) schedule(static)
         for (long i = 1; i < LEN_1D; i++) {
             u[i] += AT1(v, i) * c[i];
+        }
+        /* Statement 2 reads the u value produced by the previous iteration
+         * in the original; now every u is final, so iterations are
+         * independent (each writes its own v[i]). */
+#pragma omp parallel for shared(u, v, c, d) schedule(static)
+        for (long i = 1; i < LEN_1D; i++) {
             v[i] = AT2(u, i) * d[i] + c[i];
         }
         pb_mix(nl);
