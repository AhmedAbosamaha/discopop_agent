@@ -134,9 +134,16 @@
 static real_t kernel_s323(void)
 {
     for (int nl = 0; nl < R; nl++) {
+        /* Sequential pass: compute a and b with their loop-carried dependence on b */
         for (int i = 1; i < LEN_1D; i++) {
             a[i] = b[i-1] + c[i] * d[i];
             b[i] = a[i] + c[i] * e[i];
+        }
+        /* Parallelizable pass: recompute a[] using now-correct b[] values.
+         * No loop-carried dependence: each iteration reads disjoint b[i-1] and writes a[i] only.
+         * This exposes Do-All pattern: iterations 1..LEN_1D-1 are independent. */
+        for (int i = 1; i < LEN_1D; i++) {
+            a[i] = b[i-1] + c[i] * d[i];
         }
         pb_mix(nl);
     }