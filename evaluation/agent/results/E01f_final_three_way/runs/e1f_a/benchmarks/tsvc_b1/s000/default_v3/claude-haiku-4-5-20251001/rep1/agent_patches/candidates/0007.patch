--- s000.c
+++ s000.c
@@ -20,11 +20,13 @@
         real_t *b_snapshot = (real_t *)malloc(LEN_1D * sizeof(real_t));
 
         /* Capture b's state before pb_mix modifies it for the next iteration */
+        #pragma omp parallel for 
         for (int i = 0; i < LEN_1D; i++) {
             b_snapshot[i] = b[i];
         }
 
         /* Compute a using the captured b values */
+        #pragma omp parallel for shared(b_snapshot) 
         for (int i = 0; i < LEN_1D; i++) {
             a[i] = b_snapshot[i] + 1;
         }
