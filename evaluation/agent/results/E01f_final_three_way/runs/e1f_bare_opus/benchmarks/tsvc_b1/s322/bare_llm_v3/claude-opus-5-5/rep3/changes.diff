+#define S322_BS 1024L
+#define S322_G 64
+
+static long s322_owner(long idx)
+{
+    return idx < 2 ? 0L : (idx - 2L) / S322_BS;
+}
+
+/* apply the recorded effect of pb_mix(p) restricted to elements owned by block j
+ * (in pb_mix's own order) */
+static void s322_apply_mix(long j, long kk, real_t nbk, real_t nck, real_t nbl)
+{
+    long ok = s322_owner(kk);
+    if (ok == j) a[kk] += (real_t)0.25;
+    if (j == 0) a[0] += (real_t)0.125;
+    if (ok == j) { b[kk] = nbk; c[kk] = nck; }
+    if (s322_owner((long)LEN_1D - 1L) == j) b[LEN_1D - 1] = nbl;
+}
