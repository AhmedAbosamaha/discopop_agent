--- original.c
+++ final.c
@@ -16,9 +16,18 @@
 static real_t kernel_s323(void)
 {
     for (int nl = 0; nl < R; nl++) {
+        /* Independent part: the products. a[i], b[i] (i>=1) are fully
+         * overwritten by the recurrence and their old values never read,
+         * so they hold the products temporarily. b[0] is untouched. */
+        #pragma omp parallel for schedule(static) shared(a, b, c, d, e)
         for (int i = 1; i < LEN_1D; i++) {
-            a[i] = b[i-1] + c[i] * d[i];
-            b[i] = a[i] + c[i] * e[i];
+            a[i] = c[i] * d[i];
+            b[i] = c[i] * e[i];
+        }
+        /* True recurrence through b[i-1]: kept in order, same FP ops. */
+        for (int i = 1; i < LEN_1D; i++) {
+            a[i] = b[i-1] + a[i];
+            b[i] = a[i] + b[i];
         }
         pb_mix(nl);
     }
