 static real_t kernel_s241(void)
 {
+    real_t *ta = (real_t *)malloc(sizeof(real_t) * (size_t)LEN_1D);
     for (int nl = 0; nl < R; nl++) {
+        /* reads only OLD a (a[i+1]); writes ta[i], b[i] of its own index */
+        #pragma omp parallel for schedule(static) shared(ta)
