 /* TSVC-2 loop s322, from TSVC-2 src/tsvc.c (sha256 456dd573b84b; University of Illinois licence,
  * see benchmarks/TSVC_2/license.txt). */
 #include "tsvc_b1/s322.h"
+#include <stdlib.h>
+#include <string.h>
 
 /* Between two repetitions a few INPUT elements change, so no repetition can be skipped,
  * merged with another or run out of order: the repetition loop is sequential by a true
@@ -13,11 +15,84 @@
   a[0] += (real_t)0.125; b[LEN_1D-1] += (real_t)0.125;
 }
 
+#define S322_NB 256L
+#define S322_WARM 128L
+
+static real_t *s322_tmp = NULL;
+
+static inline real_t s322_step(real_t ai, real_t am1, real_t am2, real_t bi, real_t ci)
+{
+    return ai + am1 * bi + am2 * ci;
+}
+
 static real_t kernel_s322(void)
 {
+    if (s322_tmp == NULL) {
+        s322_tmp = (real_t *)malloc(sizeof(real_t) * (size_t)LEN_1D);
+    }
+    real_t *tmp = s322_tmp;
+    const long n = (long)LEN_1D;
+    const long len = n - 2;
+    const long bs = (len + S322_NB - 1) / S322_NB;
+    long t, i;
+
     for (int nl = 0; nl < R; nl++) {
-        for (int i = 2; i < LEN_1D; i++) {
-            a[i] = a[i] + a[i - 1] * b[i] + a[i - 2] * c[i];
+        if (len > 0) {
+            tmp[0] = a[0];
+            tmp[1] = a[1];
+
+            /* phase 1: speculative per-block evaluation (reads a, writes tmp) */
+            #pragma omp parallel for schedule(static) shared(tmp) firstprivate(n, bs)
+            for (t = 0; t < S322_NB; t++) {
+                long s = 2 + t * bs;
+                long e = s + bs;
+                if (e > n) e = n;
+                if (s < e) {
+                    long ws = s - S322_WARM;
+                    if (ws < 2) ws = 2;
+                    real_t x = a[ws - 2];
+                    real_t y = a[ws - 1];
+                    for (long j = ws; j < s; j++) {
+                        real_t v = s322_step(a[j], y, x, b[j], c[j]);
+                        x = y;
+                        y = v;
+                    }
+                    for (long j = s; j < e; j++) {
+                        real_t v = s322_step(a[j], y, x, b[j], c[j]);
+                        tmp[j] = v;
+                        x = y;
+                        y = v;
+                    }
+                }
+            }
+
+            /* phase 2: sequential repair from the true state, until convergence */
+            for (long tb = 1; tb < S322_NB; tb++) {
+                long s = 2 + tb * bs;
+                long e = s + bs;
+                if (e > n) e = n;
+                if (s >= e) continue;
+                real_t x = tmp[s - 2];
+                real_t y = tmp[s - 1];
+                int matched = 0;
+                for (long j = s; j < e && matched < 2; j++) {
+                    real_t v = s322_step(a[j], y, x, b[j], c[j]);
+                    if (memcmp(&v, &tmp[j], sizeof(real_t)) == 0) {
+                        matched++;
+                    } else {
+                        matched = 0;
+                        tmp[j] = v;
+                    }
+                    x = y;
+                    y = v;
+                }
+            }
+
+            /* phase 3: publish */
+            #pragma omp parallel for schedule(static) shared(tmp) firstprivate(n)
+            for (i = 2; i < n; i++) {
+                a[i] = tmp[i];
+            }
         }
         pb_mix(nl);
     }
