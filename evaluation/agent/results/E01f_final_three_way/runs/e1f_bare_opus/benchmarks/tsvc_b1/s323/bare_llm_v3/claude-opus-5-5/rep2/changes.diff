--- original.c
+++ final.c
@@ -16,9 +16,19 @@
 static real_t kernel_s323(void)
 {
     for (int nl = 0; nl < R; nl++) {
+        /* independent part: the products, stored in the slots about to be overwritten */
+#pragma omp parallel for schedule(static) shared(a, b, c, d, e)
         for (int i = 1; i < LEN_1D; i++) {
-            a[i] = b[i-1] + c[i] * d[i];
-            b[i] = a[i] + c[i] * e[i];
+            a[i] = c[i] * d[i];
+            b[i] = c[i] * e[i];
+        }
+        /* true recurrence on b, same operands and rounding order as the original */
+        real_t carry = b[0];
+        for (int i = 1; i < LEN_1D; i++) {
+            real_t t = carry + a[i];
+            a[i] = t;
+            carry = t + b[i];
+            b[i] = carry;
         }
         pb_mix(nl);
     }
