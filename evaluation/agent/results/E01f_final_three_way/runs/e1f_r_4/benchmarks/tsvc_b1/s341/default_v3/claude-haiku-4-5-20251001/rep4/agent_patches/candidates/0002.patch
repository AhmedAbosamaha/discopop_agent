@@ -16,16 +16,33 @@
 static real_t kernel_s341(void)
 {
     int j;
+
+    /* Allocate marking array once—only stores 0/1, not values.
+       Phase 1 marks which indices pass the filter (parallelizable Do-All).
+       Phase 2 reads original b[i] and writes to a, needing no copy. */
+    int *mark = malloc(LEN_1D * sizeof(int));
+
     for (int nl = 0; nl < R; nl++) {
+        /* Phase 1: Parallel marking—each i writes to independent mark[i].
+           No loop-carried dependence through mark, b, or a. */
+        for (int i = 0; i < LEN_1D; i++) {
+            mark[i] = (b[i] > (real_t)0.) ? 1 : 0;
+        }
+
+        /* Phase 2: Sequential compaction—read mark[i] and original b[i],
+           write to a[j]. Dependence on mark is satisfied by phase 1's completion. */
         j = -1;
         for (int i = 0; i < LEN_1D; i++) {
-            if (b[i] > (real_t)0.) {
+            if (mark[i]) {
                 j++;
                 a[j] = b[i];
             }
         }
+
         pb_mix(nl);
     }
+
+    free(mark);
     return (real_t)0;
 }
 