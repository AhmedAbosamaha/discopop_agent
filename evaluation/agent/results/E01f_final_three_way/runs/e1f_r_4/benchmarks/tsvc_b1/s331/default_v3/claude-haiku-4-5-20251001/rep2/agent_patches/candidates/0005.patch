+static int find_last_negative_index(void)
+{
+    int num_threads = omp_get_max_threads();
+    int *thread_buffer = (int *)malloc(num_threads * sizeof(int));
+
+    for (int t = 0; t < num_threads; t++) {
+        thread_buffer[t] = -1;
+    }
+
+    /* Each thread writes to its own buffer slot, eliminating races */
+    for (int i = 0; i < LEN_1D; i++) {
+        if (a[i] < (real_t)0.) {
+            int tid = omp_get_thread_num();
+            thread_buffer[tid] = i;
+        }
+    }
+
+    /* Combine thread-local results sequentially */
+    int j = -1;
+    for (int t = 0; t < num_threads; t++) {
+        if (thread_buffer[t] > j) {
+            j = thread_buffer[t];
+        }
+    }
+
+    free(thread_buffer);
+    return j;
+}
