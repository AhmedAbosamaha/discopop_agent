 static real_t kernel_s341(void)
 {
     int j;
+
+    /* Allocate temporary array for filter-then-compact strategy */
+    real_t *temp = malloc(LEN_1D * sizeof(real_t));
+
     for (int nl = 0; nl < R; nl++) {
+        /* Phase 1: Parallel filtering - mark elements that pass the filter.
+           Each iteration writes to independent temp[i]; no loop-carried dependence. */
+        for (int i = 0; i < LEN_1D; i++) {
+            if (b[i] > (real_t)0.) {
+                temp[i] = b[i];
+            } else {
+                temp[i] = -(real_t)1;  /* sentinel: excluded from output */
+            }
+        }
+
+        /* Phase 2: Sequential compaction - copy selected elements to output array.
+           Dependence on temp is now outside this loop; j is local to this phase. */
         j = -1;
         for (int i = 0; i < LEN_1D; i++) {
-            if (b[i] > (real_t)0.) {
+            if (temp[i] > (real_t)0.) {
                 j++;
-                a[j] = b[i];
+                a[j] = temp[i];
             }
         }
+
         pb_mix(nl);
     }
+
+    free(temp);
     return (real_t)0;
 }
 