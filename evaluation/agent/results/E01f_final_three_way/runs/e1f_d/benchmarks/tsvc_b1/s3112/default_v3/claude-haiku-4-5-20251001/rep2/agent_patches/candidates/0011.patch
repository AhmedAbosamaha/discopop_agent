+        /* Pass 1: Compute segment sums in parallel. */
+        for (int seg = 0; seg < NUM_SEGS; seg++) {
+            real_t seg_sum = (real_t)0.0;
+            for (int i = seg * SEG_SIZE; i < seg * SEG_SIZE + SEG_SIZE && i < LEN_1D; i++) {
+                seg_sum += a[i];
+            }
+            seg_sums[seg] = seg_sum;
         }
+
