@@ -16,9 +16,20 @@
 static real_t kernel_s321(void)
 {
     for (int nl = 0; nl < R; nl++) {
+        // Snapshot of 'a' at the start of this outer loop iteration.
+        // Reading from this snapshot instead of from 'a' itself breaks the
+        // loop-carried dependence: each iteration i reads a_snap[i-1] (fixed)
+        // and writes to a[i] (distinct element), making the loop a Do-All.
+        real_t *a_snap = (real_t *)malloc(LEN_1D * sizeof(real_t));
+        for (int j = 0; j < LEN_1D; j++) {
+            a_snap[j] = a[j];
+        }
+
         for (int i = 1; i < LEN_1D; i++) {
-            a[i] += a[i-1] * b[i];
+            a[i] += a_snap[i-1] * b[i];
         }
+
+        free(a_snap);
         pb_mix(nl);
     }
     return (real_t)0;