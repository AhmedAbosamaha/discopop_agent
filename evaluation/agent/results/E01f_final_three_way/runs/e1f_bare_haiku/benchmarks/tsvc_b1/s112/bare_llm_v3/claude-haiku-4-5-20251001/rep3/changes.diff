 static real_t kernel_s112(void)
 {
+    real_t *new_a = malloc(LEN_1D * sizeof(real_t));
+    if (new_a == NULL) {
+        return (real_t)0;
+    }
+
     for (int nl = 0; nl < R; nl++) {
+        /* Parallel loop: compute results into temporary buffer.
+         * All iterations are independent (no backward dependence).
+         * Each iteration i reads a[i], b[i] (unchanged by other iterations)
+         * and writes to new_a[i+1] (different index per iteration).
+         */
+        #pragma omp parallel for shared(a, b, new_a)
         for (int i = LEN_1D - 2; i >= 0; i--) {
-            a[i+1] = a[i] + b[i];
+            new_a[i+1] = a[i] + b[i];
         }
+
+        /* Copy results back to a[] sequentially.
+         * This is a separate phase, after all parallel work completes.
+         */
+        for (int i = 1; i < LEN_1D; i++) {
+            a[i] = new_a[i];
+        }
+
         pb_mix(nl);
     }
+
+    free(new_a);
     return (real_t)0;
 }
 
