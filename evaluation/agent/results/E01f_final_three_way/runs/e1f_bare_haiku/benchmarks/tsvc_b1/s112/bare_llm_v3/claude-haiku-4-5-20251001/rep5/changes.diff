--- original.c
+++ final.c
@@ -16,9 +16,20 @@
 static real_t kernel_s112(void)
 {
     for (int nl = 0; nl < R; nl++) {
+        // Create snapshot of a to make loop iterations independent
+        real_t *a_copy = (real_t *)malloc(LEN_1D * sizeof(real_t));
+        for (int j = 0; j < LEN_1D; j++) {
+            a_copy[j] = a[j];
+        }
+
+        // Loop is now parallel: each iteration i reads a_copy[i] (snapshot)
+        // and writes a[i+1]. No iteration reads what another writes.
+        #pragma omp parallel for shared(a, b, a_copy)
         for (int i = LEN_1D - 2; i >= 0; i--) {
-            a[i+1] = a[i] + b[i];
+            a[i+1] = a_copy[i] + b[i];
         }
+
+        free(a_copy);
         pb_mix(nl);
     }
     return (real_t)0;
