 static real_t kernel_s241(void)
 {
+    // Allocate buffer to save 'a' values: breaks write-after-read dependence
+    // where iteration i reads a[i+1] before iteration i+1 writes it
+    real_t *a_old = malloc(LEN_1D * sizeof(real_t));
+
     for (int nl = 0; nl < R; nl++) {
+        // Save current 'a' array before modifying
+        #pragma omp parallel for shared(a, a_old)
+        for (int i = 0; i < LEN_1D; i++) {
+            a_old[i] = a[i];
+        }
+
+        // Phase 1: Compute all new 'a' values in parallel
+        // Each iteration independently computes a[i] = b[i] * c[i] * d[i]
+        #pragma omp parallel for shared(a, b, c, d)
         for (int i = 0; i < LEN_1D-1; i++) {
-            a[i] = b[i] * c[i  ] * d[i];
-            b[i] = a[i] * a[i+1] * d[i];
+            a[i] = b[i] * c[i] * d[i];
         }
+
+        // Phase 2: Compute all new 'b' values in parallel
+        // Each iteration independently computes b[i] = a[i] * a_old[i+1] * d[i]
+        // Using a_old[i+1] ensures we read pre-loop values of a[i+1]
+        #pragma omp parallel for shared(a, a_old, b, d)
+        for (int i = 0; i < LEN_1D-1; i++) {
+            b[i] = a[i] * a_old[i+1] * d[i];
+        }
+
         pb_mix(nl);
     }
+
+    free(a_old);
     return (real_t)0;
 }
 
