@@ -16,11 +16,20 @@
 static real_t kernel_s243(void)
 {
     for (int nl = 0; nl < R; nl++) {
+        // Save old values of a[] to break the inter-iteration dependence on a[i+1].
+        // Each iteration reads a_old[i+1], the pre-loop value, ensuring the same
+        // semantics as sequential execution while removing the loop-carried dependence.
+        real_t *a_old = malloc(LEN_1D * sizeof(real_t));
+        memcpy(a_old, a, LEN_1D * sizeof(real_t));
+
+        #pragma omp parallel for shared(a, b, c, d, e, a_old)
         for (int i = 0; i < LEN_1D-1; i++) {
             a[i] = b[i] + c[i  ] * d[i];
             b[i] = a[i] + d[i  ] * e[i];
-            a[i] = b[i] + a[i+1] * d[i];
+            a[i] = b[i] + a_old[i+1] * d[i];
         }
+
+        free(a_old);
         pb_mix(nl);
     }
     return (real_t)0;
