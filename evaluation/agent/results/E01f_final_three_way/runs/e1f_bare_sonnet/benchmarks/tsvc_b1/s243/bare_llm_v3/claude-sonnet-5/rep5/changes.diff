 /* Between two repetitions a few INPUT elements change, so no repetition can be skipped,
  * merged with another or run out of order: the repetition loop is sequential by a true
@@ -15,14 +16,33 @@
 
 static real_t kernel_s243(void)
 {
+    /* Heap-allocated snapshot of a[] as it stood before the current activation of the
+     * i-loop. In the original sequential order, iteration i reads a[i+1] before
+     * iteration i+1 has had a chance to write it, so it always sees the pre-activation
+     * value. a_old freezes that value so the i-loop can run its iterations in any order
+     * (or in parallel) while still reading exactly what the sequential version read. */
+    real_t *a_old = (real_t *)malloc((size_t)LEN_1D * sizeof(real_t));
+
     for (int nl = 0; nl < R; nl++) {
+        /* a_old: written here (shared, disjoint indices), read as a_old[i+1] below.
+         * a: read here (shared, disjoint indices). */
+        #pragma omp parallel for default(none) shared(a, a_old)
+        for (int i = 0; i < LEN_1D; i++) {
+            a_old[i] = a[i];
+        }
+        /* a, b: each iteration writes only index i and reads b[i] (its own, written
+         * earlier in the same iteration) plus a_old[i+1] (frozen snapshot) -- no
+         * cross-iteration dependence remains.
+         * c, d, e: read-only, disjoint-index reads. */
+        #pragma omp parallel for default(none) shared(a, b, c, d, e, a_old)
         for (int i = 0; i < LEN_1D-1; i++) {
             a[i] = b[i] + c[i  ] * d[i];
             b[i] = a[i] + d[i  ] * e[i];
-            a[i] = b[i] + a[i+1] * d[i];
+            a[i] = b[i] + a_old[i+1] * d[i];
         }
         pb_mix(nl);
     }
+    free(a_old);
     return (real_t)0;
 }
 
