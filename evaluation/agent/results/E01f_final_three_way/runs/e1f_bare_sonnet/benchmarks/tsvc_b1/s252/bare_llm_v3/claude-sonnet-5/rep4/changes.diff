-            a[i] = s + t;
-            t = s;
+            real_t s = b[i] * c[i];
+            real_t prev = (i > 0) ? (b[i - 1] * c[i - 1]) : (real_t) 0.;
+            a[i] = s + prev;
         }
         pb_mix(nl);
     }
