 static real_t kernel_s243(void)
 {
+    /* a[i+1] read by the third statement is, under the original sequential order,
+     * always the value a[i+1] held before this sweep started (iteration i+1 has not
+     * run yet when iteration i reads it). We snapshot a[] into a_old at the start of
+     * every repetition so each iteration can read that pre-sweep neighbor value
+     * directly, independent of execution order, while writes to the live a[i]/b[i]
+     * stay one-per-iteration and race-free. a_old scales with LEN_1D, so it is
+     * heap-allocated once and reused across the R repetitions. */
+    real_t *a_old = (real_t *)malloc((size_t)LEN_1D * sizeof(real_t));
+
     for (int nl = 0; nl < R; nl++) {
-        for (int i = 0; i < LEN_1D-1; i++) {
-            a[i] = b[i] + c[i  ] * d[i];
-            b[i] = a[i] + d[i  ] * e[i];
-            a[i] = b[i] + a[i+1] * d[i];
+        #pragma omp parallel default(none) shared(a, b, c, d, e, a_old)
+        {
+            /* Snapshot: each i writes a_old[i] once from the live a[i]; no overlap. */
+            #pragma omp for
+            for (int i = 0; i < LEN_1D; i++) {
+                a_old[i] = a[i];
+            }
+
+            /* Implicit barrier above guarantees a_old is fully populated before any
+             * thread reads a_old[i+1] below. Each i writes only a[i] and b[i], and
+             * reads c[i], d[i], e[i] (untouched by this loop) plus a_old[i+1]
+             * (read-only snapshot): no cross-iteration dependence remains. */
+            #pragma omp for
+            for (int i = 0; i < LEN_1D-1; i++) {
+                a[i] = b[i] + c[i  ] * d[i];
+                b[i] = a[i] + d[i  ] * e[i];
+                a[i] = b[i] + a_old[i+1] * d[i];
+            }
         }
