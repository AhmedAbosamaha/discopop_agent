--- original.c
+++ final.c
@@ -15,12 +15,17 @@
 
 static real_t kernel_s254(void)
 {
-    real_t x;
     for (int nl = 0; nl < R; nl++) {
-        x = b[LEN_1D-1];
+        /* Original recurrence: x starts at b[LEN_1D-1], a[i] = (b[i]+x)*0.5, x = b[i].
+         * That makes x at iteration i equal to b[i-1] (or b[LEN_1D-1] when i==0), and
