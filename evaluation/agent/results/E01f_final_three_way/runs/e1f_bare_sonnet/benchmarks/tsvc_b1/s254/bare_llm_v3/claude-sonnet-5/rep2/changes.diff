+         * each i now only reads b[i] and b[i-1 or LEN_1D-1] and writes its own a[i]. */
+        #pragma omp parallel for schedule(static) default(none) shared(a, b)
         for (int i = 0; i < LEN_1D; i++) {
-            a[i] = (b[i] + x) * (real_t).5;
-            x = b[i];
+            real_t xprev = (i == 0) ? b[LEN_1D-1] : b[i-1];
+            a[i] = (b[i] + xprev) * (real_t).5;
         }
         pb_mix(nl);
     }
