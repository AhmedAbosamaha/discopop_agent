+    const int nblk = (LEN_1D + S313_BS - 1) / S313_BS;
+    real_t *part = (real_t *)malloc((size_t)nblk * sizeof(real_t));
     for (int nl = 0; nl < R; nl++) {
+        #pragma omp parallel for shared(a, b, part) firstprivate(nblk)
+        for (int blk = 0; blk < nblk; blk++) {
+            int lo = blk * S313_BS;
+            int hi = lo + S313_BS;
+            if (hi > LEN_1D) hi = LEN_1D;
+            real_t s = (real_t)0.;
+            for (int i = lo; i < hi; i++) {
+                s += a[i] * b[i];
+            }
+            part[blk] = s;
+        }
         dot = (real_t)0.;
-        for (int i = 0; i < LEN_1D; i++) {
-            dot += a[i] * b[i];
+        for (int blk = 0; blk < nblk; blk++) {
+            dot += part[blk];
         }
         pb_mix(nl);
     }
+    free(part);
     return dot;
 }
 
