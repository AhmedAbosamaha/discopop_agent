 /* Between two repetitions a few INPUT elements change, so no repetition can be skipped,
  * merged with another or run out of order: the repetition loop is sequential by a true
@@ -15,14 +16,25 @@
 
 static real_t kernel_s243(void)
 {
+    /* Snapshot of a[] taken before each repetition: iteration i reads the
+     * ORIGINAL a[i+1] (before iteration i+1 overwrites it), so the loop-carried
+     * anti-dependence is broken by reading the copy instead. Heap-allocated
+     * because its size grows with LEN_1D. */
+    real_t *aold = (real_t *)malloc(sizeof(real_t) * (size_t)LEN_1D);
     for (int nl = 0; nl < R; nl++) {
+        #pragma omp parallel for shared(a, aold)
+        for (int i = 0; i < LEN_1D; i++) {
+            aold[i] = a[i];
+        }
+        #pragma omp parallel for shared(a, b, c, d, e, aold)
         for (int i = 0; i < LEN_1D-1; i++) {
             a[i] = b[i] + c[i  ] * d[i];
             b[i] = a[i] + d[i  ] * e[i];
-            a[i] = b[i] + a[i+1] * d[i];
+            a[i] = b[i] + aold[i+1] * d[i];
         }
         pb_mix(nl);
     }
+    free(aold);
     return (real_t)0;
 }
 
