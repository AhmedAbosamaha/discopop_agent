@@ -16,8 +16,12 @@
 static real_t kernel_s293(void)
 {
     for (int nl = 0; nl < R; nl++) {
+        /* a[0] is read by every iteration and (harmlessly) rewritten with its own
+         * value by iteration 0; hoist it so no iteration touches another's data. */
+        real_t a0 = a[0];
+#pragma omp parallel for shared(a) firstprivate(a0) schedule(static)
         for (int i = 0; i < LEN_1D; i++) {
-            a[i] = a[0];
+            a[i] = a0;
         }
         pb_mix(nl);
     }
