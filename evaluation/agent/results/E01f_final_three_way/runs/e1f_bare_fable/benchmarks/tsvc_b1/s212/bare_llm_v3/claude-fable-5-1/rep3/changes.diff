--- original.c
+++ final.c
@@ -16,9 +16,17 @@
 static real_t kernel_s212(void)
 {
     for (int nl = 0; nl < R; nl++) {
+        /* Original body: a[i] *= c[i]; b[i] += a[i+1]*d[i];  -- b[i] reads the OLD a[i+1]
+         * (anti-dependence on a).  Do all the b updates first, using the unmodified a,
+         * then scale a.  Each pass is independent across i; the a-pass starts only after
+         * the b-pass has completed, so every b[i] sees the original a[i+1]. */
+#pragma omp parallel for shared(a, b, d)
+        for (int i = 0; i < LEN_1D-1; i++) {
+            b[i] += a[i + 1] * d[i];
+        }
+#pragma omp parallel for shared(a, c)
         for (int i = 0; i < LEN_1D-1; i++) {
             a[i] *= c[i];
-            b[i] += a[i + 1] * d[i];
         }
         pb_mix(nl);
     }
