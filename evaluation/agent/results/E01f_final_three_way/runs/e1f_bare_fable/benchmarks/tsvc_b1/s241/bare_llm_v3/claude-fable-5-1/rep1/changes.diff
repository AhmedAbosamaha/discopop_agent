 #include "tsvc_b1/s241.h"
+#include <stdlib.h>
 
 /* Between two repetitions a few INPUT elements change, so no repetition can be skipped,
  * merged with another or run out of order: the repetition loop is sequential by a true
@@ -15,13 +16,25 @@
 
 static real_t kernel_s241(void)
 {
+    /* Scratch holding the new a[] values so that every read of the OLD a[i+1]
+     * completes before any element of a[] is overwritten. */
+    real_t *tmp = (real_t *)malloc(sizeof(real_t) * (size_t)LEN_1D);
     for (int nl = 0; nl < R; nl++) {
+        /* Reads b, c, d, old a; writes tmp[i] and b[i] only -- iterations independent. */
+#pragma omp parallel for shared(a, b, c, d, tmp) schedule(static)
         for (int i = 0; i < LEN_1D-1; i++) {
-            a[i] = b[i] * c[i  ] * d[i];
-            b[i] = a[i] * a[i+1] * d[i];
+            real_t an = b[i] * c[i  ] * d[i];
+            tmp[i] = an;
+            b[i] = an * a[i+1] * d[i];
+        }
+        /* Commit the new a[] values; a[LEN_1D-1] is untouched, as in the original. */
+#pragma omp parallel for shared(a, tmp) schedule(static)
+        for (int i = 0; i < LEN_1D-1; i++) {
+            a[i] = tmp[i];
         }
         pb_mix(nl);
     }
+    free(tmp);
     return (real_t)0;
 }
 
