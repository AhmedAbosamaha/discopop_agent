@@ -16,9 +16,20 @@
 static real_t kernel_s323(void)
 {
     for (int nl = 0; nl < R; nl++) {
+        /* True recurrence on b: b[i] = (b[i-1] + c[i]*d[i]) + c[i]*e[i].
+         * Kept serial and in the original evaluation order (exact rounding),
+         * with the carried value held in a scalar. */
+        real_t bp = b[0];
+        for (int i = 1; i < LEN_1D; i++) {
+            real_t t = bp + c[i] * d[i];
+            bp = t + c[i] * e[i];
+            b[i] = bp;
+        }
+        /* a[i] is never read by the recurrence; it depends only on the now
+         * final b[i-1], so every iteration is independent. */
+#pragma omp parallel for shared(a, b, c, d)
         for (int i = 1; i < LEN_1D; i++) {
             a[i] = b[i-1] + c[i] * d[i];
-            b[i] = a[i] + c[i] * e[i];
         }
         pb_mix(nl);
     }
