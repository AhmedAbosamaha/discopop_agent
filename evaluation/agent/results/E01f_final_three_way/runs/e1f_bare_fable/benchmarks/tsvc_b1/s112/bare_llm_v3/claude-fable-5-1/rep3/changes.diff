 /* Between two repetitions a few INPUT elements change, so no repetition can be skipped,
  * merged with another or run out of order: the repetition loop is sequential by a true
@@ -15,12 +16,30 @@
 
 static real_t kernel_s112(void)
 {
+    /* Snapshot of the original a[] values: the backward loop only reads a[i]
+     * before it is overwritten (anti-dependence), so every new a[i+1] equals
+     * old a[i] + b[i].  With the snapshot the iterations are independent. */
+    real_t *tmp = (real_t *)malloc((size_t)LEN_1D * sizeof(real_t));
+    const int n = LEN_1D - 1;
+
     for (int nl = 0; nl < R; nl++) {
-        for (int i = LEN_1D - 2; i >= 0; i--) {
-            a[i+1] = a[i] + b[i];
+        if (tmp != NULL) {
+#pragma omp parallel for default(none) shared(a, tmp) firstprivate(n) schedule(static)
+            for (int i = 0; i < n; i++) {
+                tmp[i] = a[i];
+            }
+#pragma omp parallel for default(none) shared(a, b, tmp) firstprivate(n) schedule(static)
+            for (int i = 0; i < n; i++) {
+                a[i+1] = tmp[i] + b[i];
+            }
+        } else {
+            for (int i = LEN_1D - 2; i >= 0; i--) {
+                a[i+1] = a[i] + b[i];
+            }
         }
         pb_mix(nl);
     }
+    free(tmp);
     return (real_t)0;
 }
 
