 /* TSVC-2 loop s121, from TSVC-2 src/tsvc.c (sha256 456dd573b84b; University of Illinois licence,
  * see benchmarks/TSVC_2/license.txt). */
 #include "tsvc_b1/s121.h"
+#include <stdlib.h>
 
 /* Between two repetitions a few INPUT elements change, so no repetition can be skipped,
  * merged with another or run out of order: the repetition loop is sequential by a true
@@ -16,13 +17,25 @@
 static real_t kernel_s121(void)
 {
     int j;
+    /* Snapshot of a[] taken before each sweep: iteration i reads a[i+1], which
+     * iteration i+1 overwrites.  Reading from the snapshot removes that
+     * anti-dependence so the iterations can run in any order. */
+    real_t *ta = (real_t *)malloc((size_t)LEN_1D * sizeof(real_t));
     for (int nl = 0; nl < R; nl++) {
+        /* Copy the elements the sweep reads: a[1 .. LEN_1D-1]. */
+#pragma omp parallel for shared(a, ta)
+        for (int i = 1; i < LEN_1D; i++) {
+            ta[i] = a[i];
+        }
+        /* Each iteration writes only a[i] and reads only ta[i+1], b[i]. */
+#pragma omp parallel for shared(a, b, ta) private(j)
         for (int i = 0; i < LEN_1D-1; i++) {
             j = i + 1;
-            a[i] = a[j] + b[i];
+            a[i] = ta[j] + b[i];
         }
         pb_mix(nl);
     }
+    free(ta);
     return (real_t)0;
 }
 
