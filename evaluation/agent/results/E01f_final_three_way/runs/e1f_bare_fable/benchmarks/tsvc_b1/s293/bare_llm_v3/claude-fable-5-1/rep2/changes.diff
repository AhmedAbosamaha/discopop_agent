 static real_t kernel_s293(void)
 {
     for (int nl = 0; nl < R; nl++) {
+        /* a[0] is read by every iteration and written (to its own value) by
+         * iteration 0; hoist it into a scalar so no iteration touches a[0]
+         * except through its own a[i] write. */
+        real_t a0 = a[0];
+#pragma omp parallel for shared(a) firstprivate(a0) schedule(static)
         for (int i = 0; i < LEN_1D; i++) {
-            a[i] = a[0];
+            a[i] = a0;
         }
         pb_mix(nl);
     }
