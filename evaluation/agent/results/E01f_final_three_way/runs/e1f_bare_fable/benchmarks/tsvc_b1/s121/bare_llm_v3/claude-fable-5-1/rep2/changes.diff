 /* Between two repetitions a few INPUT elements change, so no repetition can be skipped,
  * merged with another or run out of order: the repetition loop is sequential by a true
@@ -16,13 +17,23 @@
 static real_t kernel_s121(void)
 {
     int j;
+    /* Snapshot of a[] taken before each sweep: iteration i must read the
+     * ORIGINAL a[i+1], which iteration i+1 overwrites.  Heap-allocated since
+     * its size grows with LEN_1D. */
+    real_t *tmp = (real_t *)malloc((size_t)LEN_1D * sizeof(real_t));
     for (int nl = 0; nl < R; nl++) {
+#pragma omp parallel for default(none) shared(a, tmp)
+        for (int i = 0; i < LEN_1D; i++) {
+            tmp[i] = a[i];
+        }
+#pragma omp parallel for default(none) shared(a, b, tmp) private(j)
         for (int i = 0; i < LEN_1D-1; i++) {
             j = i + 1;
-            a[i] = a[j] + b[i];
+            a[i] = tmp[j] + b[i];
         }
         pb_mix(nl);
     }
+    free(tmp);
     return (real_t)0;
 }
 
