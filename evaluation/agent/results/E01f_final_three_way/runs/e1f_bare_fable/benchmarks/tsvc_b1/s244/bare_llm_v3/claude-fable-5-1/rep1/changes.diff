@@ -16,10 +16,16 @@
 static real_t kernel_s244(void)
 {
     for (int nl = 0; nl < R; nl++) {
+        /* The original's write to a[i+1] is overwritten by the next iteration's
+         * a[i] assignment without being read, so it is dead for all i except the
+         * last; only a[LEN_1D-1] survives and is computed once after the loop. */
+#pragma omp parallel for shared(a, b, c, d)
         for (int i = 0; i < LEN_1D-1; ++i) {
             a[i] = b[i] + c[i] * d[i];
             b[i] = c[i] + b[i];
-            a[i+1] = b[i] + a[i+1] * d[i];
+        }
+        if (LEN_1D > 1) {
+            a[LEN_1D-1] = b[LEN_1D-2] + a[LEN_1D-1] * d[LEN_1D-2];
         }
         pb_mix(nl);
     }
