 static real_t kernel_s211(void)
 {
+    real_t *b_temp = malloc((LEN_1D) * sizeof(real_t));
+
     for (int nl = 0; nl < R; nl++) {
+        /* Parallelize the inner loop using a temporary buffer to break the
+         * flow dependence on b[i]. Iteration i writes b_temp[i] (computed from
+         * b[i+1], which is never modified in this loop), so all iterations are
+         * independent. After the loop, b_temp is copied back to b to update the
+         * real array. This preserves semantics: the loop completes before any
+         * subsequent read of b.
+         */
+        #pragma omp parallel for \
+            shared(a, b, c, d, e, b_temp) \
+            private(i)
         for (int i = 1; i < LEN_1D-1; i++) {
             a[i] = b[i - 1] + c[i] * d[i];
-            b[i] = b[i + 1] - e[i] * d[i];
+            b_temp[i] = b[i + 1] - e[i] * d[i];
         }
+
+        /* Copy temporary buffer back to b, updating the array in place.
+         * This must complete before the next nl iteration (sequential).
+         */
+        for (int i = 1; i < LEN_1D-1; i++) {
+            b[i] = b_temp[i];
+        }
+
         pb_mix(nl);
     }
+
+    free(b_temp);
     return (real_t)0;
 }
 
