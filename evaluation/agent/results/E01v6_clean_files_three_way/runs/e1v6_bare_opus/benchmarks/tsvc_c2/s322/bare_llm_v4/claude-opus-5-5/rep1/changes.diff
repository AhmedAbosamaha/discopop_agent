+    int nb = nr > 0 ? (nr + B - 1) / B : 0;
+
+    long kk[iterations];
+    int kb[iterations];
+    for (int s = 0; s < iterations; s++) {
+        kk[s] = ((ncalls + s) * 7919L + 13L) % LEN_1D;
+        kb[s] = kk[s] < 2 ? 0 : (int)((kk[s] - 2) / B);
+    }
