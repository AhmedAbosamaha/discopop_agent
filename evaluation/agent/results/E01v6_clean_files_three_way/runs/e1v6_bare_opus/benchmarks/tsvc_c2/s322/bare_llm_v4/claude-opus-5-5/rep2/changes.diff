+                long k = ks[m];
+                a[k] += (real_t)0.25; b[k] += (real_t)0.25; c[k] += (real_t)0.125;
+                d[k] += (real_t)0.125; e[k] += (real_t)0.25;
+            }
+            if (s == 2L * m + 1) {
+                a[0] += (real_t)0.125;
+            }
