+        for (nl = 0; nl < iterations; nl++) {
+            long j = s - 2L * nl;
+            if (j >= 0 && j < NC) {
+                long lo = 2 + j * CH;
+                long hi = lo + CH;
+                if (hi > N) hi = N;
+                for (long i = lo; i < hi; i++) {
+                    a[i] = a[i] + a[i - 1] * b[i] + a[i - 2] * c[i];
+                }
+            }
         }
-        dummy(a, b, c, d, e);
