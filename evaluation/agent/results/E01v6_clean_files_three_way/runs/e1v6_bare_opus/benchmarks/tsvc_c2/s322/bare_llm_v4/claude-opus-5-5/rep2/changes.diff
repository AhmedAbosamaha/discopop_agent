+
+/* chunk index that "owns" array index idx (indices 0,1 belong to chunk 0) */
+static long s322_chunk_of(long idx, long CH)
+{
+    return idx < 2 ? 0 : (idx - 2) / CH;
+}
 
 real_t kernel_s322(void)
 {
+    const long N = LEN_1D;
+    long CH = (N - 2 + 127) / 128;
+    if (CH < 2048) CH = 2048;
+    if (CH < 2) CH = 2;
+    const long NC = (N - 2 + CH - 1) / CH;   /* number of chunks */
+
+    long ks[iterations];
+    long tk[iterations];
     for (int nl = 0; nl < iterations; nl++) {
-        for (int i = 2; i < LEN_1D; i++) {
-            a[i] = a[i] + a[i - 1] * b[i] + a[i - 2] * c[i];
+        ks[nl] = ((long)nl * 7919L + 13L) % N;
+        tk[nl] = 2L * nl + s322_chunk_of(ks[nl], CH) + 1;
+    }
+
+    const long nsteps = 2L * (iterations - 1) + NC + 1;
+    for (long s = 0; s < nsteps; s++) {
+        int nl;
