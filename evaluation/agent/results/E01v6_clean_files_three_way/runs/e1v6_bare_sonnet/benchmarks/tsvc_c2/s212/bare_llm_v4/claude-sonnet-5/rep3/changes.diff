 /* ==== s212.c ==== */
 #include "data.h"
+#include <stdlib.h>
 
 real_t kernel_s212(void)
 {
+    /* Snapshot buffer for a[]: the original loop reads a[i+1] before it is
+     * ever rescaled (sequential order made that safe). To let iterations
+     * run in any order we read from this frozen copy instead of from a[]
+     * directly, and write the rescaled values into a[] itself. Grows with
+     * the problem size, so it is heap-allocated, not a stack array. */
+    real_t *a_old = (real_t *)malloc((size_t)LEN_1D * sizeof(real_t));
+
     for (int nl = 0; nl < iterations; nl++) {
+        /* Take a fresh snapshot of a[] for this sweep. Each index is
+         * independent: a_old[i] only depends on a[i]. */
+        #pragma omp parallel for shared(a, a_old)
+        for (int i = 0; i < LEN_1D; i++) {
+            a_old[i] = a[i];
+        }
+
+        /* b[i] now reads a_old[i+1] (the pre-sweep value, matching the
+         * original sequential semantics) instead of the live, possibly
+         * already-updated a[i+1]. a[i] is written only from a_old[i] and
+         * c[i]. Both writes (a[i], b[i]) and all reads (a_old[i],
+         * a_old[i+1], c[i], d[i]) touch disjoint or read-only data across
+         * iterations, so there is no loop-carried dependence left. */
+        #pragma omp parallel for shared(a, b, c, d, a_old)
         for (int i = 0; i < LEN_1D-1; i++) {
-            a[i] *= c[i];
-            b[i] += a[i + 1] * d[i];
+            a[i] = a_old[i] * c[i];
+            b[i] += a_old[i + 1] * d[i];
         }
         dummy(a, b, c, d, e);
     }
+
+    free(a_old);
     return (real_t)0;
 }
 
