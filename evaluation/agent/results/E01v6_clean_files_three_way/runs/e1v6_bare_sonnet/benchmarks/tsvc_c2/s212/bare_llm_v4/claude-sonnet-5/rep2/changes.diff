@@ -63,9 +63,23 @@
 real_t kernel_s212(void)
 {
     for (int nl = 0; nl < iterations; nl++) {
+        /* Original loop carried a dependence: b[i] reads a[i+1], and in the
+         * sequential order a[i+1] is still its pre-multiplication value at
+         * that point (it only gets multiplied by c[i+1] in the *next*
+         * iteration, i+1, which runs later). Splitting into two passes
+         * reproduces that exactly: pass 1 computes all of b[] from the
+         * untouched a[], pass 2 then updates a[] in place. The two passes
+         * are independent of each other (pass 2 never affects pass 1's
+         * inputs) and each pass has independent per-index work, so each
+         * can be parallelized on its own.
+         */
+        #pragma omp parallel for shared(a, b, d)
+        for (int i = 0; i < LEN_1D-1; i++) {
+            b[i] += a[i + 1] * d[i];
+        }
+        #pragma omp parallel for shared(a, c)
         for (int i = 0; i < LEN_1D-1; i++) {
             a[i] *= c[i];
-            b[i] += a[i + 1] * d[i];
         }
         dummy(a, b, c, d, e);
     }
