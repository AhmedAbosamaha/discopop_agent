+        int nblocks = S341_NUM_BLOCKS;
+        if (nblocks > LEN_1D) nblocks = LEN_1D;
+
+        /* Per-block count of elements satisfying b[i] > 0, and the
+         * exclusive prefix sum of those counts (= starting write offset
+         * for each block).  Both are sized by the fixed nblocks constant,
+         * not by LEN_1D. */
+        long blockCount[S341_NUM_BLOCKS];
+        long blockOffset[S341_NUM_BLOCKS];
+
+        /* Pass 1: count matches within each block.  Blocks partition
+         * [0, LEN_1D) into disjoint contiguous ranges, so each iteration
+         * only reads b[] and writes its own blockCount[blk] slot -- no
+         * dependence between blocks. */
+        #pragma omp parallel for schedule(static) shared(b, nblocks, blockCount)
+        for (int blk = 0; blk < nblocks; blk++) {
+            long start = (long)blk * LEN_1D / nblocks;
+            long end = (long)(blk + 1) * LEN_1D / nblocks;
+            long cnt = 0;
+            for (long i = start; i < end; i++) {
+                if (b[i] > (real_t)0.) cnt++;
+            }
+            blockCount[blk] = cnt;
+        }
