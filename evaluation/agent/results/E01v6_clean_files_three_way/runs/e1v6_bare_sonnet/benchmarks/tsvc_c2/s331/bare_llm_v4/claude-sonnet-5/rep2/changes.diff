+         * original j (-1) via max, giving the same final j as the
+         * sequential last-match scan regardless of iteration order. */
+        #pragma omp parallel for reduction(max:j)
         for (int i = 0; i < LEN_1D; i++) {
             if (a[i] < (real_t)0.) {
-                j = i;
+                if (i > j) {
+                    j = i;
+                }
             }
         }
         chksum = (real_t) j;
