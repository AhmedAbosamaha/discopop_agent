+        // and writes to unique location a[i+1], so all iterations are independent
+        #pragma omp parallel for \
+            shared(a, a_snap, b) \
+            private(i)
         for (int i = LEN_1D - 2; i >= 0; i--) {
-            a[i+1] = a[i] + b[i];
+            a[i+1] = a_snap[i] + b[i];
         }
