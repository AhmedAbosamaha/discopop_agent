+#include <stdlib.h>
 #include "data.h"
 
 real_t kernel_s211(void)
 {
+    real_t *tmp = (real_t *)malloc(sizeof(real_t) * (size_t)LEN_1D);
+
     for (int nl = 0; nl < iterations; nl++) {
+        /* Pass 1: new b values from old b only (removes the anti-dependence). */
+        #pragma omp parallel for default(none) shared(b, d, e, tmp) schedule(static)
         for (int i = 1; i < LEN_1D-1; i++) {
-            a[i] = b[i - 1] + c[i] * d[i];
-            b[i] = b[i + 1] - e[i] * d[i];
+            tmp[i] = b[i + 1] - e[i] * d[i];
         }
+
+        /* a[1] reads b[0], which the original loop never modifies. */
+        a[1] = b[0] + c[1] * d[1];
+        b[1] = tmp[1];
+
+        /* Pass 2: a[i] uses the new b[i-1] (== tmp[i-1]); commit b. */
+        #pragma omp parallel for default(none) shared(a, b, c, d, tmp) schedule(static)
+        for (int i = 2; i < LEN_1D-1; i++) {
+            a[i] = tmp[i - 1] + c[i] * d[i];
+            b[i] = tmp[i];
+        }
+
         dummy(a, b, c, d, e);
     }
+
+    free(tmp);
     return (real_t)0;
 }
 
