 /* ==== s243.c ==== */
 #include "data.h"
+#include <stdlib.h>
 
 real_t kernel_s243(void)
 {
+    /* Snapshot of a[] taken before each sweep: iteration i reads the
+       pre-sweep value of a[i+1], which the original obtained because
+       iteration i+1 had not yet run.  Reading from the copy removes
+       the anti-dependence between consecutive iterations. */
+    real_t *a_old = (real_t *)malloc((size_t)LEN_1D * sizeof(real_t));
+
     for (int nl = 0; nl < iterations; nl++) {
+#pragma omp parallel for default(none) shared(a, a_old) schedule(static)
+        for (int i = 0; i < LEN_1D; i++) {
+            a_old[i] = a[i];
+        }
+
+#pragma omp parallel for default(none) shared(a, b, c, d, e, a_old) schedule(static)
         for (int i = 0; i < LEN_1D-1; i++) {
             a[i] = b[i] + c[i  ] * d[i];
             b[i] = a[i] + d[i  ] * e[i];
-            a[i] = b[i] + a[i+1] * d[i];
+            a[i] = b[i] + a_old[i+1] * d[i];
         }
         dummy(a, b, c, d, e);
     }
+
+    free(a_old);
     return (real_t)0;
 }
 
