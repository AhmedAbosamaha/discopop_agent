+        /* Pass 1: count positives per chunk (independent chunks). */
+        #pragma omp parallel for schedule(static) shared(counts, b) firstprivate(chunk, nchunk)
+        for (int ch = 0; ch < nchunk; ch++) {
+            int start = ch * chunk;
+            int end = start + chunk;
+            if (end > LEN_1D) end = LEN_1D;
+            int cnt = 0;
