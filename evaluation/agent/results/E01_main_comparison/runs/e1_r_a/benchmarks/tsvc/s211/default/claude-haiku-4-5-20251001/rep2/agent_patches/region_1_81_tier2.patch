 static real_t kernel_s211(void)
 {
     for (int nl = 0; nl < R; nl++) {
+        /* Split into two passes to remove loop-carried dependence on b:
+         * Pass 1: compute b from original b[i+1] values (all iterations independent)
+         * Pass 2: compute a from updated b[i-1] values (all iterations independent) */
+        for (int i = 1; i < LEN_1D-1; i++) {
+            b[i] = b[i + 1] - e[i] * d[i];
+        }
         for (int i = 1; i < LEN_1D-1; i++) {
             a[i] = b[i - 1] + c[i] * d[i];
-            b[i] = b[i + 1] - e[i] * d[i];
         }
         pb_mix(nl);
     }