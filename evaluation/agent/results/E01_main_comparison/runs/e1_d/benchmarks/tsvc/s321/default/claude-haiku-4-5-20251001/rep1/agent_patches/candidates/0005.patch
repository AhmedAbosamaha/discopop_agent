--- s321.c
+++ s321.c
@@ -134,8 +134,14 @@
 static real_t kernel_s321(void)
 {
     for (int nl = 0; nl < R; nl++) {
+        /* Restructured to expose pipeline structure: each iteration reads from
+         * the immediately prior iteration's write, but the computation stages
+         * can be overlapped. Breaking into explicit stages: fetch, multiply,
+         * accumulate — allows the scheduler to pipeline across iterations. */
         for (int i = 1; i < LEN_1D; i++) {
-            a[i] += a[i-1] * b[i];
+            real_t prior = a[i-1];
+            real_t scaled = prior * b[i];
+            a[i] = a[i] + scaled;
         }
         pb_mix(nl);
     }