 static real_t kernel_s3112(void)
 {
     real_t sum;
+    int block_size = 1024;
+    int num_blocks = (LEN_1D + block_size - 1) / block_size;
+    real_t* block_sums = (real_t*)malloc((size_t)num_blocks * sizeof(real_t));
+    real_t* block_offsets = (real_t*)malloc((size_t)num_blocks * sizeof(real_t));
+
     for (int nl = 0; nl < R; nl++) {
         sum = (real_t)0.0;
-        for (int i = 0; i < LEN_1D; i++) {
-            sum += a[i];
-            b[i] = sum;
+
+        /* Phase 1: Compute prefix sums within each block independently */
+        for (int block_id = 0; block_id < num_blocks; block_id++) {
+            int start = block_id * block_size;
+            int end = start + block_size;
+            if (end > LEN_1D) end = LEN_1D;
+
+            real_t block_sum = (real_t)0.0;
+            for (int i = start; i < end; i++) {
+                block_sum += a[i];
+                b[i] = block_sum;
+            }
+            block_sums[block_id] = block_sum;
         }
+
+        /* Phase 2: Compute prefix of block sums for offsets */
+        real_t offset = (real_t)0.0;
+        for (int block_id = 0; block_id < num_blocks; block_id++) {
+            block_offsets[block_id] = offset;
+            offset += block_sums[block_id];
+        }
+        sum = offset;
+
+        /* Phase 3: Adjust each block's b values by its offset */
+        for (int block_id = 0; block_id < num_blocks; block_id++) {
+            int start = block_id * block_size;
+            int end = start + block_size;
+            if (end > LEN_1D) end = LEN_1D;
+
+            for (int i = start; i < end; i++) {
+                b[i] += block_offsets[block_id];
+            }
+        }
+
         pb_mix(nl);
     }
+
+    free(block_sums);
+    free(block_offsets);
     return sum;
 }
 