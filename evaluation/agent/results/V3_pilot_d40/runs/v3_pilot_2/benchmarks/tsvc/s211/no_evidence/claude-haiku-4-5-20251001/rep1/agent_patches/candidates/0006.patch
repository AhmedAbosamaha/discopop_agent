 static real_t kernel_s211(void)
 {
+    real_t *b_snap = (real_t *)malloc(LEN_1D * sizeof(real_t));
+    if (!b_snap) { fprintf(stderr, "out of memory\n"); return 0; }
+
     for (int nl = 0; nl < R; nl++) {
+        /* Snapshot b at the start of each repetition.
+           All loop iterations read from this snapshot, allowing them to run in parallel
+           without loop-carried dependences through b[i-1]. */
+        for (int i = 0; i < LEN_1D; i++) {
+            b_snap[i] = b[i];
+        }
+
+        /* Do-All loop: each iteration writes to distinct a[i] and b[i] locations,
+           and reads only from the snapshot and read-only arrays c, d, e. */
         for (int i = 1; i < LEN_1D-1; i++) {
-            a[i] = b[i - 1] + c[i] * d[i];
-            b[i] = b[i + 1] - e[i] * d[i];
+            a[i] = b_snap[i - 1] + c[i] * d[i];
+            b[i] = b_snap[i + 1] - e[i] * d[i];
         }
         pb_mix(nl);
     }
+
+    free(b_snap);
     return (real_t)0;
 }
 