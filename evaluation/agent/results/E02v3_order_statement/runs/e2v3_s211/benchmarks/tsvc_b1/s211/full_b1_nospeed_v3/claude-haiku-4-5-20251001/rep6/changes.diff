@@ -15,13 +17,28 @@
 
 static real_t kernel_s211(void)
 {
+    real_t *b_save = malloc(LEN_1D * sizeof(real_t));
+
     for (int nl = 0; nl < R; nl++) {
+        /* Save original b values before modification */
+        memcpy(b_save, b, LEN_1D * sizeof(real_t));
+
+        /* Phase 1: Update b using saved values (no loop-carried dependence) */
+        #pragma omp parallel for shared(b_save) 
+        for (int i = 1; i < LEN_1D-1; i++) {
+            b[i] = b_save[i + 1] - e[i] * d[i];
+        }
+
+        /* Phase 2: Compute a using updated b (no loop-carried dependence) */
+        #pragma omp parallel for 
         for (int i = 1; i < LEN_1D-1; i++) {
             a[i] = b[i - 1] + c[i] * d[i];
-            b[i] = b[i + 1] - e[i] * d[i];
         }
+
         pb_mix(nl);
     }
+
+    free(b_save);
     return (real_t)0;
 }
 
