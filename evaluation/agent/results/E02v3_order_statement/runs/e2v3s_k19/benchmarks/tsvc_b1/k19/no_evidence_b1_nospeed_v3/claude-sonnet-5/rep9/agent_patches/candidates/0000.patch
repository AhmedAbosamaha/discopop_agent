 static real_t kernel_k19(void)
 {
+    /* u[ju[i]] and v[jv[i]] are the only locations this loop writes, while
+     * v[kv[i]] and u[ku[i]] are the only locations it reads. Read and write
+     * targets of the same array never coincide, so every read in a given
+     * repetition observes exactly the value the array held when the
+     * repetition began (a location is reused across i, but no value
+     * produced by one i is meant to be observed by another i within the
+     * same repetition). Snapshotting u and v into heap buffers before the
+     * i loop, and reading only from those snapshots, reproduces precisely
+     * that value for every i regardless of execution order, so the i loop
+     * becomes independent across iterations; the snapshot copy itself is
+     * an extra O(LEN_1D) pass per repetition, a constant-factor cost. */
+    real_t *u_old = (real_t *)malloc((size_t)LEN_1D * sizeof(real_t));
+    real_t *v_old = (real_t *)malloc((size_t)LEN_1D * sizeof(real_t));
     for (int nl = 0; nl < R; nl++) {
+        for (long i = 0; i < LEN_1D; i++) {
+            u_old[i] = u[i];
+            v_old[i] = v[i];
+        }
         for (long i = 1; i < LEN_1D; i++) {
-            u[ju[i]] += v[kv[i]] * c[i];
-            v[jv[i]] = u[ku[i]] * d[i] + c[i];
+            u[ju[i]] += v_old[kv[i]] * c[i];
+            v[jv[i]] = u_old[ku[i]] * d[i] + c[i];
