+   // Inline and parallelize CalcTimeConstraintsForElems
+   Real_t dtcourant = 1.0e+20;
+   Real_t dthydro = 1.0e+20;
+
+   #pragma omp parallel for reduction(min:dtcourant,dthydro) \
+       schedule(static)
+   for (Index_t r=0 ; r < domain.numReg() ; ++r) {
+      // CalcCourantConstraintForElems for this region
+      {
+         Real_t qqc2 = Real_t(64.0) * domain.qqc() * domain.qqc() ;
+         Real_t dtcourant_tmp = dtcourant;
+         Index_t courant_elem = -1 ;
+         Index_t length = domain.regElemSize(r);
+         Index_t *regElemlist = domain.regElemlist(r);
+
+         for (Index_t i = 0 ; i < length ; ++i) {
+            Index_t indx = regElemlist[i] ;
+            Real_t dtf = domain.ss(indx) * domain.ss(indx) ;
+
+            if ( domain.vdov(indx) < Real_t(0.) ) {
+               dtf = dtf
+                   + qqc2 * domain.arealg(indx) * domain.arealg(indx)
+                   * domain.vdov(indx) * domain.vdov(indx) ;
+            }
+
+            dtf = SQRT(dtf) ;
+            dtf = domain.arealg(indx) / dtf ;
+
+            if (domain.vdov(indx) != Real_t(0.)) {
+               if ( dtf < dtcourant_tmp ) {
+                  dtcourant_tmp = dtf ;
+                  courant_elem = indx ;
+               }
+            }
+         }
+
+         if (courant_elem != -1) {
+            dtcourant = dtcourant_tmp ;
+         }
+      }
+
+      // CalcHydroConstraintForElems for this region
+      {
+         Real_t dthydro_tmp = dthydro ;
+         Index_t hydro_elem = -1 ;
+         Index_t length = domain.regElemSize(r);
+         Index_t *regElemlist = domain.regElemlist(r);
+
+         for (Index_t i = 0 ; i < length ; ++i) {
+            Index_t indx = regElemlist[i] ;
+
+            if (domain.vdov(indx) != Real_t(0.)) {
+               Real_t dtdvov = domain.dvovmax() / (FABS(domain.vdov(indx))+Real_t(1.e-20)) ;
+
+               if ( dthydro_tmp > dtdvov ) {
+                  dthydro_tmp = dtdvov ;
+                  hydro_elem = indx ;
+               }
+            }
+         }
+
+         if (hydro_elem != -1) {
+            dthydro = dthydro_tmp ;
+         }
+      }
+   }
+
+   domain.dtcourant() = dtcourant;
+   domain.dthydro() = dthydro;
+
+}