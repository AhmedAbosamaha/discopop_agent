--- /home/ahmedabosamaha/discopop_agent/evaluation/agent/runs/e6c_smoke3/benchmarks/llnl_c1/lulesh/llm_pragmas_v5/claude-haiku-4-5-20251001/rep1/work/lulesh.cc
+++ /home/ahmedabosamaha/discopop_agent/evaluation/agent/runs/e6c_smoke3/benchmarks/llnl_c1/lulesh/llm_pragmas_v5/claude-haiku-4-5-20251001/rep1/work/lulesh.cc
@@ -2274,16 +2274,56 @@
    domain.dtcourant() = 1.0e+20;
    domain.dthydro() = 1.0e+20;
 
-   for (Index_t r=0 ; r < domain.numReg() ; ++r) {
-      CalcCourantConstraintForElems(domain, domain.regElemSize(r),
-                                    domain.regElemlist(r),
-                                    domain.qqc(),
-                                    domain.dtcourant()) ;
-
-      CalcHydroConstraintForElems(domain, domain.regElemSize(r),
-                                  domain.regElemlist(r),
-                                  domain.dvovmax(),
-                                  domain.dthydro()) ;
+   #pragma omp parallel
+   {
+      Real_t local_dtcourant = 1.0e+20;
+      Real_t local_dthydro = 1.0e+20;
+      Real_t qqc = domain.qqc();
+      Real_t qqc2 = Real_t(64.0) * qqc * qqc;
+      Real_t dvovmax = domain.dvovmax();
+
+      #pragma omp for collapse(2)
+      for (Index_t r=0 ; r < domain.numReg() ; ++r) {
+         for (Index_t i = 0 ; i < domain.regElemSize(r) ; ++i) {
+            Index_t indx = domain.regElemlist(r)[i];
+
+            // Inline CalcCourantConstraintForElems computation
+            {
+               Real_t dtf = domain.ss(indx) * domain.ss(indx);
+               if (domain.vdov(indx) < Real_t(0.)) {
+                  dtf = dtf + qqc2 * domain.arealg(indx) * domain.arealg(indx)
+                             * domain.vdov(indx) * domain.vdov(indx);
+               }
+               dtf = SQRT(dtf);
+               dtf = domain.arealg(indx) / dtf;
+               if (domain.vdov(indx) != Real_t(0.)) {
+                  if (dtf < local_dtcourant) {
+                     local_dtcourant = dtf;
+                  }
+               }
+            }
+
+            // Inline CalcHydroConstraintForElems computation
+            {
+               if (domain.vdov(indx) != Real_t(0.)) {
+                  Real_t dtdvov = dvovmax / (FABS(domain.vdov(indx)) + Real_t(1.e-20));
+                  if (local_dthydro > dtdvov) {
+                     local_dthydro = dtdvov;
+                  }
+               }
+            }
+         }
+      }
+
+      #pragma omp critical
+      {
+         if (local_dtcourant < domain.dtcourant()) {
+            domain.dtcourant() = local_dtcourant;
+         }
+         if (local_dthydro < domain.dthydro()) {
+            domain.dthydro() = local_dthydro;
+         }
+      }
    }
 }
 