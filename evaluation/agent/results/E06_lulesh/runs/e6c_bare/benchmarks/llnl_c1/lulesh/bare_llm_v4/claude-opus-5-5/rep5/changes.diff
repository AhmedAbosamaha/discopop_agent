+/* node -> element-corner map (CSR), built once in increasing element order */
+static Index_t *g_nodeElemStart = NULL ;
+static Index_t *g_nodeElemCornerList = NULL ;
+static Index_t  g_mapNumNode = -1 ;
+static Index_t  g_mapNumElem = -1 ;
+static const Index_t *g_mapNodelist = NULL ;
+
+static void BuildNodeElemCornerMap(Domain &domain)
+{
+   Index_t numNode = domain.numNode() ;
+   Index_t numElem = domain.numElem() ;
+   const Index_t *nl = (numElem > 0) ? domain.nodelist(0) : NULL ;
+
+   if (g_nodeElemStart != NULL && numNode == g_mapNumNode &&
+       numElem == g_mapNumElem && nl == g_mapNodelist) {
+      return ;
+   }
+
+   Release(&g_nodeElemStart) ;
+   Release(&g_nodeElemCornerList) ;
+
+   g_nodeElemStart = Allocate<Index_t>(numNode + 1) ;
+   for (Index_t n = 0 ; n <= numNode ; ++n) {
+      g_nodeElemStart[n] = 0 ;
+   }
+   for (Index_t c = 0 ; c < 8*numElem ; ++c) {
+      g_nodeElemStart[nl[c] + 1]++ ;
+   }
+   for (Index_t n = 0 ; n < numNode ; ++n) {
+      g_nodeElemStart[n+1] += g_nodeElemStart[n] ;
+   }
+
+   Index_t total = 8*numElem ;
+   g_nodeElemCornerList = Allocate<Index_t>(total > 0 ? total : 1) ;
+   Index_t *pos = Allocate<Index_t>(numNode + 1) ;
+   for (Index_t n = 0 ; n <= numNode ; ++n) {
+      pos[n] = g_nodeElemStart[n] ;
+   }
+   for (Index_t c = 0 ; c < total ; ++c) {
+      Index_t n = nl[c] ;
+      g_nodeElemCornerList[pos[n]++] = c ;
+   }
+   Release(&pos) ;
+
+   g_mapNumNode = numNode ;
+   g_mapNumElem = numElem ;
+   g_mapNodelist = nl ;
+}
+
+/* Adds per-corner element contributions to the nodal forces, in the same
+   (increasing element) order the sequential scatter used. */
+static void GatherElemForcesToNodes(Domain &domain,
+                                    const Real_t *fx_elem,
+                                    const Real_t *fy_elem,
+                                    const Real_t *fz_elem,
+                                    Index_t numNode)
+{
+   BuildNodeElemCornerMap(domain) ;
+   const Index_t *start = g_nodeElemStart ;
+   const Index_t *list  = g_nodeElemCornerList ;
+
+#pragma omp parallel for shared(domain, fx_elem, fy_elem, fz_elem, start, list, numNode)
+   for (Index_t n = 0 ; n < numNode ; ++n) {
+      Real_t fxn = domain.fx(n) ;
+      Real_t fyn = domain.fy(n) ;
+      Real_t fzn = domain.fz(n) ;
+      Index_t cEnd = start[n+1] ;
+      for (Index_t c = start[n] ; c < cEnd ; ++c) {
+         Index_t corner = list[c] ;
+         fxn += fx_elem[corner] ;
+         fyn += fy_elem[corner] ;
+         fzn += fz_elem[corner] ;
+      }
+      domain.fx(n) = fxn ;
+      domain.fy(n) = fyn ;
+      domain.fz(n) = fzn ;
+   }
+}
