       sigxx[i] = sigyy[i] = sigzz[i] =  - domain.p(i) - domain.q(i) ;
    }
+}
+
+/* Node -> (element, corner) adjacency.  The mesh connectivity never
+   changes once the domain is built, so this is computed once and reused.
+   The corner list of each node is filled in increasing element order, so
+   gathering over it reproduces the original element-ordered summation
+   bit for bit. */
+static Index_t  s_nodeElemNumNode    = -1 ;
+static Index_t  s_nodeElemNumElem    = -1 ;
+static Index_t *s_nodeElemBase       = NULL ;
+static Index_t *s_nodeElemStart      = NULL ;
+static Index_t *s_nodeElemCornerList = NULL ;
+
+static inline
+void BuildNodeElemMap(Domain &domain, Index_t numElem, Index_t numNode)
+{
+   Index_t *base = (numElem > 0) ? domain.nodelist(0) : NULL ;
+
+   if (s_nodeElemStart != NULL && s_nodeElemCornerList != NULL &&
+       s_nodeElemNumNode == numNode && s_nodeElemNumElem == numElem &&
+       s_nodeElemBase == base) {
+      return ;
+   }
+
+   Release(&s_nodeElemStart) ;
+   Release(&s_nodeElemCornerList) ;
+
+   Index_t *count = Allocate<Index_t>(numNode + 1) ;
+   for (Index_t i = 0 ; i < numNode ; ++i) {
+      count[i] = 0 ;
+   }
+   for (Index_t k = 0 ; k < numElem ; ++k) {
+      const Index_t *elemToNode = domain.nodelist(k) ;
+      for (Index_t j = 0 ; j < 8 ; ++j) {
+         ++count[elemToNode[j]] ;
+      }
+   }
+
+   s_nodeElemStart = Allocate<Index_t>(numNode + 1) ;
+   s_nodeElemStart[0] = 0 ;
+   for (Index_t i = 0 ; i < numNode ; ++i) {
+      s_nodeElemStart[i+1] = s_nodeElemStart[i] + count[i] ;
+      count[i] = 0 ;
+   }
+
+   s_nodeElemCornerList = Allocate<Index_t>(s_nodeElemStart[numNode] + 1) ;
+   for (Index_t k = 0 ; k < numElem ; ++k) {
+      const Index_t *elemToNode = domain.nodelist(k) ;
+      for (Index_t j = 0 ; j < 8 ; ++j) {
+         Index_t n = elemToNode[j] ;
+         s_nodeElemCornerList[s_nodeElemStart[n] + count[n]] = 8*k + j ;
+         ++count[n] ;
+      }
+   }
+
+   Release(&count) ;
+
+   s_nodeElemNumNode = numNode ;
+   s_nodeElemNumElem = numElem ;
+   s_nodeElemBase    = base ;
 }
 
