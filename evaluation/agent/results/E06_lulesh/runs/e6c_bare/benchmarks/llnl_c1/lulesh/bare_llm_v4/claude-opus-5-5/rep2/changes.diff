+/* node -> element-corner map (corners listed in ascending element order),
+   built once; the mesh connectivity never changes */
+static Index_t *g_nodeElemStart = NULL ;
+static Index_t *g_nodeElemCornerList = NULL ;
+static Index_t  g_mapNumNode = -1 ;
+static Index_t  g_mapNumElem = -1 ;
+static const Index_t *g_mapNodelist = NULL ;
+
+static void BuildNodeElemCornerMap(Domain &domain)
+{
+   Index_t numNode = domain.numNode() ;
+   Index_t numElem = domain.numElem() ;
+   const Index_t *nl = domain.nodelist(0) ;
+   if (g_nodeElemStart != NULL && g_mapNumNode == numNode &&
+       g_mapNumElem == numElem && g_mapNodelist == nl) {
+      return ;
+   }
+   Release(&g_nodeElemStart) ;
+   Release(&g_nodeElemCornerList) ;
+   g_nodeElemStart = Allocate<Index_t>(numNode+1) ;
+   g_nodeElemCornerList = Allocate<Index_t>(Index_t(8)*numElem + 1) ;
+   Index_t *cursor = Allocate<Index_t>(numNode+1) ;
+   for (Index_t i = 0 ; i <= numNode ; ++i) {
+      g_nodeElemStart[i] = 0 ;
+   }
+   for (Index_t c = 0 ; c < 8*numElem ; ++c) {
+      g_nodeElemStart[nl[c]+1]++ ;
+   }
+   for (Index_t i = 0 ; i < numNode ; ++i) {
+      g_nodeElemStart[i+1] += g_nodeElemStart[i] ;
+   }
+   for (Index_t i = 0 ; i < numNode ; ++i) {
+      cursor[i] = g_nodeElemStart[i] ;
+   }
+   for (Index_t c = 0 ; c < 8*numElem ; ++c) {
+      g_nodeElemCornerList[cursor[nl[c]]++] = c ;
+   }
+   Release(&cursor) ;
+   g_mapNumNode = numNode ;
+   g_mapNumElem = numElem ;
+   g_mapNodelist = nl ;
+}
+
+/* add per-corner forces to nodes, in ascending element order per node */
+static void GatherCornerForces(Domain &domain,
+                               const Real_t *fx_elem, const Real_t *fy_elem,
+                               const Real_t *fz_elem)
+{
+   Index_t numNode = domain.numNode() ;
+   const Index_t *start = g_nodeElemStart ;
+   const Index_t *clist = g_nodeElemCornerList ;
+#pragma omp parallel for schedule(static) firstprivate(numNode, start, clist)
+   for (Index_t i = 0 ; i < numNode ; ++i) {
+      Real_t sx = domain.fx(i) ;
+      Real_t sy = domain.fy(i) ;
+      Real_t sz = domain.fz(i) ;
+      for (Index_t c = start[i] ; c < start[i+1] ; ++c) {
+         Index_t corner = clist[c] ;
+         sx += fx_elem[corner] ;
+         sy += fy_elem[corner] ;
+         sz += fz_elem[corner] ;
+      }
+      domain.fx(i) = sx ;
+      domain.fy(i) = sy ;
+      domain.fz(i) = sz ;
+   }
+}
