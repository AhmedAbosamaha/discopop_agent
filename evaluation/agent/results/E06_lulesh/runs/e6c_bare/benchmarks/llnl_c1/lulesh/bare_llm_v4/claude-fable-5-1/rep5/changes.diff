+/* Node -> element-corner inverse connectivity.  For node n, the corners
+ * k*8+l of every element k that touches n are listed in
+ * nodeElemCornerList[nodeElemStart[n] .. nodeElemStart[n+1]) in INCREASING
+ * element order.  Gathering in that order reproduces, bit for bit, the
+ * serial element-ordered "fx(gnode) += ..." accumulation chain.
+ * The mesh connectivity never changes during a run, so the map is built
+ * once and cached (rebuilt only if the mesh size changes). */
+static Index_t *g_nodeElemStart      = NULL ;
+static Index_t *g_nodeElemCornerList = NULL ;
+static Index_t  g_nodeElemNumElem    = -1 ;
+static Index_t  g_nodeElemNumNode    = -1 ;
+
+static inline
+void BuildNodeElemMap(Domain &domain, Index_t numElem, Index_t numNode)
+{
+   if ((g_nodeElemStart != NULL) && (g_nodeElemCornerList != NULL) &&
+       (g_nodeElemNumElem == numElem) && (g_nodeElemNumNode == numNode)) {
+      return ;
+   }
+
+   Release(&g_nodeElemStart) ;
+   Release(&g_nodeElemCornerList) ;
+
+   g_nodeElemStart      = Allocate<Index_t>(numNode+1) ;
+   g_nodeElemCornerList = Allocate<Index_t>(numElem*8) ;
+
+   Index_t *cursor = Allocate<Index_t>(numNode) ;
+
+   for (Index_t i = 0 ; i < numNode ; ++i) {
+      cursor[i] = 0 ;
+   }
+   for (Index_t k = 0 ; k < numElem ; ++k) {
+      const Index_t *elemToNode = domain.nodelist(k) ;
+      for (Index_t l = 0 ; l < 8 ; ++l) {
+         ++cursor[elemToNode[l]] ;
+      }
+   }
+   g_nodeElemStart[0] = 0 ;
+   for (Index_t i = 0 ; i < numNode ; ++i) {
+      g_nodeElemStart[i+1] = g_nodeElemStart[i] + cursor[i] ;
+      cursor[i] = g_nodeElemStart[i] ;
+   }
+   for (Index_t k = 0 ; k < numElem ; ++k) {
+      const Index_t *elemToNode = domain.nodelist(k) ;
+      for (Index_t l = 0 ; l < 8 ; ++l) {
+         Index_t gnode = elemToNode[l] ;
+         g_nodeElemCornerList[cursor[gnode]++] = k*8 + l ;
+      }
+   }
+
+   Release(&cursor) ;
+
+   g_nodeElemNumElem = numElem ;
+   g_nodeElemNumNode = numNode ;
+}
+
+/* Gather per-element-corner forces into the nodal force arrays.
+ * Each node is owned by exactly one iteration, and the corners are added
+ * in increasing element order starting from the node's current value, so
+ * the floating-point sequence equals the serial element-loop scatter. */
+static inline
+void SumElemForcesToNodes(Domain &domain,
+                          const Real_t *fx_elem,
+                          const Real_t *fy_elem,
+                          const Real_t *fz_elem,
+                          Index_t numNode)
+{
+   const Index_t *nodeElemStart      = g_nodeElemStart ;
+   const Index_t *nodeElemCornerList = g_nodeElemCornerList ;
+
+#pragma omp parallel for shared(domain, fx_elem, fy_elem, fz_elem, nodeElemStart, nodeElemCornerList) firstprivate(numNode)
+   for (Index_t gnode = 0 ; gnode < numNode ; ++gnode) {
+      Index_t start = nodeElemStart[gnode] ;
+      Index_t end   = nodeElemStart[gnode+1] ;
+      Real_t fx_tmp = domain.fx(gnode) ;
+      Real_t fy_tmp = domain.fy(gnode) ;
+      Real_t fz_tmp = domain.fz(gnode) ;
+      for (Index_t i = start ; i < end ; ++i) {
+         Index_t corner = nodeElemCornerList[i] ;
+         fx_tmp += fx_elem[corner] ;
+         fy_tmp += fy_elem[corner] ;
+         fz_tmp += fz_elem[corner] ;
+      }
+      domain.fx(gnode) = fx_tmp ;
+      domain.fy(gnode) = fy_tmp ;
+      domain.fz(gnode) = fz_tmp ;
+   }
+}
