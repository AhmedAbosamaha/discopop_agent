+/* Node -> element-corner map used to turn the element->node force scatter
+ * into a race-free node gather.  Built once (serially) from the nodelist and
+ * cached; corners of each node are stored in ascending element order so the
+ * gather adds contributions in exactly the original element order.          */
+static Index_t *s_nodeElemStart      = NULL ;
+static Index_t *s_nodeElemCornerList = NULL ;
+static Index_t  s_mapNumElem = -1 ;
+static Index_t  s_mapNumNode = -1 ;
+static const Index_t *s_mapNodelist = NULL ;
+
+static inline
+void BuildNodeElemMap(Domain &domain, Index_t numElem, Index_t numNode)
+{
+   const Index_t *nodelistBase = domain.nodelist(0) ;
+
+   if (s_nodeElemStart != NULL && s_nodeElemCornerList != NULL &&
+       s_mapNumElem == numElem && s_mapNumNode == numNode &&
+       s_mapNodelist == nodelistBase) {
+      return ;
+   }
+
+   Release(&s_nodeElemStart) ;
+   Release(&s_nodeElemCornerList) ;
+
+   Index_t *nodeElemCount = Allocate<Index_t>(numNode) ;
+   for (Index_t i=0 ; i<numNode ; ++i) {
+      nodeElemCount[i] = 0 ;
+   }
+   for (Index_t i=0 ; i<numElem ; ++i) {
+      const Index_t *nl = domain.nodelist(i) ;
+      for (Index_t j=0 ; j<8 ; ++j) {
+         ++(nodeElemCount[nl[j]]) ;
+      }
+   }
+
+   s_nodeElemStart = Allocate<Index_t>(numNode+1) ;
+   s_nodeElemStart[0] = 0 ;
+   for (Index_t i=1 ; i<=numNode ; ++i) {
+      s_nodeElemStart[i] = s_nodeElemStart[i-1] + nodeElemCount[i-1] ;
+   }
+
+   s_nodeElemCornerList = Allocate<Index_t>(s_nodeElemStart[numNode]) ;
+   for (Index_t i=0 ; i<numNode ; ++i) {
+      nodeElemCount[i] = 0 ;
+   }
+   for (Index_t i=0 ; i<numElem ; ++i) {
+      const Index_t *nl = domain.nodelist(i) ;
+      for (Index_t j=0 ; j<8 ; ++j) {
+         Index_t m = nl[j] ;
+         Index_t k = s_nodeElemStart[m] + nodeElemCount[m] ;
+         s_nodeElemCornerList[k] = i*8 + j ;
+         ++(nodeElemCount[m]) ;
+      }
+   }
+
+   Release(&nodeElemCount) ;
+
+   s_mapNumElem  = numElem ;
+   s_mapNumNode  = numNode ;
+   s_mapNodelist = nodelistBase ;
+}
