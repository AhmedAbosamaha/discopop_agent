+/* Node -> element-corner map (corners listed in ascending element order),
+   built once; the mesh connectivity never changes. */
+static Index_t *s_nodeElemStart = NULL ;
+static Index_t *s_nodeElemCornerList = NULL ;
+static Index_t  s_cacheNumNode = -1 ;
+static Index_t  s_cacheNumElem = -1 ;
+static const Index_t *s_cacheNodelist = NULL ;
+
+static void GetNodeElemCornerList(Domain &domain, Index_t numElem,
+                                  Index_t numNode,
+                                  const Index_t **start,
+                                  const Index_t **cornerList)
+{
+   const Index_t *nl = (numElem > 0) ? domain.nodelist(0) : NULL ;
+   if (s_nodeElemStart == NULL || s_cacheNumNode != numNode ||
+       s_cacheNumElem != numElem || s_cacheNodelist != nl) {
+      Release(&s_nodeElemStart) ;
+      Release(&s_nodeElemCornerList) ;
+      s_nodeElemStart = Allocate<Index_t>(numNode + 1) ;
+      s_nodeElemCornerList = Allocate<Index_t>(8 * (size_t)numElem + 1) ;
+      for (Index_t i = 0 ; i <= numNode ; ++i) s_nodeElemStart[i] = 0 ;
+      for (Index_t k = 0 ; k < numElem ; ++k) {
+         const Index_t *elemToNode = domain.nodelist(k) ;
+         for (Index_t l = 0 ; l < 8 ; ++l)
+            s_nodeElemStart[elemToNode[l] + 1]++ ;
+      }
+      for (Index_t i = 1 ; i <= numNode ; ++i)
+         s_nodeElemStart[i] += s_nodeElemStart[i-1] ;
+      Index_t *pos = Allocate<Index_t>(numNode + 1) ;
+      for (Index_t i = 0 ; i < numNode ; ++i) pos[i] = s_nodeElemStart[i] ;
+      for (Index_t k = 0 ; k < numElem ; ++k) {
+         const Index_t *elemToNode = domain.nodelist(k) ;
+         for (Index_t l = 0 ; l < 8 ; ++l)
+            s_nodeElemCornerList[pos[elemToNode[l]]++] = 8*k + l ;
+      }
+      Release(&pos) ;
+      s_cacheNumNode = numNode ;
+      s_cacheNumElem = numElem ;
+      s_cacheNodelist = nl ;
+   }
+   *start = s_nodeElemStart ;
+   *cornerList = s_nodeElemCornerList ;
+}
+
+/* Add per-corner forces to nodes, each node summing in ascending element order */
+static void GatherCornerForces(Domain &domain, Index_t numElem, Index_t numNode,
+                               const Real_t *fx_elem, const Real_t *fy_elem,
+                               const Real_t *fz_elem)
+{
+   const Index_t *nodeElemStart ;
+   const Index_t *nodeElemCornerList ;
+   GetNodeElemCornerList(domain, numElem, numNode,
+                         &nodeElemStart, &nodeElemCornerList) ;
+
+#pragma omp parallel for shared(nodeElemStart, nodeElemCornerList, fx_elem, fy_elem, fz_elem)
+   for (Index_t gnode = 0 ; gnode < numNode ; ++gnode) {
+      Real_t fxv = domain.fx(gnode) ;
+      Real_t fyv = domain.fy(gnode) ;
+      Real_t fzv = domain.fz(gnode) ;
+      Index_t cEnd = nodeElemStart[gnode+1] ;
+      for (Index_t c = nodeElemStart[gnode] ; c < cEnd ; ++c) {
+         Index_t corner = nodeElemCornerList[c] ;
+         fxv += fx_elem[corner] ;
+         fyv += fy_elem[corner] ;
+         fzv += fz_elem[corner] ;
+      }
+      domain.fx(gnode) = fxv ;
+      domain.fy(gnode) = fyv ;
+      domain.fz(gnode) = fzv ;
    }
 }
 
