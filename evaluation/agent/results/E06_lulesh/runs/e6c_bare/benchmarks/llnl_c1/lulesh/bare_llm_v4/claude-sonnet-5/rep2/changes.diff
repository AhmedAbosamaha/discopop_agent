+/* Build, once per force-evaluation, the inverse (node -> incident element
+ * corner) adjacency used to turn the scatter-add of per-element corner
+ * forces into node forces into a race-free gather.  nodeElemStart is a CSR
+ * offset array of size numNode+1; nodeElemCornerList[nodeElemStart[n] ..
+ * nodeElemStart[n+1]-1] holds, for node n, the corner indices (k*8+lnode)
+ * of every element corner that references it, listed in strictly
+ * increasing element index k -- the same order the original sequential
+ * code would have visited them in (outer loop over k).  Both passes below
+ * carry a loop-to-loop dependence (the running prefix sum / fill cursor)
+ * so they are left sequential; they are only O(numElem), the same order
+ * as the rest of the per-element work, so this is a constant-factor cost.
+ */
+static inline
+void BuildNodeElemAdjacency(Domain &domain, Index_t numElem, Index_t numNode,
+                            Index_t *nodeElemStart, Index_t *nodeElemCornerList)
+{
+   for (Index_t n = 0 ; n <= numNode ; ++n) {
+      nodeElemStart[n] = 0 ;
+   }
+   for (Index_t k = 0 ; k < numElem ; ++k) {
+      const Index_t *elemToNode = domain.nodelist(k) ;
+      for (Index_t lnode = 0 ; lnode < 8 ; ++lnode) {
+         nodeElemStart[elemToNode[lnode] + 1]++ ;
+      }
+   }
+   for (Index_t n = 0 ; n < numNode ; ++n) {
+      nodeElemStart[n+1] += nodeElemStart[n] ;
+   }
+
+   Index_t *fillPos = Allocate<Index_t>(numNode) ;
+   for (Index_t n = 0 ; n < numNode ; ++n) {
+      fillPos[n] = nodeElemStart[n] ;
+   }
+   for (Index_t k = 0 ; k < numElem ; ++k) {
+      const Index_t *elemToNode = domain.nodelist(k) ;
+      for (Index_t lnode = 0 ; lnode < 8 ; ++lnode) {
+         Index_t nd = elemToNode[lnode] ;
+         nodeElemCornerList[fillPos[nd]++] = k*8 + lnode ;
+      }
+   }
+   Release(&fillPos) ;
+}
+
+/* Adds each node's incident per-element-corner forces into the node force
+ * arrays, one node per iteration, in increasing element order -- exactly
+ * the order the original scatter-add loop would have applied them in for
+ * that node.  Each iteration touches only its own node n's domain.fx/fy/fz,
+ * so distinct iterations never write the same location: race-free for any
+ * schedule, and the sequence of += operations landing in domain.fx(n) is
+ * bit-identical to the original regardless of how the work is scheduled. */
+static inline
+void ScatterElemCornerForcesToNodes(Domain &domain,
+                                    const Real_t *fx_elem, const Real_t *fy_elem,
+                                    const Real_t *fz_elem,
+                                    const Index_t *nodeElemStart,
+                                    const Index_t *nodeElemCornerList,
+                                    Index_t numNode)
+{
+   #pragma omp parallel for default(none) firstprivate(numNode) \
+      shared(domain, fx_elem, fy_elem, fz_elem, nodeElemStart, nodeElemCornerList) \
+      schedule(static)
+   for (Index_t n = 0 ; n < numNode ; ++n) {
+      Index_t start = nodeElemStart[n] ;
+      Index_t end   = nodeElemStart[n+1] ;
+      for (Index_t c = start ; c < end ; ++c) {
+         Index_t corner = nodeElemCornerList[c] ;
+         domain.fx(n) += fx_elem[corner] ;
+         domain.fy(n) += fy_elem[corner] ;
+         domain.fz(n) += fz_elem[corner] ;
+      }
+   }
+}
