 #include "lulesh.h"
 
+/* Node -> element-corner map (CSR), built once from the static nodelist.
+   For node n, corners s_nodeElemCornerList[s_nodeElemStart[n] ..
+   s_nodeElemStart[n+1]) are listed in increasing corner index
+   (corner = 8*elem + lnode), i.e. in increasing element order. */
+static Index_t *s_nodeElemStart      = NULL ;
+static Index_t *s_nodeElemCornerList = NULL ;
+static Index_t  s_mapNumNode = -1 ;
+static Index_t  s_mapNumElem = -1 ;
+static const Index_t *s_mapNodelist = NULL ;
+
+static inline
+void BuildNodeElemMap(Domain &domain, Index_t numElem, Index_t numNode)
+{
+   const Index_t *nodelist = (numElem > 0) ? domain.nodelist(0) : NULL ;
+
+   if (s_nodeElemStart != NULL && s_mapNumNode == numNode &&
+       s_mapNumElem == numElem && s_mapNodelist == nodelist) {
+      return ;
+   }
+
+   Release(&s_nodeElemStart) ;
+   Release(&s_nodeElemCornerList) ;
+
+   s_nodeElemStart      = Allocate<Index_t>(numNode+1) ;
+   s_nodeElemCornerList = Allocate<Index_t>(Index_t(8)*numElem + 1) ;
+   Index_t *fill = Allocate<Index_t>(numNode + 1) ;
+
+   for (Index_t n = 0 ; n <= numNode ; ++n) {
+      s_nodeElemStart[n] = 0 ;
+   }
+   for (Index_t c = 0 ; c < Index_t(8)*numElem ; ++c) {
+      ++s_nodeElemStart[nodelist[c] + 1] ;
+   }
+   for (Index_t n = 0 ; n < numNode ; ++n) {
+      s_nodeElemStart[n+1] += s_nodeElemStart[n] ;
+   }
+   for (Index_t n = 0 ; n < numNode ; ++n) {
+      fill[n] = s_nodeElemStart[n] ;
+   }
+   for (Index_t c = 0 ; c < Index_t(8)*numElem ; ++c) {
+      Index_t n = nodelist[c] ;
+      s_nodeElemCornerList[fill[n]++] = c ;
+   }
+
+   Release(&fill) ;
+
+   s_mapNumNode  = numNode ;
+   s_mapNumElem  = numElem ;
+   s_mapNodelist = nodelist ;
+}
+
+/* Add per-element corner forces into the nodal force arrays.
+   Each node accumulates its corners in increasing element order,
+   starting from the value already in domain.fx/fy/fz, which reproduces
+   the original element-ordered scatter exactly. */
+static inline
+void GatherElemForcesToNodes(Domain &domain,
+                             const Real_t *fx_elem,
+                             const Real_t *fy_elem,
+                             const Real_t *fz_elem,
+                             Index_t numNode)
+{
+   const Index_t *nodeElemStart = s_nodeElemStart ;
+   const Index_t *nodeElemCornerList = s_nodeElemCornerList ;
+
+#pragma omp parallel for schedule(static) \
+   shared(domain, fx_elem, fy_elem, fz_elem, nodeElemStart, nodeElemCornerList) \
+   firstprivate(numNode)
+   for (Index_t gnode = 0 ; gnode < numNode ; ++gnode) {
+      Index_t beg = nodeElemStart[gnode] ;
+      Index_t end = nodeElemStart[gnode+1] ;
+      Real_t fx_tmp = domain.fx(gnode) ;
+      Real_t fy_tmp = domain.fy(gnode) ;
+      Real_t fz_tmp = domain.fz(gnode) ;
+      for (Index_t i = beg ; i < end ; ++i) {
+         Index_t c = nodeElemCornerList[i] ;
+         fx_tmp += fx_elem[c] ;
+         fy_tmp += fy_elem[c] ;
+         fz_tmp += fz_elem[c] ;
+      }
+      domain.fx(gnode) = fx_tmp ;
+      domain.fy(gnode) = fy_tmp ;
+      domain.fz(gnode) = fz_tmp ;
+   }
+}
