+/* Node -> element-corner map (corners listed in increasing element order),
+   built once and cached: the mesh connectivity never changes. */
+static Index_t *s_nodeElemStart = NULL ;
+static Index_t *s_nodeElemCorner = NULL ;
+static Index_t  s_mapNumNode = -1 ;
+static Index_t  s_mapNumElem = -1 ;
+static const Index_t *s_mapNodelist = NULL ;
+
+static void GetNodeElemMap(Domain &domain, Index_t numElem, Index_t numNode,
+                           Index_t **start, Index_t **corner)
+{
+   const Index_t *nl = domain.nodelist(0) ;
+   if (s_nodeElemStart == NULL || s_mapNumNode != numNode ||
+       s_mapNumElem != numElem || s_mapNodelist != nl) {
+      Release(&s_nodeElemStart) ;
+      Release(&s_nodeElemCorner) ;
+      s_nodeElemStart  = Allocate<Index_t>(numNode + 1) ;
+      s_nodeElemCorner = Allocate<Index_t>(8 * numElem + 1) ;
+      Index_t *fill = Allocate<Index_t>(numNode + 1) ;
+      for (Index_t n = 0 ; n <= numNode ; ++n) {
+         s_nodeElemStart[n] = 0 ;
+      }
+      for (Index_t c = 0 ; c < 8 * numElem ; ++c) {
+         s_nodeElemStart[nl[c] + 1]++ ;
+      }
+      for (Index_t n = 0 ; n < numNode ; ++n) {
+         s_nodeElemStart[n + 1] += s_nodeElemStart[n] ;
+      }
+      for (Index_t n = 0 ; n < numNode ; ++n) {
+         fill[n] = s_nodeElemStart[n] ;
+      }
+      for (Index_t c = 0 ; c < 8 * numElem ; ++c) {
+         s_nodeElemCorner[fill[nl[c]]++] = c ;
+      }
+      Release(&fill) ;
+      s_mapNumNode = numNode ;
+      s_mapNumElem = numElem ;
+      s_mapNodelist = nl ;
+   }
+   *start = s_nodeElemStart ;
+   *corner = s_nodeElemCorner ;
+}
+
+/* Adds per-corner forces to the nodal forces, in element order per node
+   (same floating-point summation order as the original scatter). */
+static void GatherCornerForces(Domain &domain, Index_t numNode,
+                               Index_t *nodeElemStart, Index_t *nodeElemCorner,
+                               Real_t *fx_elem, Real_t *fy_elem, Real_t *fz_elem)
+{
+#pragma omp parallel for schedule(static) firstprivate(numNode) \
+        shared(domain, nodeElemStart, nodeElemCorner, fx_elem, fy_elem, fz_elem)
+   for (Index_t n = 0 ; n < numNode ; ++n) {
+      Real_t fx = domain.fx(n) ;
+      Real_t fy = domain.fy(n) ;
+      Real_t fz = domain.fz(n) ;
+      Index_t cEnd = nodeElemStart[n + 1] ;
+      for (Index_t c = nodeElemStart[n] ; c < cEnd ; ++c) {
+         Index_t ci = nodeElemCorner[c] ;
+         fx += fx_elem[ci] ;
+         fy += fy_elem[ci] ;
+         fz += fz_elem[ci] ;
+      }
+      domain.fx(n) = fx ;
+      domain.fy(n) = fy ;
+      domain.fz(n) = fz ;
+   }
+}
