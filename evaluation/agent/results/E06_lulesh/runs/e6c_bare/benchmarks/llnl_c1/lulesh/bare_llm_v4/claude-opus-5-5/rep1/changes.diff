 #include "lulesh.h"
 
+/* node -> element-corner connectivity (CSR), built once in element order so
+   that gathering per node reproduces the original scatter summation order */
+static Index_t       *s_nodeElemStart  = NULL ;
+static Index_t       *s_nodeElemCorner = NULL ;
+static const Index_t *s_cachedNodelist = NULL ;
+static Index_t        s_cachedNumElem  = -1 ;
+static Index_t        s_cachedNumNode  = -1 ;
+
+static void GetNodeElemCorners(Domain &domain,
+                               const Index_t **start, const Index_t **corner)
+{
+   Index_t numElem = domain.numElem() ;
+   Index_t numNode = domain.numNode() ;
+   const Index_t *nl = (numElem > 0) ? domain.nodelist(0) : NULL ;
+   if (s_nodeElemStart == NULL || nl != s_cachedNodelist ||
+       numElem != s_cachedNumElem || numNode != s_cachedNumNode) {
+      Release(&s_nodeElemStart) ;
+      Release(&s_nodeElemCorner) ;
+      s_nodeElemStart  = Allocate<Index_t>(numNode+1) ;
+      s_nodeElemCorner = Allocate<Index_t>(8*(size_t)numElem + 1) ;
+      for (Index_t n = 0 ; n <= numNode ; ++n) s_nodeElemStart[n] = 0 ;
+      for (Index_t c = 0 ; c < 8*numElem ; ++c) s_nodeElemStart[nl[c]+1]++ ;
+      for (Index_t n = 0 ; n < numNode ; ++n)
+         s_nodeElemStart[n+1] += s_nodeElemStart[n] ;
+      Index_t *fill = Allocate<Index_t>(numNode+1) ;
+      for (Index_t n = 0 ; n < numNode ; ++n) fill[n] = s_nodeElemStart[n] ;
+      for (Index_t c = 0 ; c < 8*numElem ; ++c) {
+         s_nodeElemCorner[fill[nl[c]]++] = c ;
+      }
+      Release(&fill) ;
+      s_cachedNodelist = nl ;
+      s_cachedNumElem  = numElem ;
+      s_cachedNumNode  = numNode ;
+   }
+   *start  = s_nodeElemStart ;
+   *corner = s_nodeElemCorner ;
+}
+
+static void GatherElemForcesToNodes(Domain &domain,
+                                    const Real_t *fx_elem,
+                                    const Real_t *fy_elem,
+                                    const Real_t *fz_elem)
+{
+   const Index_t *start ;
+   const Index_t *corner ;
+   GetNodeElemCorners(domain, &start, &corner) ;
+   Index_t numNode = domain.numNode() ;
+
+#pragma omp parallel for schedule(static) shared(domain, start, corner, fx_elem, fy_elem, fz_elem)
+   for (Index_t gnode = 0 ; gnode < numNode ; ++gnode) {
+      Index_t first = start[gnode] ;
+      Index_t last  = start[gnode+1] ;
+      Real_t fx = domain.fx(gnode) ;
+      Real_t fy = domain.fy(gnode) ;
+      Real_t fz = domain.fz(gnode) ;
+      for (Index_t c = first ; c < last ; ++c) {
+         Index_t ic = corner[c] ;
+         fx += fx_elem[ic] ;
+         fy += fy_elem[ic] ;
+         fz += fz_elem[ic] ;
+      }
+      domain.fx(gnode) = fx ;
+      domain.fy(gnode) = fy ;
+      domain.fz(gnode) = fz ;
+   }
+}
