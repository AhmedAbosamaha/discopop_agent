+         Real_t dtf = domain.ss(k) * domain.ss(k);
+
+         if (domain.vdov(k) < Real_t(0.)) {
+            dtf = dtf
+                + qqc2 * domain.arealg(k) * domain.arealg(k)
+                * domain.vdov(k) * domain.vdov(k);
+         }
+
+         dtf = SQRT(dtf);
+         dtf = domain.arealg(k) / dtf;
+
+         if (dtf < dtcourant_local) {
