+
+    // Copy and clip vnew values
+    for(Index_t i=0 ; i<numElem ; ++i) {
+       vnewc[i] = domain.vnew(i) ;
+    }
+
+    if (eosvmin != Real_t(0.)) {
+       for(Index_t i=0 ; i<numElem ; ++i) {
