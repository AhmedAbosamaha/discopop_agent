+      Real_t B[3][8];
+      Real_t D[6];
+      Real_t x_local[8];
+      Real_t y_local[8];
+      Real_t z_local[8];
+      Real_t xd_local[8];
+      Real_t yd_local[8];
+      Real_t zd_local[8];
+      Real_t detJ = Real_t(0.0);
+
+      Real_t volume;
+      Real_t relativeVolume;
+      const Index_t* const elemToNode = domain.nodelist(k);
+
