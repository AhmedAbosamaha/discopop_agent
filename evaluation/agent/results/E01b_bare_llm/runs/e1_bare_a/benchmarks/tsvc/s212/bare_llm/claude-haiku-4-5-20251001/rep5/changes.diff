@@ -134,10 +134,28 @@
 static real_t kernel_s212(void)
 {
     for (int nl = 0; nl < R; nl++) {
+        /* Phase 1: Compute a[i] *= c[i] for all i in parallel.
+         * Each iteration writes a unique a[i] and reads the same a[i] and c[i].
+         * No inter-iteration dependencies; parallelizable.
+         * Variables: i is private (induction var), a and c are shared arrays.
+         */
+        #pragma omp parallel for
         for (int i = 0; i < LEN_1D-1; i++) {
             a[i] *= c[i];
+        }
+
+        /* Phase 2: Compute b[i] += a[i+1] * d[i] for all i in parallel.
+         * The barrier between phases ensures all a[i] values are updated before
+         * any phase 2 iteration reads a[i+1], eliminating the original loop-carry.
+         * Each iteration writes a unique b[i] and reads a[i+1] (now finalized) and d[i].
+         * No inter-iteration dependencies; parallelizable.
+         * Variables: i is private (induction var), a, b, d are shared arrays.
+         */
+        #pragma omp parallel for
+        for (int i = 0; i < LEN_1D-1; i++) {
             b[i] += a[i + 1] * d[i];
         }
+
         pb_mix(nl);
     }
     return (real_t)0;
