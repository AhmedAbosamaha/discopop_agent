+            temp[i] = a[i+1] + b[i];
         }
+
+        /* Phase 2: Parallel write from temp buffer to array a
+         * Simple parallel copy that cannot have conflicts.
+         */
+        #pragma omp parallel for
+        for (int i = 0; i < LEN_1D-1; i++) {
+            a[i] = temp[i];
+        }
+
         pb_mix(nl);
     }
+
+    free(temp);
