 static real_t kernel_s212(void)
 {
+    // Temporary buffer to save array 'a' and break the loop-carried dependency
+    // The inner loop reads a[i+1] before iteration i+1 writes to it.
+    // Saving 'a' at the start of each outer iteration lets us parallelize.
+    real_t *a_orig = (real_t*)malloc((size_t)LEN_1D * sizeof(real_t));
+
     for (int nl = 0; nl < R; nl++) {
+        // Save current array 'a' to preserve values for the iteration
+        // i: implicitly private loop variable
+        // a_orig: shared, each iteration writes to unique a_orig[i]
+        // a: shared, read-only
+        #pragma omp parallel for
+        for (int i = 0; i < LEN_1D; i++) {
+            a_orig[i] = a[i];
+        }
+
+        // Main computation loop, now parallelizable using saved array values
+        // i: implicitly private loop variable
+        // a: shared, each iteration writes to unique a[i]
+        // c: shared, read-only
+        // a_orig: shared, read-only (snapshot saved above)
+        // b: shared, each iteration writes to unique b[i]
+        // d: shared, read-only
+        #pragma omp parallel for
         for (int i = 0; i < LEN_1D-1; i++) {
             a[i] *= c[i];
-            b[i] += a[i + 1] * d[i];
+            b[i] += a_orig[i + 1] * d[i];
         }
         pb_mix(nl);
     }
+
+    free(a_orig);
     return (real_t)0;
 }
 
