 static real_t kernel_s1213(void)
 {
+    /* Allocate temporary buffer to save old a[] values for use in phase 1.
+     * Phase 1 computes new b[] values using old a[i+1] values (no inter-iteration dependencies).
+     * Phase 2 computes new a[] values using newly computed b[i-1] values.
+     * This two-phase approach preserves the sequential semantics while enabling parallelization.
+     */
+    real_t *a_temp = (real_t*)malloc((size_t)LEN_1D * sizeof(real_t));
+    if (!a_temp) { fprintf(stderr, "out of memory\n"); return (real_t)0; }
+
     for (int nl = 0; nl < R; nl++) {
+        /* Save the old a[] values before computing new values.
+         * These old values are needed in phase 1 to compute b[].
+         * Each thread: reads a[i], writes a_temp[i], no conflicts between iterations.
+         */
+        #pragma omp parallel for
+        for (int i = 0; i < LEN_1D; i++) {
+            a_temp[i] = a[i];
+        }
+
+        /* Phase 1: Compute new b[] values in parallel.
+         * Each iteration i: reads a_temp[i+1] (old a value), d[i]; writes b[i].
+         * No iteration-to-iteration dependencies (different i use different indices).
+         * Parallel iterations: b[1], b[2], ..., b[LEN_1D-2] computed concurrently.
+         */
+        #pragma omp parallel for
+        for (int i = 1; i < LEN_1D-1; i++) {
+            b[i] = a_temp[i+1]*d[i];
+        }
+
+        /* Phase 2: Compute new a[] values in parallel.
+         * Each iteration i: reads b[i-1] (just updated in phase 1), c[i]; writes a[i].
+         * No inter-iteration dependencies (each i writes different a[i]).
+         * After phase 1 barrier, all b[1..LEN_1D-2] are finalized, so b[i-1] is ready for all i.
+         * Parallel iterations: a[1], a[2], ..., a[LEN_1D-2] computed concurrently.
+         */
+        #pragma omp parallel for
         for (int i = 1; i < LEN_1D-1; i++) {
             a[i] = b[i-1]+c[i];
-            b[i] = a[i+1]*d[i];
         }
+
         pb_mix(nl);
     }
+
+    free(a_temp);
     return (real_t)0;
 }
 
