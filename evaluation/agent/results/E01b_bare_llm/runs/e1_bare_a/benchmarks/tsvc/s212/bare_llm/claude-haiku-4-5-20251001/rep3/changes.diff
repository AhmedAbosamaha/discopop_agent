 static real_t kernel_s212(void)
 {
+    // Allocate temporary buffer to hold original a values.
+    // This breaks the loop-carried dependence: iteration i reads a[i+1],
+    // but iteration i+1 writes to a[i+1]. By storing original values in temp_a,
+    // each iteration reads the original a[i+1] (read-only), allowing parallelization.
+    real_t *temp_a = (real_t*)malloc((size_t)LEN_1D * sizeof(real_t));
+
     for (int nl = 0; nl < R; nl++) {
+        // Copy a to temp_a before the iteration.
+        // temp_a[i]: write-only (each thread writes to different index)
+        // a[i]: read-only (each thread reads from different index)
+        #pragma omp parallel for schedule(static)
+        for (int i = 0; i < LEN_1D; i++) {
+            temp_a[i] = a[i];
+        }
+
+        // Main computation loop: now parallelizable
+        // Each iteration i independently:
+        //   - reads c[i], d[i]: read-only shared across all threads
+        //   - reads temp_a[i+1]: read-only shared (no conflicts)
+        //   - writes a[i]: each thread writes to different index (no conflicts)
+        //   - writes b[i]: each thread writes to different index (no conflicts)
+        #pragma omp parallel for schedule(static)
         for (int i = 0; i < LEN_1D-1; i++) {
             a[i] *= c[i];
-            b[i] += a[i + 1] * d[i];
+            b[i] += temp_a[i + 1] * d[i];
         }
+
         pb_mix(nl);
     }
+
+    free(temp_a);
     return (real_t)0;
 }
 
