--- original.c
+++ final.c
@@ -133,14 +133,50 @@
 
 static real_t kernel_s243(void)
 {
+    real_t *a_orig = (real_t*)malloc((size_t)LEN_1D * sizeof(real_t));
+
+    if (!a_orig) {
+        /* Fallback to original sequential code if malloc fails */
+        for (int nl = 0; nl < R; nl++) {
+            for (int i = 0; i < LEN_1D-1; i++) {
+                a[i] = b[i] + c[i  ] * d[i];
+                b[i] = a[i] + d[i  ] * e[i];
+                a[i] = b[i] + a[i+1] * d[i];
+            }
+            pb_mix(nl);
+        }
+        return (real_t)0;
+    }
+
+    /* Parallelized version using node splitting to break false dependence cycle */
     for (int nl = 0; nl < R; nl++) {
+        /* Save the original a array at the start of this nl iteration.
+         * In the original sequential code, statement (3) reads a[i+1] which is the
+         * pre-loop value since we process i in order and haven't modified a[i+1] yet. */
+        memcpy(a_orig, a, (size_t)LEN_1D * sizeof(real_t));
+
+        /* First pass: compute a[i] and b[i] from input arrays.
+         * No cross-iteration dependencies: iteration i only reads b[i], c[i], d[i], e[i]
+         * and writes a[i], b[i]. Can be fully parallelized. */
+        #pragma omp parallel for
         for (int i = 0; i < LEN_1D-1; i++) {
             a[i] = b[i] + c[i  ] * d[i];
             b[i] = a[i] + d[i  ] * e[i];
-            a[i] = b[i] + a[i+1] * d[i];
         }
+
+        /* Second pass: compute final a[i] using the updated b[i] and original a[i+1].
+         * No cross-iteration dependencies: iteration i only reads b[i] (just computed),
+         * a_orig[i+1] (saved from before pass 1), and d[i]; writes only a[i].
+         * Can be fully parallelized. */
+        #pragma omp parallel for
+        for (int i = 0; i < LEN_1D-1; i++) {
+            a[i] = b[i] + a_orig[i+1] * d[i];
+        }
+
         pb_mix(nl);
     }
+
+    free(a_orig);
     return (real_t)0;
 }
 
