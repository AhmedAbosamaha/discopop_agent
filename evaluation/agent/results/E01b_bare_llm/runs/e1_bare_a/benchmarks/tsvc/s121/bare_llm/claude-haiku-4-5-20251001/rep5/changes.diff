 static real_t kernel_s121(void)
 {
+    /* Allocate snapshot buffer to break loop-carried dependence.
+     * This allows parallelization of the inner loop. */
+    real_t *a_old = (real_t*)malloc((size_t)LEN_1D * sizeof(real_t));
+    if (!a_old) { fprintf(stderr, "out of memory\n"); return (real_t)0; }
+
     int j;
     for (int nl = 0; nl < R; nl++) {
+        /* Copy current a values to snapshot. Each thread copies a[i] to a_old[i].
+         * Variables: i is private (loop var). a_old[i] and a[i] are accessed with
+         * no dependencies between iterations. */
+        #pragma omp parallel for
+        for (int i = 0; i < LEN_1D; i++) {
+            a_old[i] = a[i];
+        }
+
+        /* Parallelize inner loop using snapshot to avoid loop-carried dependence.
+         * Iteration i reads from a_old[i+1] (snapshot, not being modified) and b[i],
+         * then writes to a[i]. No iteration depends on another's writes since each
+         * writes to a unique location. Variables: i is private (loop var).
+         * a[i] is written per-iteration (no dependence). a_old[i+1] is read-only.
+         * b[i] is read-only. */
+        #pragma omp parallel for
         for (int i = 0; i < LEN_1D-1; i++) {
-            j = i + 1;
-            a[i] = a[j] + b[i];
+            a[i] = a_old[i+1] + b[i];
         }
         pb_mix(nl);
     }
+
+    free(a_old);
     return (real_t)0;
 }
 
