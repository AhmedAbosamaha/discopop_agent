+            a[i] = b[i] * c[i] * d[i];
         }
+
+        // Compute new b values: uses newly computed a[i] and old (saved) a[i+1] — fully parallelizable
+        #pragma omp parallel for
+        for (int i = 0; i < LEN_1D-1; i++) {
+            b[i] = a[i] * a_old[i+1] * d[i];
+        }
+
         pb_mix(nl);
