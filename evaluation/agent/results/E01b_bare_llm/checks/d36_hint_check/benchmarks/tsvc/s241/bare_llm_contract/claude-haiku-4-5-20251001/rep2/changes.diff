 static real_t kernel_s241(void)
 {
+    real_t *a_old = (real_t*)malloc((size_t)LEN_1D * sizeof(real_t));
+    if (!a_old) { fprintf(stderr, "out of memory\n"); return (real_t)0; }
+
     for (int nl = 0; nl < R; nl++) {
+        // Save old a values before computing new ones (preserves a[i+1] read semantics)
+        #pragma omp parallel for
+        for (int i = 0; i < LEN_1D; i++) {
+            a_old[i] = a[i];
+        }
+
+        // Compute new a values: each iteration only reads b, c, d — fully parallelizable
+        #pragma omp parallel for
         for (int i = 0; i < LEN_1D-1; i++) {
-            a[i] = b[i] * c[i  ] * d[i];
