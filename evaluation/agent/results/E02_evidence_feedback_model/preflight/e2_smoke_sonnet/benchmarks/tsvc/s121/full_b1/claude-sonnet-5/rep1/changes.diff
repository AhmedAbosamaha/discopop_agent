 static real_t kernel_s121(void)
 {
     int j;
+    real_t *a_old = (real_t*)malloc((size_t)LEN_1D * sizeof(real_t));
     for (int nl = 0; nl < R; nl++) {
+        /* Snapshot the pre-sweep state of a[]: every read in this sweep
+         * (a[i+1]) always observes the value a[] had before the sweep
+         * began (writes only ever touch indices < i by the time
+         * iteration i runs), so reading from this snapshot instead of
+         * from a[] directly reproduces the same result while making
+         * each iteration independent (disjoint writes, no reads of
+         * values produced earlier in the same sweep). */
+        #pragma omp parallel for shared(a_old) 
+        for (int k = 0; k < LEN_1D; k++) {
+            a_old[k] = a[k];
+        }
+        #pragma omp parallel for private(j) shared(a_old) 
         for (int i = 0; i < LEN_1D-1; i++) {
             j = i + 1;
-            a[i] = a[j] + b[i];
+            a[i] = a_old[j] + b[i];
         }
         pb_mix(nl);
     }
+    free(a_old);
     return (real_t)0;
 }
 
