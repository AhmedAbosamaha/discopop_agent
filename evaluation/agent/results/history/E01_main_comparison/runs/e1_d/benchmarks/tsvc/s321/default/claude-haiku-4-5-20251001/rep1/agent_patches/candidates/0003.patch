--- s321.c
+++ s321.c
@@ -133,12 +133,38 @@
 
 static real_t kernel_s321(void)
 {
+    /* Restructured to expose a parallelizable pattern.
+     * The loop-carried recurrence a[i] += a[i-1] * b[i] is expanded into
+     * independent updates by precomputing cumulative products of b
+     * and cumulative sums of weighted prior values. The final update pass
+     * has no loop-carried dependence and can be parallelized. */
+    real_t *p = (real_t*)malloc(LEN_1D * sizeof(real_t));
+    real_t *s = (real_t*)malloc(LEN_1D * sizeof(real_t));
+    if (!p || !s) return (real_t)0;
+
     for (int nl = 0; nl < R; nl++) {
+        /* Pass 1: Cumulative product p[i] = b[1] * b[2] * ... * b[i] */
+        p[0] = (real_t)1.0;
         for (int i = 1; i < LEN_1D; i++) {
-            a[i] += a[i-1] * b[i];
+            p[i] = p[i-1] * b[i];
         }
+
+        /* Pass 2: Cumulative weighted sum s[i] = sum_{k=0}^{i-1} (a[k] / p[k]) */
+        s[0] = (real_t)0.0;
+        for (int i = 1; i < LEN_1D; i++) {
+            s[i] = s[i-1] + a[i-1] / p[i-1];
+        }
+
+        /* Pass 3: Update a[i] independently — no loop-carried dependence */
+        for (int i = 1; i < LEN_1D; i++) {
+            a[i] = a[i] + p[i] * s[i];
+        }
+
         pb_mix(nl);
     }
+
+    free(p);
+    free(s);
     return (real_t)0;
 }
 