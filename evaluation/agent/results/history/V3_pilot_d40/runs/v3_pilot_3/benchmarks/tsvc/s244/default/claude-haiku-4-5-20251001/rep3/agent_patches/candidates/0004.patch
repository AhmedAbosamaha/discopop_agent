 static real_t kernel_s244(void)
 {
+    real_t *a_init = (real_t *)malloc(LEN_1D * sizeof(real_t));
+
     for (int nl = 0; nl < R; nl++) {
+        /* Save initial values of a to break loop-carried dependence */
+        for (int i = 0; i < LEN_1D; ++i) {
+            a_init[i] = a[i];
+        }
+
+        /* Compute using saved initial a[i+1] values, removing RAW dependence */
         for (int i = 0; i < LEN_1D-1; ++i) {
             a[i] = b[i] + c[i] * d[i];
             b[i] = c[i] + b[i];
-            a[i+1] = b[i] + a[i+1] * d[i];
+            a[i+1] = b[i] + a_init[i+1] * d[i];
         }
+
         pb_mix(nl);
     }
+
+    free(a_init);
     return (real_t)0;
 }
 