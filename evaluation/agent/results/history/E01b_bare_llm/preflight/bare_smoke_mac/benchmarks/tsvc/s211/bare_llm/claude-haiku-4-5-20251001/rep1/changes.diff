 static real_t kernel_s211(void)
 {
+    /* Allocate temporary buffer for b computation to break anti-dependence */
+    real_t *b_new = (real_t*)malloc((size_t)LEN_1D * sizeof(real_t));
+    if (!b_new) { fprintf(stderr, "out of memory for b_new\n"); return (real_t)0; }
+
     for (int nl = 0; nl < R; nl++) {
+        /* First loop (reordered): compute b[i] = b[i+1] - e[i]*d[i] using temporary buffer
+         * This loop is parallelizable because we read from b[i+1] (not modified in this loop)
+         * and write to b_new[i] (no conflicts). Anti-dependence is broken by using b_new. */
+        #pragma omp parallel for
+        for (int i = 1; i < LEN_1D-1; i++) {
+            b_new[i] = b[i + 1] - e[i] * d[i];
+        }
+        /* Copy computed b values back to b array */
+        #pragma omp parallel for
+        for (int i = 1; i < LEN_1D-1; i++) {
+            b[i] = b_new[i];
+        }
+
+        /* Second loop (reordered): compute a[i] = b[i-1] + c[i]*d[i]
+         * This loop is fully parallelizable: each iteration writes to a[i] and reads from
+         * b[i-1], c[i], d[i] with no loop-carried dependence (each i writes different a[i]). */
+        #pragma omp parallel for
         for (int i = 1; i < LEN_1D-1; i++) {
             a[i] = b[i - 1] + c[i] * d[i];
-            b[i] = b[i + 1] - e[i] * d[i];
         }
+
         pb_mix(nl);
     }
+    free(b_new);
     return (real_t)0;
 }
 
