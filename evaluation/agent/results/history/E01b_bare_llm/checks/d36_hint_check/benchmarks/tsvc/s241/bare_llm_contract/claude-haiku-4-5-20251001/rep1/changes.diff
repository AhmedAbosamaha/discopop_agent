 static real_t kernel_s241(void)
 {
+    /* Allocate temporary buffers for parallelization.
+     * a_new[i]: new value of a[i] = b[i] * c[i] * d[i]
+     * b_new[i]: new value of b[i] = a_new[i] * a[i+1] * d[i]
+     * Using temporary arrays decouples the read-write pattern:
+     * - all parallel iterations read from the original (unchanged) a, b
+     * - each iteration writes independently to a_new[i], b_new[i]
+     * - after the loop, we copy results back, preserving original semantics
+     */
+    real_t *a_new = (real_t*)malloc(LEN_1D * sizeof(real_t));
+    real_t *b_new = (real_t*)malloc(LEN_1D * sizeof(real_t));
+
+    if (!a_new || !b_new) {
+        fprintf(stderr, "out of memory\n");
+        free(a_new);
+        free(b_new);
+        return (real_t)0;
+    }
+
     for (int nl = 0; nl < R; nl++) {
+        /* Parallel loop: each iteration i is independent.
+         * Iteration i writes to a_new[i] and b_new[i].
+         * Iteration i reads from b[i], c[i], d[i] (shared, all read same indices),
+         * and a[i+1] (shared input, each iteration reads different index).
+         * No data races: each iteration writes to different array elements.
+         */
+        #pragma omp parallel for
         for (int i = 0; i < LEN_1D-1; i++) {
-            a[i] = b[i] * c[i  ] * d[i];
-            b[i] = a[i] * a[i+1] * d[i];
+            a_new[i] = b[i] * c[i] * d[i];
+            b_new[i] = a_new[i] * a[i+1] * d[i];
         }
+
+        /* Copy results back to global arrays a and b.
+         * We copy LEN_1D-1 elements (indices 0 to LEN_1D-2) since those are
+         * the only indices written in the loop.
+         */
+        memcpy(a, a_new, (LEN_1D-1) * sizeof(real_t));
+        memcpy(b, b_new, (LEN_1D-1) * sizeof(real_t));
         pb_mix(nl);
     }
+
+    free(a_new);
+    free(b_new);
     return (real_t)0;
 }
 
