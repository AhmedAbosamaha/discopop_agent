+        /* Compute new a values in temporary buffer and update b in parallel.
+         * a_new[i] writes a[i] based on original b[i], c[i], d[i].
+         * b[i] writes b[i] using newly computed a_new[i] and original a[i+1].
+         * All reads of a[i+1] see the original value (pre-parallelized-loop).
+         * No cross-iteration dependencies: each i computes independently. */
+        #pragma omp parallel for
