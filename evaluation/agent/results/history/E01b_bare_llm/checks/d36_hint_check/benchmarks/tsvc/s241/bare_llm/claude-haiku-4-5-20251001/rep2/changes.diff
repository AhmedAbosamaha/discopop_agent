 typedef double real_t;
 
@@ -130,13 +131,29 @@
 
 static real_t kernel_s241(void)
 {
+    /* Allocate a temporary array to hold the previous state of 'a'.
+     * This breaks the loop-carried dependence: iteration i reads a[i+1],
+     * which would be written in iteration i+1. By reading from a saved
+     * copy, we allow parallel execution while preserving exact output. */
+    real_t *a_prev = (real_t*)malloc((size_t)LEN_1D * sizeof(real_t));
+    if (!a_prev) return (real_t)0;
+
     for (int nl = 0; nl < R; nl++) {
+        /* Save the current state of 'a' at the start of each outer iteration */
+        memcpy(a_prev, a, (size_t)LEN_1D * sizeof(real_t));
+
+        /* Parallelize the inner loop: each iteration is now independent
+         * since it reads from a_prev (read-only) instead of a[i+1]. */
+        #pragma omp parallel for
         for (int i = 0; i < LEN_1D-1; i++) {
             a[i] = b[i] * c[i  ] * d[i];
-            b[i] = a[i] * a[i+1] * d[i];
+            b[i] = a[i] * a_prev[i+1] * d[i];
         }
+
         pb_mix(nl);
     }
+
+    free(a_prev);
     return (real_t)0;
 }
 
