 static real_t kernel_s243(void)
 {
+    /* Allocate backup buffer for array 'a' to eliminate loop-carry dependency.
+     * The key issue: statement 3 reads a[i+1], which is written by statement 1 of
+     * iteration i+1, creating a loop-carry dependence. We solve this by backing up
+     * the 'a' array at the START of each nl repetition and having statement 3 read
+     * from the backup. This preserves semantics (each iteration reads the value of
+     * a[i+1] as it existed at the start of the current nl iteration, which is what
+     * the sequential version did) while eliminating the loop-carry dependence. */
+    real_t *a_backup = (real_t*)malloc((size_t)LEN_1D * sizeof(real_t));
+    if (!a_backup) return (real_t)0;
+
     for (int nl = 0; nl < R; nl++) {
+        /* Back up 'a' at the start of each repetition so that all iterations of the
+         * inner loop read a consistent snapshot. This matches sequential semantics:
+         * when iteration i reads a[i+1], it reads the value from before iteration i+1
+         * has modified it. */
+        memcpy(a_backup, a, (size_t)LEN_1D * sizeof(real_t));
+
+        /* Parallel inner loop: each iteration i works on independent array locations.
+         * - a[i]: shared, written to by this iteration only (no race)
+         * - b[i]: shared, written to by this iteration only (no race)
+         * - c[i], d[i], e[i]: shared, read-only
+         * - a_backup[i+1]: shared, read-only (backup is fixed for this nl iteration)
+         * No loop-carry dependencies, so full parallelization is safe. */
+        #pragma omp parallel for
         for (int i = 0; i < LEN_1D-1; i++) {
             a[i] = b[i] + c[i  ] * d[i];
             b[i] = a[i] + d[i  ] * e[i];
-            a[i] = b[i] + a[i+1] * d[i];
+            a[i] = b[i] + a_backup[i+1] * d[i];  /* Read from backup, not from a[i+1] */
         }
         pb_mix(nl);
     }
+
+    free(a_backup);
     return (real_t)0;
 }
 
