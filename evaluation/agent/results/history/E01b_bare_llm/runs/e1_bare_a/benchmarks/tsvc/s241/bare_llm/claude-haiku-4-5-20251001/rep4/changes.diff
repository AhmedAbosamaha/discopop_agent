 static real_t kernel_s241(void)
 {
+    /* Allocate temporary buffer for preloaded a[i+1] values to avoid
+     * race conditions when reading a[i+1] across parallel iterations */
+    real_t *a_next = (real_t*)malloc((size_t)LEN_1D * sizeof(real_t));
+    if (!a_next) return (real_t)0;
+
     for (int nl = 0; nl < R; nl++) {
+        /* Preload a[i+1] values into a_next[i] to ensure all threads
+         * see consistent old values. This eliminates the race condition
+         * where thread i reads a[i+1] while thread i+1 writes to it. */
+        #pragma omp parallel for
+        for (int i = 0; i < LEN_1D-1; i++) {
+            a_next[i] = a[i+1];
+        }
+
+        /* Parallel computation loop: each thread i independently
+         * writes to a[i] and b[i], and reads preloaded a_next[i].
+         * Variables: a, b, c, d are shared (read-only c,d); a_next is
+         * shared read-only; i is private (loop variable). */
+        #pragma omp parallel for
         for (int i = 0; i < LEN_1D-1; i++) {
             a[i] = b[i] * c[i  ] * d[i];
-            b[i] = a[i] * a[i+1] * d[i];
+            b[i] = a[i] * a_next[i] * d[i];
         }
         pb_mix(nl);
     }
+
+    free(a_next);
     return (real_t)0;
 }
 
