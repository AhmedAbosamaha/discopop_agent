 static real_t kernel_s212(void)
 {
+    /* Allocate temporary buffer to hold snapshot of array a.
+     * This eliminates loop-carried dependence by making all reads come from
+     * the same unchanging snapshot, allowing the inner loop to parallelize. */
+    real_t* a_temp = malloc((size_t)LEN_1D * sizeof(real_t));
+    if (!a_temp) return (real_t)0;
+
     for (int nl = 0; nl < R; nl++) {
+        /* Copy current a to a_temp. Each iteration i accesses unique a_temp[i],
+         * so this loop is data-race-free and parallelizable. */
+        #pragma omp parallel for
+        for (int i = 0; i < LEN_1D; i++) {
+            a_temp[i] = a[i];
+        }
+
+        /* Main computation loop. Original dependence: iteration i reads a[i+1],
+         * iteration i+1 writes a[i+1]. Transformed dependence: iteration i reads
+         * a_temp[i+1] (immutable snapshot) and writes to a[i] and b[i].
+         * Each iteration accesses unique indices, so loop is parallelizable.
+         * Variables:
+         *   - a[i]: written (unique index per iteration)
+         *   - b[i]: written (unique index per iteration)
+         *   - c[i]: read-only, unique index per iteration
+         *   - d[i]: read-only, unique index per iteration
+         *   - a_temp[i+1]: read-only, unique index per iteration
+         */
+        #pragma omp parallel for
         for (int i = 0; i < LEN_1D-1; i++) {
             a[i] *= c[i];
-            b[i] += a[i + 1] * d[i];
+            b[i] += a_temp[i + 1] * d[i];
         }
+
         pb_mix(nl);
     }
+
+    free(a_temp);
     return (real_t)0;
 }
 
