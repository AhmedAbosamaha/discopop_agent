@@ -133,12 +133,34 @@
 
 static real_t kernel_s112(void)
 {
+    /* Allocate temporary buffer to break anti-dependence in the inner loop.
+     * This allows us to parallelize the computation by ensuring all iterations
+     * read from the original array before any writes. */
+    real_t *new_a = (real_t*)malloc((size_t)LEN_1D * sizeof(real_t));
+    if (!new_a) { fprintf(stderr, "out of memory\n"); return (real_t)0; }
+
     for (int nl = 0; nl < R; nl++) {
-        for (int i = LEN_1D - 2; i >= 0; i--) {
-            a[i+1] = a[i] + b[i];
+        /* new_a[0] remains unchanged; only indices 1 to LEN_1D-1 are updated.
+         * This matches the original loop which updates a[1] through a[LEN_1D-1]. */
+        new_a[0] = a[0];
+
+        /* Parallel computation: for each index i from 1 to LEN_1D-1, compute
+         * new_a[i] = a[i-1] + b[i-1]. This is equivalent to the backward loop
+         * (for i from LEN_1D-2 down to 0: a[i+1] = a[i] + b[i]) but avoids
+         * the anti-dependence by reading all values before writing any.
+         * Variable i is automatically private in OpenMP parallel for. */
+        #pragma omp parallel for
+        for (int i = 1; i < LEN_1D; i++) {
+            new_a[i] = a[i-1] + b[i-1];
         }
+
+        /* Copy computed values back to the main array using memcpy for efficiency.
+         * This ensures the next pb_mix call sees the updated array state. */
+        memcpy(a, new_a, (size_t)LEN_1D * sizeof(real_t));
+
         pb_mix(nl);
     }
+    free(new_a);
     return (real_t)0;
 }
 
