 static real_t kernel_s243(void)
 {
+    /* Allocate buffer to save original a[] values before each nl iteration.
+     * This breaks the loop-carried dependence where iteration i reads a[i+1]
+     * before iteration i+1 has a chance to write it.
+     */
+    real_t *a_saved = (real_t*)malloc((size_t)LEN_1D * sizeof(real_t));
+    if (!a_saved) return (real_t)0;
+
     for (int nl = 0; nl < R; nl++) {
+        /* Save the current values of a[] to a_saved[] before modifying them.
+         * a_saved[i] holds the value of a[i] at the start of this nl iteration.
+         * This enables all iterations of the main loop to run in parallel.
+         */
+        #pragma omp parallel for
+        for (int i = 0; i < LEN_1D; i++) {
+            a_saved[i] = a[i];
+        }
+
+        /* Main loop: compute new values using saved a[] values.
+         * - a_temp: local temporary storing the first computed a[i] value
+         * - Statement 1: compute new a[i] from b[i], c[i], d[i]
+         * - Statement 2: compute new b[i] from the new a[i] (true dependence within iteration)
+         * - Statement 3: compute final a[i] from new b[i] and a_saved[i+1]
+         *   (uses saved value, not the updated one, preserving original semantics)
+         * All iterations are independent and can run in parallel.
+         */
+        #pragma omp parallel for
         for (int i = 0; i < LEN_1D-1; i++) {
-            a[i] = b[i] + c[i  ] * d[i];
-            b[i] = a[i] + d[i  ] * e[i];
-            a[i] = b[i] + a[i+1] * d[i];
+            real_t a_temp = b[i] + c[i] * d[i];
+            b[i] = a_temp + d[i] * e[i];
+            a[i] = b[i] + a_saved[i+1] * d[i];
         }
+
         pb_mix(nl);
     }
+
+    free(a_saved);
     return (real_t)0;
 }
 
