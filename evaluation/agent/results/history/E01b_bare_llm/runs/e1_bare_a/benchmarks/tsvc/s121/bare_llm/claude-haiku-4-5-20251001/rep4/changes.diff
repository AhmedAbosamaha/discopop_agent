+        /* Parallel inner loop: each iteration i computes a[i] from the snapshot.
+         * - a_copy is shared (read-only snapshot of original a)
+         * - b is shared (read-only throughout)
+         * - a is shared but each iteration writes to a unique index a[i]
+         * - j is private to each iteration (computed as i+1) */
+        #pragma omp parallel for private(j)
         for (int i = 0; i < LEN_1D-1; i++) {
             j = i + 1;
-            a[i] = a[j] + b[i];
+            a[i] = a_copy[j] + b[i];
         }
+
+        free(a_copy);
         pb_mix(nl);
     }
     return (real_t)0;
