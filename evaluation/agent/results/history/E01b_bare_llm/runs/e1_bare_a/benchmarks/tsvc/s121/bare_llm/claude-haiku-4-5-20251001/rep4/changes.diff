+        /* Create a snapshot copy of array a to avoid loop-carried write-after-read
+         * dependences when parallelizing the inner loop. All iterations will read
+         * from this invariant copy and write to disjoint elements of the original array. */
+        real_t *a_copy = (real_t*)malloc((size_t)(LEN_1D) * sizeof(real_t));
+        memcpy(a_copy, a, (size_t)(LEN_1D) * sizeof(real_t));
