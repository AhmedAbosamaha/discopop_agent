--- original.c
+++ final.c
@@ -133,13 +133,55 @@
 
 static real_t kernel_s241(void)
 {
+    /* Allocate buffer to preload old a values for phase 2 of the loop.
+     * This enables parallelization by node-splitting: instead of computing
+     * a[i] and b[i] sequentially in one loop (which has a[i+1] dependency),
+     * we split into two phases that can be parallelized independently.
+     */
+    real_t *a_old = (real_t*)malloc((size_t)LEN_1D * sizeof(real_t));
+    if (!a_old) {
+        fprintf(stderr, "malloc failed for a_old\n");
+        return (real_t)0;
+    }
+
     for (int nl = 0; nl < R; nl++) {
+        /* Preload: save the current a values before we compute new ones.
+         * In the original code, b[i] = a[i] * a[i+1] * d[i] uses a[i+1] from
+         * before the current iteration began (not the newly computed value).
+         * We preserve this by reading a[i+1] from the preloaded a_old buffer.
+         */
+        memcpy(a_old, a, (size_t)LEN_1D * sizeof(real_t));
+
+        /* Phase 1: Compute all a[i] values in parallel.
+         * No loop-carried dependencies: each iteration only writes to a[i]
+         * and reads from b[i], c[i], d[i] (which are not modified).
+         * i: loop variable (implicitly private)
+         * a, b, c, d: shared arrays (written to a, read from b/c/d)
+         */
+        #pragma omp parallel for
         for (int i = 0; i < LEN_1D-1; i++) {
-            a[i] = b[i] * c[i  ] * d[i];
-            b[i] = a[i] * a[i+1] * d[i];
+            a[i] = b[i] * c[i] * d[i];
         }
+
+        /* Phase 2: Compute all b[i] values in parallel using preloaded a_old.
+         * No loop-carried dependencies: each iteration reads a[i] and a_old[i+1]
+         * (both already fully computed in phase 1 and before this nl iteration)
+         * and writes to b[i].
+         * i: loop variable (implicitly private)
+         * a, a_old, d, b: shared arrays (read from a/a_old/d, write to b)
+         */
+        #pragma omp parallel for
+        for (int i = 0; i < LEN_1D-1; i++) {
+            b[i] = a[i] * a_old[i+1] * d[i];
+        }
+
+        /* pb_mix must execute serially between outer loop iterations
+         * because it modifies the input arrays for the next iteration.
+         */
         pb_mix(nl);
     }
+
+    free(a_old);
     return (real_t)0;
 }
 
