--- s1213.c
+++ s1213.c
@@ -15,13 +15,37 @@
 
 static real_t kernel_s1213(void)
 {
+    /* Allocate buffer to hold old a values before they are overwritten,
+     * allowing two independent passes instead of one loop with carried
+     * dependencies. Each pass becomes Do-All parallelizable. */
+    real_t *a_old = malloc(LEN_1D * sizeof(real_t));
+
     for (int nl = 0; nl < R; nl++) {
+        /* Save current a values before overwriting them. */
+        for (int i = 0; i < LEN_1D; i++) {
+            a_old[i] = a[i];
+        }
+
+        /* Pass 1: Compute new a values from current b values.
+         * Each iteration accesses different b and c indices and writes
+         * to a different a index — no loop-carried dependence. */
         for (int i = 1; i < LEN_1D-1; i++) {
             a[i] = b[i-1]+c[i];
-            b[i] = a[i+1]*d[i];
         }
+
+        /* Pass 2: Compute new b values from old a values.
+         * Each iteration accesses different a_old and d indices and writes
+         * to a different b index — no loop-carried dependence. Uses saved
+         * a_old[i+1] so b[i] reads a from before this outer loop iteration,
+         * preserving the original algorithm's dependence structure. */
+        for (int i = 1; i < LEN_1D-1; i++) {
+            b[i] = a_old[i+1]*d[i];
+        }
+
         pb_mix(nl);
     }
+
+    free(a_old);
     return (real_t)0;
 }
 