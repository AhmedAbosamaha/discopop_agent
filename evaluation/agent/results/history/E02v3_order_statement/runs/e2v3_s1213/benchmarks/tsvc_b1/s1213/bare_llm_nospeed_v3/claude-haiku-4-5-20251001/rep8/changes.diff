+        memcpy(b_init, b, LEN_1D * sizeof(real_t));
+
+        #pragma omp parallel for schedule(static) shared(a, b, c, d, a_init, b_init)
         for (int i = 1; i < LEN_1D-1; i++) {
-            a[i] = b[i-1]+c[i];
-            b[i] = a[i+1]*d[i];
+            a[i] = b_init[i-1]+c[i];
+            b[i] = a_init[i+1]*d[i];
         }
+
+        free(a_init);
+        free(b_init);
         pb_mix(nl);
     }
     return (real_t)0;
