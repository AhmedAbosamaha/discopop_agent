 static real_t kernel_s1213(void)
 {
     for (int nl = 0; nl < R; nl++) {
+        /* Make copies of initial a[] and b[] to break loop-carried dependencies.
+         * Iteration i reads from a_init[i+1] and b_init[i-1] (initial values, no loop-carried dep).
