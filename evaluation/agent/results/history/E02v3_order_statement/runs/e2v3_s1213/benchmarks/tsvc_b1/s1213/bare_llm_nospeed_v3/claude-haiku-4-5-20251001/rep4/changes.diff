+
+        // Phase 2: Compute all a values in parallel using newly computed b values.
+        // No loop-carried dependence: each iteration writes a[i], no iteration reads a.
+        // b, c are read-only; a is written.
+        // Implicit barrier between phases ensures phase 1 completes before phase 2 reads b.
+        #pragma omp parallel for shared(b, a, c)
         for (int i = 1; i < LEN_1D-1; i++) {
             a[i] = b[i-1]+c[i];
-            b[i] = a[i+1]*d[i];
