 static real_t kernel_s1213(void)
 {
     for (int nl = 0; nl < R; nl++) {
+        // Phase 1: Compute all b values in parallel using current (old) a values.
+        // No loop-carried dependence: each iteration writes b[i], no iteration reads b.
+        // a, d are read-only; b is written.
+        #pragma omp parallel for shared(a, b, d)
+        for (int i = 1; i < LEN_1D-1; i++) {
+            b[i] = a[i+1]*d[i];
