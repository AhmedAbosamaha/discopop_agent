@@ -14,13 +15,39 @@
 
 static real_t kernel_k19(void)
 {
+    /* u[ju[i]] and v[jv[i]] are only ever touched by the single loop
+     * iteration that owns that index, so the true value flow is:
+     *   - the read v[kv[i]] in the first statement always sees the value
+     *     v held at the start of this repetition's loop (no earlier
+     *     iteration of this same loop ever writes that location before
+     *     it is read), and
+     *   - the read u[ku[i]] in the second statement sees the value u
+     *     held at the start of the loop, plus this same iteration's own
+     *     update if (and only if) ku[i] == ju[i].
+     * Snapshotting u and v before the loop turns both statements into
+     * pure gather/scatter using the snapshot for reads and the live
+     * arrays only for (disjoint, per-iteration) writes, which removes
+     * the in-place read/write aliasing that blocked parallelization
+     * while reproducing the exact original values.
+     */
+    real_t *u_old = (real_t *)malloc(sizeof(real_t) * (size_t)LEN_1D);
+    real_t *v_old = (real_t *)malloc(sizeof(real_t) * (size_t)LEN_1D);
     for (int nl = 0; nl < R; nl++) {
+        for (long i = 0; i < LEN_1D; i++) {
+            u_old[i] = u[i];
+            v_old[i] = v[i];
+        }
         for (long i = 1; i < LEN_1D; i++) {
-            u[ju[i]] += v[kv[i]] * c[i];
-            v[jv[i]] = u[ku[i]] * d[i] + c[i];
+            real_t du = v_old[kv[i]] * c[i];
+            real_t u_new = u_old[ju[i]] + du;
+            u[ju[i]] = u_new;
+            real_t u_read = (ku[i] == ju[i]) ? u_new : u_old[ku[i]];
+            v[jv[i]] = u_read * d[i] + c[i];
         }
         pb_mix(nl);
     }
+    free(u_old);
+    free(v_old);
     return (real_t)0;
 }
 