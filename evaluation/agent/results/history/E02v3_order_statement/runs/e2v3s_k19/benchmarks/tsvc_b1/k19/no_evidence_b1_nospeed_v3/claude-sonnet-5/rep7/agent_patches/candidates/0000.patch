+/* One repetition's worth of work for a single index i, extracted so each
+ * iteration's actual (data-dependent) u/v cells can be tracked as a
+ * separate unit of work instead of only being resolvable by staying in
+ * strict program order. */
+static void k19_step(long i)
+{
+    u[ju[i]] += v[kv[i]] * c[i];
+    v[jv[i]] = u[ku[i]] * d[i] + c[i];
+}
