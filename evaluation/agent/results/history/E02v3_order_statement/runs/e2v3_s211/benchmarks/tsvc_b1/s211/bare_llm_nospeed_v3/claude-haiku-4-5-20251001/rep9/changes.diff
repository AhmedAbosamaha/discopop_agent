 static real_t kernel_s211(void)
 {
+    real_t *b_new = (real_t *)malloc((LEN_1D) * sizeof(real_t));
+
     for (int nl = 0; nl < R; nl++) {
+        // Phase 1: Parallel computation of new b values
+        // Each iteration i reads b[i+1] (unchanged in this loop) and writes b_new[i].
+        // No loop-carried dependence.
+        #pragma omp parallel for shared(b, b_new, d, e) schedule(static)
+        for (int i = 1; i < LEN_1D-1; i++) {
+            b_new[i] = b[i + 1] - e[i] * d[i];
+        }
+
+        // Copy new b values back (sequential barrier).
+        for (int i = 1; i < LEN_1D-1; i++) {
+            b[i] = b_new[i];
+        }
+
+        // Phase 2: Parallel computation of a values
+        // Each iteration i reads b[i-1] (now updated from phase 1) and writes a[i].
+        // No loop-carried dependence.
+        #pragma omp parallel for shared(a, b, c, d) schedule(static)
         for (int i = 1; i < LEN_1D-1; i++) {
             a[i] = b[i - 1] + c[i] * d[i];
-            b[i] = b[i + 1] - e[i] * d[i];
         }
+
         pb_mix(nl);
     }
+
+    free(b_new);
     return (real_t)0;
 }
 
