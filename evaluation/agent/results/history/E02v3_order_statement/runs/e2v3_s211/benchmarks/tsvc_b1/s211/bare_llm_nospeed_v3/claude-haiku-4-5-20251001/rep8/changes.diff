 static real_t kernel_s211(void)
 {
+    // Allocate temporary array to store new b values
+    // This avoids loop-carried dependence: iteration i writes b[i] which iteration i+1 reads
+    real_t *b_new = (real_t *)malloc(LEN_1D * sizeof(real_t));
+
     for (int nl = 0; nl < R; nl++) {
+        // Copy current b to b_new for boundary elements
+        for (int i = 0; i < LEN_1D; i++) {
+            b_new[i] = b[i];
+        }
+
+        // Parallel loop: compute new a and b values
+        // Each thread reads from original b (no dependence), writes to its own b_new[i]
+        // a[i] is write-only per iteration (no dependence)
+        #pragma omp parallel for shared(a, b, c, d, e, b_new)
         for (int i = 1; i < LEN_1D-1; i++) {
             a[i] = b[i - 1] + c[i] * d[i];
-            b[i] = b[i + 1] - e[i] * d[i];
+            b_new[i] = b[i + 1] - e[i] * d[i];
         }
+
+        // Copy new b values back to original b array
+        for (int i = 1; i < LEN_1D-1; i++) {
+            b[i] = b_new[i];
+        }
+
         pb_mix(nl);
     }
+
+    free(b_new);
     return (real_t)0;
 }
 
