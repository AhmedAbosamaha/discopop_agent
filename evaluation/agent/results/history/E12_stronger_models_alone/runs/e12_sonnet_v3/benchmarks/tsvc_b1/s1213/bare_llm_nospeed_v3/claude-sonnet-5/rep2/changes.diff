 /* Between two repetitions a few INPUT elements change, so no repetition can be skipped,
  * merged with another or run out of order: the repetition loop is sequential by a true
@@ -15,13 +16,44 @@
 
 static real_t kernel_s1213(void)
 {
+    /* Snapshot of a[] taken before each repetition's inner loop runs. Both
+     * statements in the inner loop, once the apparent b[i-1] dependence is
+     * expanded, read only pre-loop ("old") values of a[]: a[i] ends up
+     * using a_old[i] (or, for i==1, the untouched b[0]) and b[i] uses
+     * a_old[i+1]. Taking this snapshot turns the loop-carried dependence
+     * through b[] into a read of a shared read-only buffer, so iterations
+     * become independent. Heap-allocated since its size scales with
+     * LEN_1D. */
+    real_t *a_old = (real_t *)malloc(sizeof(real_t) * (size_t)LEN_1D);
+
     for (int nl = 0; nl < R; nl++) {
+        /* a_old: written here (per index i), read in the loop below -- shared.
+         * a: read here, untouched elsewhere in this snippet -- shared. */
+        #pragma omp parallel for default(none) shared(a, a_old)
+        for (int i = 0; i < LEN_1D; i++) {
+            a_old[i] = a[i];
+        }
+
+        /* a_old, b, c, d: read-only in this loop (b only at index 0) -- shared.
+         * a, b: each iteration writes a disjoint index (a[i], b[i]) -- shared.
+         * new_a: declared inside the loop body, per-iteration scratch --
+         * left out of every clause (it is already private). */
+        #pragma omp parallel for default(none) shared(a, b, c, d, a_old)
         for (int i = 1; i < LEN_1D-1; i++) {
-            a[i] = b[i-1]+c[i];
-            b[i] = a[i+1]*d[i];
+            real_t new_a;
+            if (i == 1) {
+                new_a = b[0] + c[1];
+            } else {
+                new_a = a_old[i] * d[i-1] + c[i];
+            }
+            b[i] = a_old[i+1] * d[i];
+            a[i] = new_a;
         }
+
         pb_mix(nl);
     }
+
+    free(a_old);
     return (real_t)0;
 }
 
