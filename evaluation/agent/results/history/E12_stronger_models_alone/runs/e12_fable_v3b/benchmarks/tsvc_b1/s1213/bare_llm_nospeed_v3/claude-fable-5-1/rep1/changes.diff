 static real_t kernel_s1213(void)
 {
     for (int nl = 0; nl < R; nl++) {
+        /* Pass 1: b[i] depends only on the OLD a[i+1] (anti-dependence in the
+         * original), so all of b can be produced first from the untouched a. */
+#pragma omp parallel for default(none) shared(a, b, d) schedule(static)
+        for (int i = 1; i < LEN_1D-1; i++) {
+            b[i] = a[i+1]*d[i];
+        }
+        /* Pass 2: a[i] reads the NEW b[i-1] (true dependence in the original);
+         * b is now complete, and b[0] is never written, so a[1] = b[0]+c[1]
+         * sees the same value as before. */
+#pragma omp parallel for default(none) shared(a, b, c) schedule(static)
         for (int i = 1; i < LEN_1D-1; i++) {
             a[i] = b[i-1]+c[i];
-            b[i] = a[i+1]*d[i];
         }
         pb_mix(nl);
     }
