 static real_t kernel_k48(void)
 {
+    const long n = LEN_1D;
+
+    /* ---- inspector (index arrays are invariant across repetitions) ---- */
+    long maxU = 0, maxV = 0;
+    for (long i = 1; i < n; i++) {
+        long x1 = (long)ju[i], x2 = (long)ku[i];
+        long y1 = (long)kv[i], y2 = (long)jv[i];
+        if (x1 > maxU) maxU = x1;
+        if (x2 > maxU) maxU = x2;
+        if (y1 > maxV) maxV = y1;
+        if (y2 > maxV) maxV = y2;
+    }
+    int *wU = (int *)malloc((size_t)(maxU + 1) * sizeof(int));
+    int *rU = (int *)malloc((size_t)(maxU + 1) * sizeof(int));
+    int *wV = (int *)malloc((size_t)(maxV + 1) * sizeof(int));
+    int *rV = (int *)malloc((size_t)(maxV + 1) * sizeof(int));
+    int *lev = (int *)malloc((size_t)(n > 0 ? n : 1) * sizeof(int));
+    for (long x = 0; x <= maxU; x++) { wU[x] = -1; rU[x] = -1; }
+    for (long x = 0; x <= maxV; x++) { wV[x] = -1; rV[x] = -1; }
+
+    int nlev = 0;
+    for (long i = 1; i < n; i++) {
+        long x1 = (long)ju[i], x2 = (long)ku[i];
+        long y1 = (long)kv[i], y2 = (long)jv[i];
+        int L = 0;
+        if (wU[x1] + 1 > L) L = wU[x1] + 1;
+        if (rU[x1] + 1 > L) L = rU[x1] + 1;
+        if (wU[x2] + 1 > L) L = wU[x2] + 1;
+        if (wV[y1] + 1 > L) L = wV[y1] + 1;
+        if (wV[y2] + 1 > L) L = wV[y2] + 1;
+        if (rV[y2] + 1 > L) L = rV[y2] + 1;
+        lev[i] = L;
+        if (rU[x1] < L) rU[x1] = L;
+        wU[x1] = L;
+        if (rU[x2] < L) rU[x2] = L;
+        if (rV[y1] < L) rV[y1] = L;
+        wV[y2] = L;
+        if (L + 1 > nlev) nlev = L + 1;
+    }
+    free(wU); free(rU); free(wV); free(rV);
+
+    long *start = (long *)calloc((size_t)nlev + 2, sizeof(long));
+    int *order = (int *)malloc((size_t)(n > 0 ? n : 1) * sizeof(int));
+    for (long i = 1; i < n; i++) start[lev[i] + 1]++;
+    for (int L = 0; L < nlev; L++) start[L + 1] += start[L];
+    {
+        long *pos = (long *)malloc(((size_t)nlev + 1) * sizeof(long));
+        for (int L = 0; L <= nlev; L++) pos[L] = start[L];
+        for (long i = 1; i < n; i++) order[pos[lev[i]]++] = (int)i;
+        free(pos);
+    }
+    free(lev);
+
+    const int use_par = ((long)nlev * 1024L <= n);
+
+    /* ---- executor ---- */
     for (int nl = 0; nl < R; nl++) {
-        for (long i = 1; i < LEN_1D; i++) {
-            u[ju[i]] += v[kv[i]] * c[i];
-            v[jv[i]] = u[ku[i]] * d[i] + c[i];
+        if (use_par) {
+            for (int L = 0; L < nlev; L++) {
+                const long s = start[L];
+                const long t = start[L + 1];
+                #pragma omp parallel for schedule(static) shared(order)
+                for (long k = s; k < t; k++) {
+                    long i = (long)order[k];
+                    u[ju[i]] += v[kv[i]] * c[i];
+                    v[jv[i]] = u[ku[i]] * d[i] + c[i];
+                }
+            }
+        } else {
+            for (long i = 1; i < LEN_1D; i++) {
+                u[ju[i]] += v[kv[i]] * c[i];
+                v[jv[i]] = u[ku[i]] * d[i] + c[i];
+            }
         }
         pb_mix(nl);
     }
+    free(start);
+    free(order);
     return (real_t)0;
 }
 
