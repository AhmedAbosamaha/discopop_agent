 /* Between two repetitions a few INPUT elements change, so no repetition can be skipped,
  * merged with another or run out of order: the repetition loop is sequential by a true
@@ -15,13 +16,26 @@
 
 static real_t kernel_s211(void)
 {
+    real_t *tmp = (real_t *)malloc((size_t)LEN_1D * sizeof(real_t));
+    if (tmp == NULL) {
+        return (real_t)0;
+    }
     for (int nl = 0; nl < R; nl++) {
+        /* pass 1: new b values from old b (anti-dependence on b[i+1] removed) */
+        #pragma omp parallel for shared(tmp, b, d, e) schedule(static)
         for (int i = 1; i < LEN_1D-1; i++) {
-            a[i] = b[i - 1] + c[i] * d[i];
-            b[i] = b[i + 1] - e[i] * d[i];
+            tmp[i] = b[i + 1] - e[i] * d[i];
+        }
+        /* pass 2: commit b and compute a from the new b[i-1] (b[0] never written) */
+        #pragma omp parallel for shared(tmp, a, b, c, d) schedule(static)
+        for (int i = 1; i < LEN_1D-1; i++) {
+            real_t prev = (i == 1) ? b[0] : tmp[i - 1];
+            a[i] = prev + c[i] * d[i];
+            b[i] = tmp[i];
         }
         pb_mix(nl);
     }
+    free(tmp);
     return (real_t)0;
 }
 
