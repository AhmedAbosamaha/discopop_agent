 static real_t kernel_s341(void)
 {
     int j;
+
+    /* Allocate mark and pos arrays once—used for prefix-sum based compaction.
+       This exposes a fully parallelizable final write phase. */
+    int *mark = malloc(LEN_1D * sizeof(int));
+    int *pos = malloc(LEN_1D * sizeof(int));
+
     for (int nl = 0; nl < R; nl++) {
-        j = -1;
+        /* Phase 1: Mark which elements pass the filter.
+           Each i writes to independent mark[i]. */
         for (int i = 0; i < LEN_1D; i++) {
-            if (b[i] > (real_t)0.) {
-                j++;
-                a[j] = b[i];
+            mark[i] = (b[i] > (real_t)0.) ? 1 : 0;
+        }
+
+        /* Phase 2: Compute prefix sums to determine target positions.
+           Sequential; each pos[i] = sum of mark[0..i]. */
+        pos[0] = mark[0];
+        for (int i = 1; i < LEN_1D; i++) {
+            pos[i] = pos[i-1] + mark[i];
+        }
+
+        /* Phase 3: Parallel write—each i with mark[i]=1 writes to a[pos[i]-1].
+           No loop-carried dependence: each iteration writes to a pre-computed,
+           unique position based on pos[i]. */
+        for (int i = 0; i < LEN_1D; i++) {
+            if (mark[i]) {
+                a[pos[i] - 1] = b[i];
             }
         }
+
+        /* Final j is the count of selected elements. */
+        j = (pos[LEN_1D - 1] > 0) ? pos[LEN_1D - 1] - 1 : -1;
+
         pb_mix(nl);
     }
+
+    free(mark);
+    free(pos);
     return (real_t)0;
 }
 