 static real_t kernel_s211(void)
 {
+    // Allocate temporary buffer for new b values
+    real_t *b_new = malloc(LEN_1D * sizeof(real_t));
+
     for (int nl = 0; nl < R; nl++) {
+        // Parallel loop 1: compute new b values based on original b
+        // Each iteration i reads b[i+1] and writes b_new[i], with no loop-carried dependency
+        #pragma omp parallel for shared(b, b_new, e, d)
+        for (int i = 1; i < LEN_1D-1; i++) {
+            b_new[i] = b[i + 1] - e[i] * d[i];
+        }
+
+        // Implicit barrier at end of parallel for
+
+        // Copy new b values back to b
+        for (int i = 1; i < LEN_1D-1; i++) {
+            b[i] = b_new[i];
+        }
+
+        // Parallel loop 2: compute a values using updated b
+        // Each iteration i reads b[i-1] (now updated), c[i], d[i] and writes a[i]
+        #pragma omp parallel for shared(a, b, c, d)
         for (int i = 1; i < LEN_1D-1; i++) {
             a[i] = b[i - 1] + c[i] * d[i];
-            b[i] = b[i + 1] - e[i] * d[i];
         }
+
         pb_mix(nl);
     }
+
+    free(b_new);
     return (real_t)0;
 }
 
