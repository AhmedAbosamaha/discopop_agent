 static real_t kernel_s241(void)
 {
+    real_t *a_old = malloc(sizeof(real_t) * LEN_1D);
+
     for (int nl = 0; nl < R; nl++) {
+        // Copy a[] to a_old[] to preserve initial values for reading
+        #pragma omp parallel for shared(a, a_old)
+        for (int k = 0; k < LEN_1D; k++) {
+            a_old[k] = a[k];
+        }
+
+        // Parallel loop: each iteration i reads a_old[i+1] (initial value),
+        // avoiding backward dependence on a[i+1] written by iteration i+1
+        #pragma omp parallel for shared(a, b, c, d, a_old)
         for (int i = 0; i < LEN_1D-1; i++) {
             a[i] = b[i] * c[i  ] * d[i];
-            b[i] = a[i] * a[i+1] * d[i];
+            b[i] = a[i] * a_old[i+1] * d[i];
         }
         pb_mix(nl);
     }
+
+    free(a_old);
     return (real_t)0;
 }
 
