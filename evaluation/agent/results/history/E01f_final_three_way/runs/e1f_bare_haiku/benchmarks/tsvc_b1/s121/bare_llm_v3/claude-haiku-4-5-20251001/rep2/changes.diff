 static real_t kernel_s121(void)
 {
     int j;
+    real_t* a_temp = (real_t*)malloc(LEN_1D * sizeof(real_t));
+
     for (int nl = 0; nl < R; nl++) {
+        /* Copy original values of a into temporary buffer to eliminate
+           the read-after-write anti-dependence between iterations. */
+        for (int i = 0; i < LEN_1D; i++) {
+            a_temp[i] = a[i];
+        }
+
+        /* Parallelize the inner loop: all iterations now read from the
+           unchanging a_temp buffer and write to disjoint a[] locations.
+           No inter-iteration dependencies. */
+        #pragma omp parallel for private(j)
         for (int i = 0; i < LEN_1D-1; i++) {
             j = i + 1;
-            a[i] = a[j] + b[i];
+            a[i] = a_temp[j] + b[i];
         }
+
         pb_mix(nl);
     }
+
+    free(a_temp);
     return (real_t)0;
 }
 
