@@ -16,10 +16,23 @@
 static real_t kernel_s241(void)
 {
     for (int nl = 0; nl < R; nl++) {
+        // Save initial values of a to break anti-dependence through a[i+1]
+        real_t *a_init = malloc(LEN_1D * sizeof(real_t));
+        for (int i = 0; i < LEN_1D; i++) {
+            a_init[i] = a[i];
+        }
+
+        // Parallel loop: each iteration i writes to a[i] and b[i],
+        // reads from b[i], c[i], d[i], and a_init[i+1] (initial a value).
+        // No loop-carried dependence: iteration i reads a_init[i+1] (read-only copy),
+        // iteration i+1 writes a[i+1] (different array).
+        #pragma omp parallel for shared(a, b, c, d, a_init)
         for (int i = 0; i < LEN_1D-1; i++) {
             a[i] = b[i] * c[i  ] * d[i];
-            b[i] = a[i] * a[i+1] * d[i];
+            b[i] = a[i] * a_init[i+1] * d[i];
         }
+
+        free(a_init);
         pb_mix(nl);
     }
     return (real_t)0;
