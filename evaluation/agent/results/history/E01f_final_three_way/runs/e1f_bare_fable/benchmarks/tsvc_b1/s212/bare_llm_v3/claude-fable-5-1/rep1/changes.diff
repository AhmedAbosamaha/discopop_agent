--- original.c
+++ final.c
@@ -16,9 +16,17 @@
 static real_t kernel_s212(void)
 {
     for (int nl = 0; nl < R; nl++) {
+        /* Original body: a[i] *= c[i]; b[i] += a[i+1]*d[i].  Iteration i reads
+         * a[i+1] before iteration i+1 overwrites it (anti-dependence on a).
+         * Split into two passes: first update b with the still-unmodified a,
+         * then scale a.  Each pass has independent iterations. */
+        #pragma omp parallel for shared(a, b, d) schedule(static)
+        for (int i = 0; i < LEN_1D-1; i++) {
+            b[i] += a[i + 1] * d[i];
+        }
+        #pragma omp parallel for shared(a, c) schedule(static)
         for (int i = 0; i < LEN_1D-1; i++) {
             a[i] *= c[i];
-            b[i] += a[i + 1] * d[i];
         }
         pb_mix(nl);
     }
