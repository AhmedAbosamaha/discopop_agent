--- original.c
+++ final.c
@@ -16,10 +16,17 @@
 static real_t kernel_s244(void)
 {
     for (int nl = 0; nl < R; nl++) {
+        /* The original's write to a[i+1] in iteration i is overwritten by iteration i+1
+         * before anything reads it, except for the last iteration.  So every iteration
+         * only needs to update its own a[i], b[i]; the surviving a[LEN_1D-1] update is
+         * done once afterwards, reading the already-updated b[LEN_1D-2]. */
+#pragma omp parallel for shared(a, b, c, d) schedule(static)
         for (int i = 0; i < LEN_1D-1; ++i) {
             a[i] = b[i] + c[i] * d[i];
             b[i] = c[i] + b[i];
-            a[i+1] = b[i] + a[i+1] * d[i];
+        }
+        if (LEN_1D > 1) {
+            a[LEN_1D-1] = b[LEN_1D-2] + a[LEN_1D-1] * d[LEN_1D-2];
         }
         pb_mix(nl);
     }
