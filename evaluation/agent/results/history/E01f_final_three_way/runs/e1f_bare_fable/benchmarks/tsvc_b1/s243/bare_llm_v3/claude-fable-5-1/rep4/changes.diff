--- original.c
+++ final.c
@@ -1,6 +1,7 @@
 /* TSVC-2 loop s243, from TSVC-2 src/tsvc.c (sha256 456dd573b84b; University of Illinois licence,
  * see benchmarks/TSVC_2/license.txt). */
 #include "tsvc_b1/s243.h"
+#include <stdlib.h>
 
 /* Between two repetitions a few INPUT elements change, so no repetition can be skipped,
  * merged with another or run out of order: the repetition loop is sequential by a true
@@ -15,11 +16,25 @@
 
 static real_t kernel_s243(void)
 {
+    /* Snapshot of a[] taken at the start of each pass: iteration i reads the
+     * OLD a[i+1], which iteration i+1 overwrites.  Reading from the snapshot
+     * removes that anti-dependence.  Heap-allocated since it grows with LEN_1D. */
+    static real_t *a_old = NULL;
+    if (a_old == NULL) {
+        a_old = (real_t *)malloc((size_t)LEN_1D * sizeof(real_t));
+    }
+
     for (int nl = 0; nl < R; nl++) {
+        #pragma omp parallel for shared(a, a_old) schedule(static)
+        for (int i = 1; i < LEN_1D; i++) {
+            a_old[i] = a[i];
+        }
+
+        #pragma omp parallel for shared(a, b, c, d, e, a_old) schedule(static)
         for (int i = 0; i < LEN_1D-1; i++) {
             a[i] = b[i] + c[i  ] * d[i];
             b[i] = a[i] + d[i  ] * e[i];
-            a[i] = b[i] + a[i+1] * d[i];
+            a[i] = b[i] + a_old[i+1] * d[i];
         }
         pb_mix(nl);
     }
