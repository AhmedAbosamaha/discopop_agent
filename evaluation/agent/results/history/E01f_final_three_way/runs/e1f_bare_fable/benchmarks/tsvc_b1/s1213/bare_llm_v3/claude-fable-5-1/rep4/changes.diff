@@ -16,9 +16,18 @@
 static real_t kernel_s1213(void)
 {
     for (int nl = 0; nl < R; nl++) {
+        /* Pass 1: b[i] uses the ORIGINAL a[i+1] (anti-dependence in the
+         * fused loop), so compute all of b first.  No iteration reads b. */
+#pragma omp parallel for shared(a, b, d) schedule(static)
+        for (int i = 1; i < LEN_1D-1; i++) {
+            b[i] = a[i+1]*d[i];
+        }
+        /* Pass 2: a[i] uses the NEW b[i-1] (b[0] is never written, so it is
+         * the untouched value for i==1).  All of b is final here, so the
+         * flow dependence is satisfied across the loop boundary. */
+#pragma omp parallel for shared(a, b, c) schedule(static)
         for (int i = 1; i < LEN_1D-1; i++) {
             a[i] = b[i-1]+c[i];
-            b[i] = a[i+1]*d[i];
         }
         pb_mix(nl);
     }
