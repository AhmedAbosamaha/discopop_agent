@@ -15,14 +16,28 @@
 
 static real_t kernel_s243(void)
 {
+    /* Snapshot of a[] taken before each sweep: the sweep reads a[i+1] as it was
+     * BEFORE iteration i+1 writes it (anti-dependence on a location, not a value
+     * flowing between iterations), so reading from the snapshot makes every
+     * iteration independent. */
+    real_t *aold = (real_t *)malloc(sizeof(real_t) * (size_t)LEN_1D);
+    if (aold == NULL) return (real_t)0;
+
     for (int nl = 0; nl < R; nl++) {
-        for (int i = 0; i < LEN_1D-1; i++) {
+        int i;
+#pragma omp parallel for shared(a, aold) private(i) schedule(static)
+        for (i = 0; i < LEN_1D; i++) {
+            aold[i] = a[i];
+        }
+#pragma omp parallel for shared(a, b, c, d, e, aold) private(i) schedule(static)
+        for (i = 0; i < LEN_1D-1; i++) {
             a[i] = b[i] + c[i  ] * d[i];
             b[i] = a[i] + d[i  ] * e[i];
-            a[i] = b[i] + a[i+1] * d[i];
+            a[i] = b[i] + aold[i+1] * d[i];
         }
         pb_mix(nl);
     }
+    free(aold);
     return (real_t)0;
 }
 
