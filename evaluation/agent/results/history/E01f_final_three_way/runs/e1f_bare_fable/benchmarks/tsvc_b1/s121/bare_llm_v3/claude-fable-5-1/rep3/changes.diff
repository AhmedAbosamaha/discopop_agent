@@ -1,6 +1,7 @@
 /* TSVC-2 loop s121, from TSVC-2 src/tsvc.c (sha256 456dd573b84b; University of Illinois licence,
  * see benchmarks/TSVC_2/license.txt). */
 #include "tsvc_b1/s121.h"
+#include <stdlib.h>
 
 /* Between two repetitions a few INPUT elements change, so no repetition can be skipped,
  * merged with another or run out of order: the repetition loop is sequential by a true
@@ -16,13 +17,24 @@
 static real_t kernel_s121(void)
 {
     int j;
+    /* Snapshot buffer: tmp[i] holds the ORIGINAL a[i+1] so the anti-dependence
+     * (iteration i reads a[i+1] before iteration i+1 overwrites it) is removed. */
+    real_t *tmp = (real_t *)malloc(sizeof(real_t) * (size_t)LEN_1D);
     for (int nl = 0; nl < R; nl++) {
+        /* Pass 1: capture the old values of a[i+1] before any of a is modified. */
+        #pragma omp parallel for shared(a, tmp) private(j) schedule(static)
         for (int i = 0; i < LEN_1D-1; i++) {
             j = i + 1;
-            a[i] = a[j] + b[i];
+            tmp[i] = a[j];
+        }
+        /* Pass 2: every a[i] depends only on the snapshot and b[i]: independent. */
+        #pragma omp parallel for shared(a, b, tmp) schedule(static)
+        for (int i = 0; i < LEN_1D-1; i++) {
+            a[i] = tmp[i] + b[i];
         }
         pb_mix(nl);
     }
+    free(tmp);
     return (real_t)0;
 }
 
