@@ -15,13 +16,24 @@
 
 static real_t kernel_s211(void)
 {
+    /* tmp[i] holds the NEW value of b[i] (computed from the OLD b[i+1]), so that
+     * a[i] can read the new b[i-1] without waiting for iteration i-1.
+     * tmp[0] = b[0], which the original loop never writes. */
+    real_t *tmp = (real_t *)malloc((size_t)LEN_1D * sizeof(real_t));
     for (int nl = 0; nl < R; nl++) {
+        tmp[0] = b[0];
+#pragma omp parallel for default(none) shared(b, d, e, tmp) schedule(static)
         for (int i = 1; i < LEN_1D-1; i++) {
-            a[i] = b[i - 1] + c[i] * d[i];
-            b[i] = b[i + 1] - e[i] * d[i];
+            tmp[i] = b[i + 1] - e[i] * d[i];
+        }
+#pragma omp parallel for default(none) shared(a, b, c, d, tmp) schedule(static)
+        for (int i = 1; i < LEN_1D-1; i++) {
+            a[i] = tmp[i - 1] + c[i] * d[i];
+            b[i] = tmp[i];
         }
         pb_mix(nl);
     }
+    free(tmp);
     return (real_t)0;
 }
 
