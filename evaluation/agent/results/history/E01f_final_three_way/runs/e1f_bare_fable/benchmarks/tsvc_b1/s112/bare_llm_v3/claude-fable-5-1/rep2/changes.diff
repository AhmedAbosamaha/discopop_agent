@@ -15,12 +16,23 @@
 
 static real_t kernel_s112(void)
 {
+    /* The original backward loop reads a[i] before iteration i-1 overwrites it:
+     * an anti-dependence on the location a[i], not a value flow.  Every result
+     * is old_a[i] + b[i], so snapshot the old a[] into a heap buffer first and
+     * compute from the snapshot; both passes have independent iterations. */
+    real_t *old_a = (real_t *)malloc(sizeof(real_t) * (size_t)LEN_1D);
     for (int nl = 0; nl < R; nl++) {
-        for (int i = LEN_1D - 2; i >= 0; i--) {
-            a[i+1] = a[i] + b[i];
+#pragma omp parallel for default(none) shared(a, old_a) schedule(static)
+        for (int i = 0; i < LEN_1D - 1; i++) {
+            old_a[i] = a[i];
+        }
+#pragma omp parallel for default(none) shared(a, b, old_a) schedule(static)
+        for (int i = 0; i < LEN_1D - 1; i++) {
+            a[i+1] = old_a[i] + b[i];
         }
         pb_mix(nl);
     }
+    free(old_a);
     return (real_t)0;
 }
 
