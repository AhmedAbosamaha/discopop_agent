@@ -16,9 +16,17 @@
 static real_t kernel_s1213(void)
 {
     for (int nl = 0; nl < R; nl++) {
+        /* Pass 1: b[i] uses the OLD a[i+1] (not yet overwritten in the original
+         * order), so compute all of b first from the untouched a. */
+#pragma omp parallel for shared(a, b, d) schedule(static)
+        for (int i = 1; i < LEN_1D-1; i++) {
+            b[i] = a[i+1]*d[i];
+        }
+        /* Pass 2: a[i] uses the NEW b[i-1] (b[0] is never written), which is
+         * now complete, so every iteration is independent. */
+#pragma omp parallel for shared(a, b, c) schedule(static)
         for (int i = 1; i < LEN_1D-1; i++) {
             a[i] = b[i-1]+c[i];
-            b[i] = a[i+1]*d[i];
         }
         pb_mix(nl);
     }
