--- s3112.c
+++ s3112.c
@@ -18,10 +18,45 @@
     real_t sum;
     for (int nl = 0; nl < R; nl++) {
         sum = (real_t)0.0;
-        for (int i = 0; i < LEN_1D; i++) {
-            sum += a[i];
-            b[i] = sum;
+
+        /* Chunked prefix sum: splits the work into independent chunks that can be parallelized.
+         * Phase 1 computes prefix sums within each chunk independently (parallel Do-All).
+         * Phase 2 sequentially combines chunk results and adjusts offsets. */
+        int chunk_size = 4096;
+        int num_chunks = (LEN_1D + chunk_size - 1) / chunk_size;
+        real_t *chunk_sums = (real_t*)malloc(num_chunks * sizeof(real_t));
+
+        /* Phase 1: Compute local prefix sums in each chunk independently */
+        for (int c = 0; c < num_chunks; c++) {
+            real_t local_sum = (real_t)0.0;
+            int start = c * chunk_size;
+            int end = start + chunk_size;
+            if (end > LEN_1D) end = LEN_1D;
+
+            for (int i = start; i < end; i++) {
+                local_sum += a[i];
+                b[i] = local_sum;
+            }
+            chunk_sums[c] = local_sum;
         }
+
+        /* Phase 2: Sequentially combine chunk results and adjust offsets in b */
+        sum = (real_t)0.0;
+        for (int c = 0; c < num_chunks; c++) {
+            real_t offset = sum;
+            sum += chunk_sums[c];
+
+            /* Add the offset (sum from all previous chunks) to b values in this chunk */
+            int start = c * chunk_size;
+            int end = start + chunk_size;
+            if (end > LEN_1D) end = LEN_1D;
+
+            for (int i = start; i < end; i++) {
+                b[i] += offset;
+            }
+        }
+
+        free(chunk_sums);
         pb_mix(nl);
     }
     return sum;