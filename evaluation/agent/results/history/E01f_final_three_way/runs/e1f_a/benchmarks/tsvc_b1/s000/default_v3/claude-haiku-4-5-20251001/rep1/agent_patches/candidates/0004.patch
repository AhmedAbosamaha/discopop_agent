 static real_t kernel_s000(void)
 {
     for (int nl = 0; nl < R; nl++) {
+        /* Allocate snapshot on heap to avoid stack overflow at large problem sizes */
+        real_t *b_snapshot = (real_t *)malloc(LEN_1D * sizeof(real_t));
+
+        /* Capture b's state before pb_mix modifies it for the next iteration */
         for (int i = 0; i < LEN_1D; i++) {
-            a[i] = b[i] + 1;
+            b_snapshot[i] = b[i];
         }
+
+        /* Compute a using the captured b values */
+        for (int i = 0; i < LEN_1D; i++) {
+            a[i] = b_snapshot[i] + 1;
+        }
+
+        free(b_snapshot);
         pb_mix(nl);
     }
     return (real_t)0;