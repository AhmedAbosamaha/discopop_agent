--- vpvtv.c
+++ vpvtv.c
@@ -15,12 +15,27 @@
 
 static real_t kernel_vpvtv(void)
 {
+    /* Allocate buffer for b snapshot outside the loop.
+     * Only b is copied because DiscoPoP reports RAW loop-carried only on b.
+     * This removes the loop-carried dependence on b while keeping overhead minimal:
+     * one memcpy pass per outer iteration, allocated outside the loop. */
+    real_t *b_saved = (real_t *)malloc(LEN_1D * sizeof(real_t));
+
     for (int nl = 0; nl < R; nl++) {
+        /* Save b before pb_mix modifies it */
+        memcpy(b_saved, b, LEN_1D * sizeof(real_t));
+
+        /* Inner loop: reads b_saved (saved pre-mix state) instead of b (which
+         * will be modified by pb_mix). This breaks the loop-carried dependence
+         * while preserving correctness: each outer iteration computes with b's
+         * state as of when that iteration began. */
         for (int i = 0; i < LEN_1D; i++) {
-            a[i] += b[i] * c[i];
+            a[i] += b_saved[i] * c[i];
         }
         pb_mix(nl);
     }
+
+    free(b_saved);
     return (real_t)0;
 }
 