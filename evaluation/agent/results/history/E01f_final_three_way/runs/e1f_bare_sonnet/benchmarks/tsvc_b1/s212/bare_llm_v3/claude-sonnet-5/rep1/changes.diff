 static real_t kernel_s212(void)
 {
     for (int nl = 0; nl < R; nl++) {
+        /* Split the original fused loop into two passes so each pass has
+         * no cross-iteration dependence. Pass 1 reads only the untouched
+         * `a` array (nothing writes `a` here), matching the original
+         * semantics where b[i] always used the pre-loop value of a[i+1].
+         * Pass 2 then updates `a` in place, independently per index. */
+        #pragma omp parallel for shared(a, b, d) schedule(static)
+        for (int i = 0; i < LEN_1D-1; i++) {
+            b[i] += a[i + 1] * d[i];
+        }
+        #pragma omp parallel for shared(a, c) schedule(static)
         for (int i = 0; i < LEN_1D-1; i++) {
             a[i] *= c[i];
-            b[i] += a[i + 1] * d[i];
         }
         pb_mix(nl);
     }
