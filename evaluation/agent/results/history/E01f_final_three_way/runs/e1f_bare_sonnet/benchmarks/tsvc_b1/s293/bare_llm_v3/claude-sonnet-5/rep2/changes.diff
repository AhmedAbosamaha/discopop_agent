--- original.c
+++ final.c
@@ -16,8 +16,16 @@
 static real_t kernel_s293(void)
 {
     for (int nl = 0; nl < R; nl++) {
+        /* a[0] is loop-invariant across this inner loop (it is only changed by
+         * pb_mix(), which runs after the loop completes), so every iteration
+         * reads the same value and writes a distinct a[i]: no dependence
+         * between iterations. Snapshot it into a0 (firstprivate scratch,
+         * read-only for every thread) so the parallel loop never has a
+         * thread concurrently reading and writing a[0] at i==0. */
+        real_t a0 = a[0];
+        #pragma omp parallel for firstprivate(a0) shared(a)
         for (int i = 0; i < LEN_1D; i++) {
-            a[i] = a[0];
+            a[i] = a0;
         }
         pb_mix(nl);
     }
