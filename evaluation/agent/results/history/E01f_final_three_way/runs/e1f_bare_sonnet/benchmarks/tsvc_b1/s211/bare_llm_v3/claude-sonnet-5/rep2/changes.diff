@@ -15,13 +16,40 @@
 
 static real_t kernel_s211(void)
 {
+    /* b_old holds the snapshot of b[] taken before each repetition's inner loop runs.
+     * The original sequential loop reads, at iteration i, a value of b[i-1] that was
+     * written by iteration i-1 using the *pre-loop* value of b[i] (since forward order
+     * never reaches index i before processing i-1); and it always reads the pre-loop
+     * value of b[i+1] for its own b[i] update. Recomputing both a[i] and b[i] directly
+     * from this snapshot removes the inter-iteration dependence while reproducing the
+     * exact same floating-point operations/order as the original, so results match
+     * bit-for-bit. Heap-allocated since LEN_1D can be very large; allocated once and
+     * reused across all R repetitions (not re-allocated per repetition). */
+    real_t *b_old = (real_t *)malloc(sizeof(real_t) * (size_t)LEN_1D);
+
     for (int nl = 0; nl < R; nl++) {
+        /* Snapshot b[] before this repetition's updates. b and b_old are distinct
+         * buffers, so iterations are fully independent: each writes one b_old[i]
+         * from one b[i]. */
+        #pragma omp parallel for default(none) shared(b, b_old)
+        for (int i = 0; i < LEN_1D; i++) {
+            b_old[i] = b[i];
+        }
+
+        /* Each iteration now depends only on the read-only snapshot b_old and on
+         * c/d/e, plus writes a[i] and b[i] for its own i only: no loop-carried
+         * dependence remains. bprev is scratch declared inside the loop body, so
+         * it is private by construction and needs no data-sharing clause. */
+        #pragma omp parallel for default(none) shared(a, b, c, d, e, b_old)
         for (int i = 1; i < LEN_1D-1; i++) {
-            a[i] = b[i - 1] + c[i] * d[i];
-            b[i] = b[i + 1] - e[i] * d[i];
+            real_t bprev = (i == 1) ? b_old[0] : (b_old[i] - e[i - 1] * d[i - 1]);
+            a[i] = bprev + c[i] * d[i];
+            b[i] = b_old[i + 1] - e[i] * d[i];
         }
         pb_mix(nl);
     }
+
+    free(b_old);
     return (real_t)0;
 }
 
