 /* TSVC-2 loop s121, from TSVC-2 src/tsvc.c (sha256 456dd573b84b; University of Illinois licence,
  * see benchmarks/TSVC_2/license.txt). */
 #include "tsvc_b1/s121.h"
+#include <stdlib.h>
 
 /* Between two repetitions a few INPUT elements change, so no repetition can be skipped,
  * merged with another or run out of order: the repetition loop is sequential by a true
@@ -15,14 +16,39 @@
 
 static real_t kernel_s121(void)
 {
-    int j;
+    /* Heap-allocated: its size tracks LEN_1D, which can be huge in the
+     * verification builds, so it must not live on the stack. Allocated
+     * once outside the R loop so it stays a constant extra buffer, not
+     * work that grows with the number of repetitions. */
+    real_t *a_prev = (real_t *)malloc((size_t)LEN_1D * sizeof(real_t));
+
     for (int nl = 0; nl < R; nl++) {
+        /* Snapshot a[] before this repetition's update pass. The update
+         * loop below only ever reads from this frozen copy, so it no
+         * longer matters which order (or how many threads) its
+         * iterations run in. */
+        #pragma omp parallel for shared(a, a_prev)
+        for (int i = 0; i < LEN_1D; i++) {
+            a_prev[i] = a[i];
+        }
+
+        /* Original dependence: a[i] = a[i+1] + b[i] read a[i+1] before it
+         * got overwritten by the later iteration i+1, which only worked
+         * because iterations ran strictly in increasing order. Reading
+         * a_prev[i+1] (the pre-loop snapshot) instead of a[i+1] removes
+         * that dependence: each iteration now reads an already-fixed
+         * value and writes its own distinct a[i], so iterations are
+         * independent. `j` is per-iteration scratch declared inside the
+         * loop, so it needs no data-sharing clause. a_prev and b are
+         * read-only here, a is written at disjoint indices per i. */
+        #pragma omp parallel for shared(a, b, a_prev)
         for (int i = 0; i < LEN_1D-1; i++) {
-            j = i + 1;
-            a[i] = a[j] + b[i];
+            int j = i + 1;
+            a[i] = a_prev[j] + b[i];
         }
         pb_mix(nl);
     }
+    free(a_prev);
     return (real_t)0;
 }
 
