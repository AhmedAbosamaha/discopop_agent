--- original.c
+++ final.c
@@ -16,8 +16,14 @@
 static real_t kernel_s293(void)
 {
     for (int nl = 0; nl < R; nl++) {
+        /* Hoist the read of a[0] so the loop body never reads and writes the
+         * same shared location concurrently (i==0 would otherwise write
+         * a[0] while other iterations read it, a benign-value but real
+         * race). a0 is firstprivate: each thread just reads its own copy. */
+        real_t a0 = a[0];
+        #pragma omp parallel for default(none) shared(a) firstprivate(a0) schedule(static)
         for (int i = 0; i < LEN_1D; i++) {
-            a[i] = a[0];
+            a[i] = a0;
         }
         pb_mix(nl);
     }
