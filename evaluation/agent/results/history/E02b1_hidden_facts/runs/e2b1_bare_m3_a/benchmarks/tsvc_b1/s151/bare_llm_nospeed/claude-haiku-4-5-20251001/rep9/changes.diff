 void s151s(real_t a[LEN_1D], real_t b[LEN_1D],  int m)
 {
+    real_t *temp = (real_t *)malloc((LEN_1D - 1) * sizeof(real_t));
+
+    /* First loop: read from original a and b, write to temp.
+     * No loop-carried dependences: each iteration i independently reads a[i+m], b[i]
+     * and writes temp[i]. The implicit barrier ensures all temp writes complete
+     * before the next loop begins. */
+    #pragma omp parallel for shared(a, b, temp, m)
     for (int i = 0; i < LEN_1D-1; i++) {
-        a[i] = a[i + m] + b[i];
+        temp[i] = a[i + m] + b[i];
     }
+
+    /* Second loop: read from temp, write to a.
+     * No loop-carried dependences: each iteration independently reads temp[i]
+     * and writes a[i]. Results are guaranteed to match sequential execution
+     * because all reads from original a completed in the first loop. */
+    #pragma omp parallel for shared(a, temp)
+    for (int i = 0; i < LEN_1D-1; i++) {
+        a[i] = temp[i];
+    }
+
+    free(temp);
 }
 
