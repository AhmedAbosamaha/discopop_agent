 /* Kernel k19. */
 #include "tsvc_b1/k19.h"
+#include <stdlib.h>
 
 /* Between two repetitions a few INPUT elements change, so no repetition can be skipped,
  * merged with another or run out of order: the repetition loop is sequential by a true
@@ -14,10 +15,49 @@
 
 static real_t kernel_k19(void)
 {
+    /* Inspector (index arrays never change): decide whether the sweep can be
+     * split into "all v writes" followed by "all u updates". */
+    int split_ok = 1;
+    int *pos = (int *)malloc(sizeof(int) * (size_t)LEN_1D);
+    if (pos == NULL) {
+        split_ok = 0;
+    } else {
+        for (long j = 0; j < LEN_1D; j++) pos[j] = -1;
+        for (long i = 1; i < LEN_1D; i++) {
+            long t = (long)jv[i];
+            if (pos[t] >= 0) split_ok = 0;
+            else pos[t] = (int)i;
+        }
+        for (long i = 1; i < LEN_1D; i++) {
+            int p = pos[(long)kv[i]];
+            if (p >= (int)i) split_ok = 0;
+        }
+        for (long j = 0; j < LEN_1D; j++) pos[j] = -1;
+        for (long i = 1; i < LEN_1D; i++) {
+            long t = (long)ju[i];
+            if (pos[t] >= 0) split_ok = 0;
+            else pos[t] = (int)i;
+        }
+        for (long i = 1; i < LEN_1D; i++) {
+            int p = pos[(long)ku[i]];
+            if (p >= 0 && p <= (int)i) split_ok = 0;
+        }
+        free(pos);
+    }
+
     for (int nl = 0; nl < R; nl++) {
-        for (long i = 1; i < LEN_1D; i++) {
-            u[ju[i]] += v[kv[i]] * c[i];
-            v[jv[i]] = u[ku[i]] * d[i] + c[i];
+        if (split_ok) {
+            for (long i = 1; i < LEN_1D; i++) {
+                v[jv[i]] = u[ku[i]] * d[i] + c[i];
+            }
+            for (long i = 1; i < LEN_1D; i++) {
+                u[ju[i]] += v[kv[i]] * c[i];
+            }
+        } else {
+            for (long i = 1; i < LEN_1D; i++) {
+                u[ju[i]] += v[kv[i]] * c[i];
+                v[jv[i]] = u[ku[i]] * d[i] + c[i];
+            }
         }
         pb_mix(nl);
     }