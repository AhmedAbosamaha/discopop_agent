 static real_t kernel_k19(void)
 {
+    /* The index arrays ju, ku, jv, kv never change (pb_mix touches only a..e), so the
+     * dependence structure of the inner loop is identical in every repetition.
+     * Inspector (once): give every iteration i a wavefront level that is strictly
+     * larger than the level of any earlier iteration that wrote a u/v element i
+     * touches, or read an element i writes.  Iterations of one level are therefore
+     * write-disjoint and may run in any order; levels run in increasing order, so
+     * every value still reaches its reader. */
+    const long n = LEN_1D;
+    long m = 0;
+    for (long i = 1; i < n; i++) {
+        long t;
+        t = (long)ju[i]; if (t > m) m = t;
+        t = (long)ku[i]; if (t > m) m = t;
+        t = (long)jv[i]; if (t > m) m = t;
+        t = (long)kv[i]; if (t > m) m = t;
+    }
+    m += 1;
+
+    int *lvl   = (int *)malloc((size_t)n * sizeof(int));
+    int *wu    = (int *)calloc((size_t)m, sizeof(int));   /* level of last write to u[x] */
+    int *ru    = (int *)calloc((size_t)m, sizeof(int));   /* max level of a read of u[x] */
+    int *wv    = (int *)calloc((size_t)m, sizeof(int));   /* level of last write to v[x] */
+    int *rv    = (int *)calloc((size_t)m, sizeof(int));   /* max level of a read of v[x] */
+    int *order = NULL;
+    long *start = NULL;
+    int nlev = 0;
+
+    if (lvl != NULL && wu != NULL && ru != NULL && wv != NULL && rv != NULL) {
+        for (long i = 1; i < n; i++) {
+            const long xu = (long)ju[i];   /* u read+written */
+            const long yu = (long)ku[i];   /* u read          */
+            const long xv = (long)kv[i];   /* v read          */
+            const long yv = (long)jv[i];   /* v written       */
+            int L = wu[xu];
+            if (ru[yu] > L) L = ru[yu];
+            if (ru[xu] > L) L = ru[xu];
+            if (wu[yu] > L) L = wu[yu];
+            if (wv[xv] > L) L = wv[xv];
+            if (wv[yv] > L) L = wv[yv];
+            if (rv[yv] > L) L = rv[yv];
+            L += 1;
+            lvl[i] = L;
+            wu[xu] = L;
+            if (L > ru[yu]) ru[yu] = L;
+            if (L > rv[xv]) rv[xv] = L;
+            wv[yv] = L;
+            if (L > nlev) nlev = L;
+        }
+        start = (long *)calloc((size_t)nlev + 2, sizeof(long));
+        order = (int *)malloc((size_t)n * sizeof(int));
+        if (start != NULL && order != NULL) {
+            for (long i = 1; i < n; i++) start[lvl[i]] += 1;
+            long acc = 0;
+            for (int L = 1; L <= nlev; L++) {
+                const long cnt = start[L];
+                start[L] = acc;
+                acc += cnt;
+            }
+            start[nlev + 1] = acc;
+            for (long i = 1; i < n; i++) {
+                order[start[lvl[i]]] = (int)i;
+                start[lvl[i]] += 1;
+            }
+            /* now level L occupies order[start[L-1] .. start[L]) with start[0] == 0 */
+        }
+    }
+    free(lvl); free(wu); free(ru); free(wv); free(rv);
+
+    const int scheduled = (start != NULL && order != NULL);
+
     for (int nl = 0; nl < R; nl++) {
-        for (long i = 1; i < LEN_1D; i++) {
-            u[ju[i]] += v[kv[i]] * c[i];
-            v[jv[i]] = u[ku[i]] * d[i] + c[i];
+        if (scheduled) {
+            /* Executor: levels in order; the iterations of one level are
+             * write-disjoint and independent of each other. */
+            for (int L = 1; L <= nlev; L++) {
+                const long pb = start[L - 1];
+                const long pe = start[L];
+ #pragma omp parallel for firstprivate(pb,pe) shared(order) 
+                for (long p = pb; p < pe; p++) {
+                    const long i = (long)order[p];
+                    u[ju[i]] += v[kv[i]] * c[i];
+                    v[jv[i]] = u[ku[i]] * d[i] + c[i];
+                }
+            }
+        } else {
+            /* allocation failed: plain sequential evaluation */
+            for (long i = 1; i < n; i++) {
+                u[ju[i]] += v[kv[i]] * c[i];
+                v[jv[i]] = u[ku[i]] * d[i] + c[i];
+            }
         }
         pb_mix(nl);
     }
+    free(start); free(order);
     return (real_t)0;
 }
 
