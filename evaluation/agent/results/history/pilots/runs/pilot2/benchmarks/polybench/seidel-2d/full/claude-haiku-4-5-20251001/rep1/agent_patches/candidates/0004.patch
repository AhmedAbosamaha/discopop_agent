+
+    /* Implicit barrier here. */
+
+    /* Red-black phase 2: update even-indexed rows in parallel.
+       Even rows (2,4,6,...) read from fresh odd rows and stale even rows, so no race.
+       Loop variable i is automatic private; j is a nested loop variable so use lastprivate. */
+    #pragma omp parallel for lastprivate(j)
+    for (i = 2; i <= _PB_N - 2; i += 2)
+      for (j = 1; j <= _PB_N - 2; j++)
+	A[i][j] = (A[i-1][j-1] + A[i-1][j] + A[i-1][j+1]
+		   + A[i][j-1] + A[i][j] + A[i][j+1]
+		   + A[i+1][j-1] + A[i+1][j] + A[i+1][j+1])/9.0;
+  }
 }
 
 