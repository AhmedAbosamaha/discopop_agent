+  for (t = 0; t <= _PB_TSTEPS - 1; t++) {
+    /* Red-black phase 1: update odd-indexed rows in parallel.
+       Odd rows (1,3,5,...) read from stale even rows and boundary, so no race.
+       Loop variable i is automatic private; j is a nested loop variable so use lastprivate. */
+    #pragma omp parallel for lastprivate(j)
+    for (i = 1; i <= _PB_N - 2; i += 2)
       for (j = 1; j <= _PB_N - 2; j++)
 	A[i][j] = (A[i-1][j-1] + A[i-1][j] + A[i-1][j+1]
