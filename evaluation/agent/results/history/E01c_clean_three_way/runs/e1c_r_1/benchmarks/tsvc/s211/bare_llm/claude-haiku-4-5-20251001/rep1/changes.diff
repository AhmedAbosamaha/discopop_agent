@@ -131,10 +131,24 @@
 static real_t kernel_s211(void)
 {
     for (int nl = 0; nl < R; nl++) {
+        /* Phase 1: Compute all a[i] in parallel, reading from current b.
+           Each iteration i reads b[i-1], c[i], d[i] and writes a[i].
+           No iteration writes values that another iteration reads. */
+        #pragma omp parallel for schedule(static) \
+            shared(a, b, c, d)
         for (int i = 1; i < LEN_1D-1; i++) {
             a[i] = b[i - 1] + c[i] * d[i];
+        }
+
+        /* Phase 2: Update all b[i] in parallel, reading from current b.
+           Each iteration i reads b[i+1], e[i], d[i] and writes b[i].
+           No iteration writes values that another iteration reads. */
+        #pragma omp parallel for schedule(static) \
+            shared(b, e, d)
+        for (int i = 1; i < LEN_1D-1; i++) {
             b[i] = b[i + 1] - e[i] * d[i];
         }
+
         pb_mix(nl);
     }
     return (real_t)0;
