 static real_t kernel_s112(void)
 {
+    /* Allocate temporary buffer to hold original values of a before each
+     * inner loop iteration. This allows parallelization by breaking the
+     * anti-dependence in the backward loop. */
+    real_t* a_old = (real_t*)malloc((size_t)LEN_1D * sizeof(real_t));
+
     for (int nl = 0; nl < R; nl++) {
-        for (int i = LEN_1D - 2; i >= 0; i--) {
-            a[i+1] = a[i] + b[i];
+        /* Copy current values of a into a_old. This preserves the original
+         * values before the inner loop modifies a. */
+        memcpy(a_old, a, (size_t)LEN_1D * sizeof(real_t));
+
+        /* Parallelize the inner loop: each iteration i independently reads from
+         * a_old[i] and b[i] (immutable snapshot), and writes to a[i+1].
+         * No iteration writes to an element that another iteration reads,
+         * eliminating dependencies. The loop computes the same result as the
+         * original backward loop, since each a[i+1] depends only on original
+         * values of a[i] and b[i].
+         *
+         * Data-sharing:
+         * - a: shared (written to by different iterations at different indices)
+         * - b: shared (read-only)
+         * - a_old: shared (read-only snapshot of original a values)
+         * - i: private (loop variable, automatic) */
+        #pragma omp parallel for shared(a, b, a_old)
+        for (int i = 0; i < LEN_1D - 1; i++) {
+            a[i+1] = a_old[i] + b[i];
         }
         pb_mix(nl);
     }
+
+    free(a_old);
     return (real_t)0;
 }
 
