@@ -131,11 +131,21 @@
 static real_t kernel_s243(void)
 {
     for (int nl = 0; nl < R; nl++) {
+        /* Save snapshot of a array to eliminate loop-carry dependence on a[i+1].
+         * This allows the inner loop iterations to be independent and parallel.
+         * Semantically, the original loop reads a[i+1] before iteration i+1 modifies it;
+         * we preserve this by always reading from the saved snapshot. */
+        real_t *a_old = (real_t*)malloc((size_t)LEN_1D * sizeof(real_t));
+        memcpy(a_old, a, (size_t)LEN_1D * sizeof(real_t));
+
+        #pragma omp parallel for shared(a, b, c, d, e, a_old)
         for (int i = 0; i < LEN_1D-1; i++) {
             a[i] = b[i] + c[i  ] * d[i];
             b[i] = a[i] + d[i  ] * e[i];
-            a[i] = b[i] + a[i+1] * d[i];
+            a[i] = b[i] + a_old[i+1] * d[i];
         }
+
+        free(a_old);
         pb_mix(nl);
     }
     return (real_t)0;
