 static real_t kernel_s244(void)
 {
+    // Create a read-only buffer for a[i+1] values to break loop-carried dependence
+    // within the inner loop, while preserving cumulative evolution across nl iterations
+    real_t *a_read = (real_t *)malloc((size_t)LEN_1D * sizeof(real_t));
+    for (int i = 0; i < LEN_1D; ++i) {
+        a_read[i] = a[i];
+    }
+
     for (int nl = 0; nl < R; nl++) {
         for (int i = 0; i < LEN_1D-1; ++i) {
             a[i] = b[i] + c[i] * d[i];
             b[i] = c[i] + b[i];
-            a[i+1] = b[i] + a[i+1] * d[i];
+            a[i+1] = b[i] + a_read[i+1] * d[i];
         }
         pb_mix(nl);
+        // Update the read buffer to reflect the evolved state after pb_mix
+        for (int i = 0; i < LEN_1D; ++i) {
+            a_read[i] = a[i];
+        }
     }
+
+    free(a_read);
     return (real_t)0;
 }
 