@@ -131,11 +131,29 @@
 static real_t kernel_s243(void)
 {
     for (int nl = 0; nl < R; nl++) {
+        /* Allocate temporary array to hold a[i+1] before we modify a in parallel.
+         * This removes the loop-carried dependence: iteration i reads a[i+1],
+         * iteration i+1 writes a[i+1]. By saving a[i+1] first, we capture the
+         * location-reuse dependence, making iterations independent. */
+        real_t *a_next = (real_t*)malloc((size_t)(LEN_1D-1) * sizeof(real_t));
+
+        /* Copy a[i+1] into a_next[i] for all i, before any modifications */
+        for (int i = 0; i < LEN_1D-1; i++) {
+            a_next[i] = a[i+1];
+        }
+
+        /* Parallelize the main computation. Each iteration i:
+         * - reads: a_next[i], b[i], c[i], d[i], e[i]
+         * - writes: a[i], b[i]
+         * No cross-iteration dependences; different iterations access different array indices. */
+        #pragma omp parallel for
         for (int i = 0; i < LEN_1D-1; i++) {
             a[i] = b[i] + c[i  ] * d[i];
             b[i] = a[i] + d[i  ] * e[i];
-            a[i] = b[i] + a[i+1] * d[i];
+            a[i] = b[i] + a_next[i] * d[i];
         }
+
+        free(a_next);
         pb_mix(nl);
     }
     return (real_t)0;
