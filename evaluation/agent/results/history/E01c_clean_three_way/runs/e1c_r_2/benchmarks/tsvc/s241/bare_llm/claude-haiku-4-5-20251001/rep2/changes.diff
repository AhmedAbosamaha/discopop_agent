 static real_t kernel_s241(void)
 {
     for (int nl = 0; nl < R; nl++) {
+        /* Pass 1: Compute a[i] independently for all i.
+         * Each iteration i writes only a[i], reads b[i], c[i], d[i] (all from different locations).
+         * No loop-carried dependencies within this pass. */
+        #pragma omp parallel for shared(a, b, c, d)
         for (int i = 0; i < LEN_1D-1; i++) {
             a[i] = b[i] * c[i  ] * d[i];
+        }
+        /* Pass 2: Compute b[i] independently for all i, using a[i] computed in pass 1.
+         * Each iteration i writes only b[i], reads a[i], a[i+1], d[i] (all from different locations).
+         * No loop-carried dependencies within this pass (a[i] and a[i+1] are fully computed from pass 1). */
+        #pragma omp parallel for shared(a, b, d)
+        for (int i = 0; i < LEN_1D-1; i++) {
             b[i] = a[i] * a[i+1] * d[i];
         }
