 static real_t kernel_s323(void)
 {
     for (int nl = 0; nl < R; nl++) {
+        /* Phase 1: compute all a[i] in parallel; each iteration reads b[i-1]
+           (from prior outer loop), c[i], d[i]; no cross-iteration dependence */
+        #pragma omp parallel for shared(a, b, c, d)
         for (int i = 1; i < LEN_1D; i++) {
             a[i] = b[i-1] + c[i] * d[i];
+        }
+
+        /* Phase 2: compute all b[i] in parallel; each iteration reads the
+           newly computed a[i] and c[i], e[i]; no cross-iteration dependence */
+        #pragma omp parallel for shared(a, b, c, e)
+        for (int i = 1; i < LEN_1D; i++) {
             b[i] = a[i] + c[i] * e[i];
         }
+
         pb_mix(nl);
     }
     return (real_t)0;
