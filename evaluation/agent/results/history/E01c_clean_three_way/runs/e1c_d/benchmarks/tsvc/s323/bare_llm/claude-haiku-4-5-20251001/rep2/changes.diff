 static real_t kernel_s323(void)
 {
+    real_t *prefix = (real_t*)malloc((size_t)LEN_1D * sizeof(real_t));
+    if (!prefix) { fprintf(stderr, "out of memory\n"); return (real_t)0; }
+
     for (int nl = 0; nl < R; nl++) {
+        /* Compute prefix sum of c[i] * (d[i] + e[i]) sequentially.
+         * This breaks the loop-carried dependence on b[i-1].
+         * prefix[i] = sum of c[j] * (d[j] + e[j]) for j = 1 to i
+         */
+        prefix[0] = (real_t)0.0;
+        for (int i = 1; i < LEN_1D; i++) {
+            prefix[i] = prefix[i-1] + c[i] * (d[i] + e[i]);
+        }
+
+        /* Compute b[i] in parallel.
+         * b[i] = b[0] + prefix[i], where prefix[i] contains the cumulative sum.
+         * Each iteration is independent of others since prefix is precomputed.
+         */
+        real_t b_base = b[0];
+        #pragma omp parallel for shared(b_base, prefix) private(i)
+        for (int i = 1; i < LEN_1D; i++) {
+            b[i] = b_base + prefix[i];
+        }
+
+        /* Compute a[i] in parallel.
+         * a[i] = b[i-1] + c[i] * d[i].
+         * Each iteration is independent: reads different b[i-1], c[i], d[i]
+         * and writes to unique a[i].
+         */
+        #pragma omp parallel for shared(a, b, c, d) private(i)
         for (int i = 1; i < LEN_1D; i++) {
             a[i] = b[i-1] + c[i] * d[i];
-            b[i] = a[i] + c[i] * e[i];
         }
+
         pb_mix(nl);
     }
+
+    free(prefix);
     return (real_t)0;
 }
 
