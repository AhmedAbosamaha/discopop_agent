@@ -130,12 +130,23 @@
 
 static real_t kernel_s321(void)
 {
+    // Allocate temporary buffer on heap for each activation
+    double* delta = (double*)malloc(LEN_1D * sizeof(double));
+    if (!delta) return (real_t)0;
+
     for (int nl = 0; nl < R; nl++) {
+        // First pass: compute products (no loop-carried dependence: delta[i] reads a[i-1], which is never written in this loop)
         for (int i = 1; i < LEN_1D; i++) {
-            a[i] += a[i-1] * b[i];
+            delta[i] = a[i-1] * b[i];
+        }
+        // Second pass: apply the deltas (no loop-carried dependence: each a[i] is independent)
+        for (int i = 1; i < LEN_1D; i++) {
+            a[i] += delta[i];
         }
         pb_mix(nl);
     }
+
+    free(delta);
     return (real_t)0;
 }
 