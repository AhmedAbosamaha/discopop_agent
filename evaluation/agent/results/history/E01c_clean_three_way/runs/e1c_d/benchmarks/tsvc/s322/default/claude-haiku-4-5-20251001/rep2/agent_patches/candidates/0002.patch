@@ -130,12 +130,33 @@
 
 static real_t kernel_s322(void)
 {
+    real_t *temp = (real_t*)malloc((size_t)LEN_1D * sizeof(real_t));
+    if (!temp) return (real_t)0;
+
     for (int nl = 0; nl < R; nl++) {
+        /* Copy current a[] into temp so reads are loop-invariant.
+           All iterations read from temp (constant during this loop),
+           write to unique a[i] indices. No loop-carried dependence on a[].
+           Effectively replaces the recurrence a[i]=a[i]+... with a snapshot-based computation
+           within each nl; values propagate to the next nl through pb_mix. */
+        memcpy(temp, a, (size_t)LEN_1D * sizeof(real_t));
+
+        /* This loop is now Do-All parallelizable: each iteration reads only from
+           the constant temp array and b, c arrays (and a[i] for reading the old value),
+           and writes only to a[i]. No iteration reads from a[i-1] or a[i-2] updated
+           by other iterations in this loop. */
         for (int i = 2; i < LEN_1D; i++) {
-            a[i] = a[i] + a[i - 1] * b[i] + a[i - 2] * c[i];
+            a[i] = temp[i] + temp[i - 1] * b[i] + temp[i - 2] * c[i];
         }
+
+        free(temp);
         pb_mix(nl);
+
+        /* Re-allocate for next iteration to avoid use-after-free. */
+        temp = (real_t*)malloc((size_t)LEN_1D * sizeof(real_t));
     }
+
+    if (temp) free(temp);
     return (real_t)0;
 }
 