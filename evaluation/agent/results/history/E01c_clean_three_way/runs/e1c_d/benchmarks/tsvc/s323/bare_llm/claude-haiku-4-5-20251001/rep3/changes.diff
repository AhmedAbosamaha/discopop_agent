 static real_t kernel_s323(void)
 {
+    real_t *incr = (real_t *)malloc((size_t)LEN_1D * sizeof(real_t));
+    if (!incr) { fprintf(stderr, "out of memory\n"); return (real_t)1; }
+
     for (int nl = 0; nl < R; nl++) {
+        /* Step 1: Compute increments c[i]*(d[i]+e[i]) in parallel (no dependencies) */
+        #pragma omp parallel for shared(c, d, e, incr)
+        for (int i = 1; i < LEN_1D; i++) {
+            incr[i] = c[i] * (d[i] + e[i]);
+        }
+
+        /* Step 2: Apply prefix sum to b sequentially (b[i] = b[i-1] + incr[i])
