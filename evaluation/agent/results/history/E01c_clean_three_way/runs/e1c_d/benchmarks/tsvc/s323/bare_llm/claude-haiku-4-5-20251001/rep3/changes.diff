+           dependence from the original inter-twined a/b computation. */
+        for (int i = 1; i < LEN_1D; i++) {
+            b[i] = b[i-1] + incr[i];
+        }
+
+        /* Step 3: Compute a[i] = b[i-1] + c[i]*d[i] in parallel
+           (reads newly computed b; each iteration writes disjoint a[i]) */
+        #pragma omp parallel for shared(a, b, c, d)
         for (int i = 1; i < LEN_1D; i++) {
             a[i] = b[i-1] + c[i] * d[i];
-            b[i] = a[i] + c[i] * e[i];
         }
+
         pb_mix(nl);
     }
+
+    free(incr);
     return (real_t)0;
 }
 
