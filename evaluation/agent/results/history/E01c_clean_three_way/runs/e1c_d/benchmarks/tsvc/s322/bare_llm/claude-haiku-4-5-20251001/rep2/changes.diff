@@ -130,12 +130,27 @@
 
 static real_t kernel_s322(void)
 {
+    real_t *a_snapshot = (real_t*)malloc((size_t)LEN_1D * sizeof(real_t));
+    if (!a_snapshot) return (real_t)0;
+
     for (int nl = 0; nl < R; nl++) {
+        /* Capture the state of array 'a' at the start of the inner loop iteration.
+           This breaks the loop-carried dependence: each iteration will read from
+           a_snapshot (constant across the loop) rather than from a (being updated).
+           This allows all iterations to execute independently in parallel. */
+        memcpy(a_snapshot, a, (size_t)LEN_1D * sizeof(real_t));
+
+        /* Parallel inner loop: each iteration i is now independent because it reads
+           a[i-1] and a[i-2] from a_snapshot, not from the being-updated 'a' array.
+           Variables: a, b, c are shared (b, c are read-only; a is written to);
+           a_snapshot is shared (read-only within the loop); i is private (implicit). */
+        #pragma omp parallel for schedule(static) shared(a, b, c, a_snapshot)
         for (int i = 2; i < LEN_1D; i++) {
-            a[i] = a[i] + a[i - 1] * b[i] + a[i - 2] * c[i];
+            a[i] = a_snapshot[i] + a_snapshot[i - 1] * b[i] + a_snapshot[i - 2] * c[i];
         }
         pb_mix(nl);
     }
+    free(a_snapshot);
     return (real_t)0;
 }
 
