 static real_t kernel_s322(void)
 {
+    real_t *temp = (real_t*)malloc((size_t)LEN_1D * sizeof(real_t));
+    if (!temp) return (real_t)0;
+
     for (int nl = 0; nl < R; nl++) {
+        /* First pass: compute all updates independently (Do-All parallelizable).
+           Each iteration reads only from a[], b[], c[] which remain constant during this pass,
+           and writes to a unique location in temp[]. No loop-carried dependence. */
         for (int i = 2; i < LEN_1D; i++) {
-            a[i] = a[i] + a[i - 1] * b[i] + a[i - 2] * c[i];
+            temp[i] = a[i] + a[i - 1] * b[i] + a[i - 2] * c[i];
+        }
+
+        /* Second pass: apply all updates to a[]. */
+        for (int i = 2; i < LEN_1D; i++) {
+            a[i] = temp[i];
         }
         pb_mix(nl);
     }
+
+    free(temp);
     return (real_t)0;
 }
 