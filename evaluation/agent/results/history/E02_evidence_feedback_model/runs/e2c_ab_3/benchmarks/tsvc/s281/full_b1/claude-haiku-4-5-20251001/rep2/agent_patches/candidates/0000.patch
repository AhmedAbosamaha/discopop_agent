 static real_t kernel_s281(void)
 {
     real_t x;
+
+    /* Temporary arrays to break loop-carried dependence on a and b.
+     * Split the loop into two phases: each phase has no internal loop-carried
+     * dependencies and can be parallelized. Phase 1 reads original values from
+     * the second half of a, phase 2 reads updated values from the first half. */
+    real_t *temp_a = (real_t *)malloc(LEN_1D * sizeof(real_t));
+    real_t *temp_b = (real_t *)malloc(LEN_1D * sizeof(real_t));
+
     for (int nl = 0; nl < R; nl++) {
+        /* Copy current state to temporary arrays */
         for (int i = 0; i < LEN_1D; i++) {
-            x = a[LEN_1D-i-1] + b[i] * c[i];
-            a[i] = x-(real_t)1.0;
-            b[i] = x;
-        }
+            temp_a[i] = a[i];
+            temp_b[i] = b[i];
+        }
+
+        /* Phase 1: process iterations 0 to LEN_1D/2-1.
+         * Each iteration reads from a[LEN_1D-1-i] in the second half (unchanged)
+         * and writes to a[i] in the first half. No internal loop-carried deps. */
+        for (int i = 0; i < LEN_1D/2; i++) {
+            x = temp_a[LEN_1D-i-1] + temp_b[i] * c[i];
+            temp_a[i] = x-(real_t)1.0;
+            temp_b[i] = x;
+        }
+
+        /* Phase 2: process iterations LEN_1D/2 to LEN_1D-1.
+         * Each iteration reads from a[LEN_1D-1-i] in the first half (now updated
+         * by phase 1) and writes to a[i] in the second half. No internal loop-carried deps. */
+        for (int i = LEN_1D/2; i < LEN_1D; i++) {
+            x = temp_a[LEN_1D-i-1] + temp_b[i] * c[i];
+            temp_a[i] = x-(real_t)1.0;
+            temp_b[i] = x;
+        }
+
+        /* Copy results back to original arrays */
+        for (int i = 0; i < LEN_1D; i++) {
+            a[i] = temp_a[i];
+            b[i] = temp_b[i];
+        }
+
         pb_mix(nl);
     }
+
+    free(temp_a);
+    free(temp_b);
+
     return (real_t)0;
 }
 