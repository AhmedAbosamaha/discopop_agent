--- s1213.c
+++ s1213.c
@@ -130,13 +130,25 @@
 
 static real_t kernel_s1213(void)
 {
+    /* Allocate snapshot of 'a' to break forward dependence on a[i+1]:
+     * iteration i reads a_old[i+1] (value before this nl-iteration started)
+     * instead of a[i+1] (which might be modified by iteration i+1).
+     * This preserves correctness: in sequential, iteration i also reads
+     * a[i+1] before iteration i+1 modifies it. */
+    real_t *a_old = (real_t*)malloc((size_t)LEN_1D * sizeof(real_t));
+    if (!a_old) { fprintf(stderr, "out of memory\n"); return (real_t)0; }
+
     for (int nl = 0; nl < R; nl++) {
+        /* Save 'a' at start of this nl-iteration */
+        memcpy(a_old, a, (size_t)LEN_1D * sizeof(real_t));
+
         for (int i = 1; i < LEN_1D-1; i++) {
             a[i] = b[i-1]+c[i];
-            b[i] = a[i+1]*d[i];
+            b[i] = a_old[i+1]*d[i];
         }
         pb_mix(nl);
     }
+    free(a_old);
     return (real_t)0;
 }
 