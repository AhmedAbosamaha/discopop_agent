@@ -131,15 +131,27 @@
 static real_t kernel_s252(void)
 {
     real_t t, s;
+    real_t* s_array = (real_t*)malloc(LEN_1D * sizeof(real_t));
+    if (!s_array) return (real_t)0;
+
     for (int nl = 0; nl < R; nl++) {
+        // First pass: compute s[i] = b[i] * c[i] for all i (Do-All, parallelizable)
+        for (int i = 0; i < LEN_1D; i++) {
+            s_array[i] = b[i] * c[i];
+        }
+
+        // Second pass: compute a[i] = s[i] + previous_s (sequential dependence)
         t = (real_t) 0.;
         for (int i = 0; i < LEN_1D; i++) {
-            s = b[i] * c[i];
+            s = s_array[i];
             a[i] = s + t;
             t = s;
         }
+
         pb_mix(nl);
     }
+
+    free(s_array);
     return (real_t)0;
 }
 