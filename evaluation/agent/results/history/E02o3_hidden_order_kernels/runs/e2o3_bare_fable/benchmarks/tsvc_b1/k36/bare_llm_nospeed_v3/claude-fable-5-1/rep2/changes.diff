+            }
+            #pragma omp parallel for shared(u, v, c)
+            for (long i = 1; i < LEN_1D; i++) {
+                u[i] += AT1(v, i) * c[i];
+            }
+        } else if (mode == 3) {
+            #pragma omp parallel for shared(v, vold)
+            for (long i = 0; i < LEN_1D; i++) {
+                vold[i] = v[i];
+            }
+            #pragma omp parallel for shared(u, v, c, d)
+            for (long i = 1; i < LEN_1D; i++) {
+                v[i] = AT2(u, i) * d[i] + c[i];
+            }
+            #pragma omp parallel for shared(u, vold, c)
