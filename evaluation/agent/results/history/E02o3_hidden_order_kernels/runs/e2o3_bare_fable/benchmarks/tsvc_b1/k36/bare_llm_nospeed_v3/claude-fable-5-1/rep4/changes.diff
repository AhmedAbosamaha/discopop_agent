 /* Kernel k36. */
 #include "tsvc_b1/k36.h"
+#include <stdlib.h>
 
 /* Between two repetitions a few INPUT elements change, so no repetition can be skipped,
  * merged with another or run out of order: the repetition loop is sequential by a true
@@ -14,13 +15,71 @@
 
 static real_t kernel_k36(void)
 {
+    /* Scratch buffer: first used as an index probe to learn which neighbours
+     * AT1/AT2 read, then as the temporary copy of the new v in the
+     * "both statements read old values" case. */
+    real_t *tmp = (real_t *)malloc(sizeof(real_t) * (size_t)LEN_1D);
+
+#pragma omp parallel for shared(tmp)
+    for (long j = 0; j < LEN_1D; j++) {
+        tmp[j] = (real_t)j;
+    }
+
+    const long mid = LEN_1D / 2;
+    const long idx1 = (long)AT1(tmp, mid);   /* index of v read by the u statement */
+    const long idx2 = (long)AT2(tmp, mid);   /* index of u read by the v statement */
+    /* u statement reads v at an index not yet rewritten in this sweep (>= i). */
+    const int u_reads_old_v = (idx1 >= mid);
+    /* v statement reads u at an index not yet updated in this sweep (> i). */
+    const int v_reads_old_u = (idx2 > mid);
+
     for (int nl = 0; nl < R; nl++) {
-        for (long i = 1; i < LEN_1D; i++) {
-            u[i] += AT1(v, i) * c[i];
-            v[i] = AT2(u, i) * d[i] + c[i];
+        if (u_reads_old_v && !v_reads_old_u) {
+            /* u depends only on old v; v depends on the finished u. */
+#pragma omp parallel for shared(u, v, c)
+            for (long i = 1; i < LEN_1D; i++) {
+                u[i] += AT1(v, i) * c[i];
+            }
+#pragma omp parallel for shared(u, v, c, d)
+            for (long i = 1; i < LEN_1D; i++) {
+                v[i] = AT2(u, i) * d[i] + c[i];
+            }
+        } else if (!u_reads_old_v && v_reads_old_u) {
+            /* v depends only on old u; u depends on the finished v. */
+#pragma omp parallel for shared(u, v, c, d)
+            for (long i = 1; i < LEN_1D; i++) {
+                v[i] = AT2(u, i) * d[i] + c[i];
+            }
+#pragma omp parallel for shared(u, v, c)
+            for (long i = 1; i < LEN_1D; i++) {
+                u[i] += AT1(v, i) * c[i];
+            }
+        } else if (u_reads_old_v && v_reads_old_u) {
+            /* Both read only old values: build new v in tmp from old u,
+             * update u from old v, then publish v. */
+#pragma omp parallel for shared(u, c, d, tmp)
+            for (long i = 1; i < LEN_1D; i++) {
+                tmp[i] = AT2(u, i) * d[i] + c[i];
+            }
+#pragma omp parallel for shared(u, v, c)
+            for (long i = 1; i < LEN_1D; i++) {
+                u[i] += AT1(v, i) * c[i];
+            }
+#pragma omp parallel for shared(v, tmp)
+            for (long i = 1; i < LEN_1D; i++) {
+                v[i] = tmp[i];
+            }
+        } else {
+            /* Genuine two-way recurrence: no legal split, keep original order. */
+            for (long i = 1; i < LEN_1D; i++) {
+                u[i] += AT1(v, i) * c[i];
+                v[i] = AT2(u, i) * d[i] + c[i];
+            }
         }
         pb_mix(nl);
     }
+
+    free(tmp);
     return (real_t)0;
 }
 
