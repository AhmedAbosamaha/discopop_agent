 static real_t kernel_k31(void)
 {
+    const long OFF = (long)(off);
+    const long FAR = (long)(far);
+    real_t *tmp = (real_t *)malloc(sizeof(real_t) * (size_t)LEN_1D);
     for (int nl = 0; nl < R; nl++) {
