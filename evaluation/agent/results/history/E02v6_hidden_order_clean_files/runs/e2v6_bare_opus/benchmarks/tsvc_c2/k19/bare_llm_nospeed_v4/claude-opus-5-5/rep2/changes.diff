+#pragma omp parallel for schedule(static) firstprivate(lo, hi) shared(order)
+            for (long k = lo; k < hi; k++) {
+                long i = order[k];
+                u[ju[i]] += v[kv[i]] * c[i];
+                v[jv[i]] = u[ku[i]] * d[i] + c[i];
