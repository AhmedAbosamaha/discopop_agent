--- s244.c
+++ s244.c
@@ -130,14 +130,28 @@
 
 static real_t kernel_s244(void)
 {
+    real_t *a_saved = (real_t*)malloc((size_t)LEN_1D * sizeof(real_t));
+    if (!a_saved) { fprintf(stderr, "out of memory\n"); return (real_t)0; }
+
     for (int nl = 0; nl < R; nl++) {
+        /* Capture all a[i+1] values BEFORE any iteration modifies them,
+           breaking the loop-carried RAW: iteration i reads a[i+1],
+           iteration i+1 writes a[i+1]. */
+        for (int i = 0; i < LEN_1D-1; ++i) {
+            a_saved[i] = a[i+1];
+        }
+
+        /* Each iteration now reads from the constant saved array,
+           eliminating the loop-carried RAW within this loop. */
         for (int i = 0; i < LEN_1D-1; ++i) {
             a[i] = b[i] + c[i] * d[i];
             b[i] = c[i] + b[i];
-            a[i+1] = b[i] + a[i+1] * d[i];
+            a[i+1] = b[i] + a_saved[i] * d[i];
         }
         pb_mix(nl);
     }
+
+    free(a_saved);
     return (real_t)0;
 }
 