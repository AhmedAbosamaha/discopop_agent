+        /* Parallel prefix sum via chunking */
+        int chunk_size = 1024;
+        int num_chunks = (LEN_1D + chunk_size - 1) / chunk_size;
+        real_t* chunk_sums = (real_t*)malloc(num_chunks * sizeof(real_t));
+
+        /* Phase 1: Compute local cumulative sums within each chunk */
+        for (int chunk = 0; chunk < num_chunks; chunk++) {
+            real_t local_sum = (real_t)0.0;
+            int start = chunk * chunk_size;
+            int end = (start + chunk_size < LEN_1D) ? (start + chunk_size) : LEN_1D;
+            for (int i = start; i < end; i++) {
+                local_sum += a[i];
+                b[i] = local_sum;
+            }
+            chunk_sums[chunk] = local_sum;
         }
+
+        /* Phase 2: Compute prefix sums of chunk totals (sequential) */
+        real_t prefix = (real_t)0.0;
+        for (int chunk = 0; chunk < num_chunks; chunk++) {
+            real_t chunk_total = chunk_sums[chunk];
+            chunk_sums[chunk] = prefix;
+            prefix += chunk_total;
+        }
+
+        /* Phase 3: Add chunk prefix to all elements in each chunk (parallel opportunity) */
+        for (int chunk = 0; chunk < num_chunks; chunk++) {
+            int start = chunk * chunk_size;
+            int end = (start + chunk_size < LEN_1D) ? (start + chunk_size) : LEN_1D;
+            for (int i = start; i < end; i++) {
+                b[i] += chunk_sums[chunk];
+            }
+        }
+
+        sum = prefix;
+        free(chunk_sums);
         pb_mix(nl);
     }
