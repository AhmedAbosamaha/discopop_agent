+        // Repeat odd-even passes until full propagation: each pair allows information to travel
+        // distance 2 farther, so after k pairs we reach distance 2^k.
+        // For distance LEN_1D, need ceil(log2(LEN_1D)) ~15 pairs. Use 20 to be safe.
+        for (int pass_pair = 0; pass_pair < 20; pass_pair++) {
