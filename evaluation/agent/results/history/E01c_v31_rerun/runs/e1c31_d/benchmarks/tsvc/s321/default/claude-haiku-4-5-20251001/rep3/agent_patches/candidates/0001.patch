+                a[i] += a[i-1] * b[i];
+            }
+            // Process even indices: no dependencies within this pass
+            for (int i = 2; i < LEN_1D; i += 2) {
+                a[i] += a[i-1] * b[i];
+            }
         }
         pb_mix(nl);
     }