 static real_t kernel_k19(void)
 {
+    /* Inspector (index arrays are invariant across nl): assign each iteration a
+     * wavefront level so that conflicting iterations keep their original order
+     * and iterations within one level are mutually independent. */
+    long umax = 0, vmax = 0;
+    for (long i = 1; i < LEN_1D; i++) {
+        long x;
+        x = (long)ju[i]; if (x > umax) umax = x;
+        x = (long)ku[i]; if (x > umax) umax = x;
+        x = (long)jv[i]; if (x > vmax) vmax = x;
+        x = (long)kv[i]; if (x > vmax) vmax = x;
+    }
+    int *uW = (int *)malloc((size_t)(umax + 1) * sizeof(int));
+    int *uA = (int *)malloc((size_t)(umax + 1) * sizeof(int));
+    int *vW = (int *)malloc((size_t)(vmax + 1) * sizeof(int));
+    int *vA = (int *)malloc((size_t)(vmax + 1) * sizeof(int));
+    int *lev = (int *)malloc((size_t)LEN_1D * sizeof(int));
+    for (long x = 0; x <= umax; x++) { uW[x] = -1; uA[x] = -1; }
+    for (long x = 0; x <= vmax; x++) { vW[x] = -1; vA[x] = -1; }
+    int nlev = 0;
+    for (long i = 1; i < LEN_1D; i++) {
+        long a1 = (long)ju[i], a2 = (long)ku[i];
+        long b1 = (long)kv[i], b2 = (long)jv[i];
+        int L = 0;
+        /* u[a1]: read+write */
+        if (uA[a1] + 1 > L) L = uA[a1] + 1;
+        /* u[a2]: read */
+        if (uW[a2] + 1 > L) L = uW[a2] + 1;
+        /* v[b1]: read */
+        if (vW[b1] + 1 > L) L = vW[b1] + 1;
+        /* v[b2]: write */
+        if (vA[b2] + 1 > L) L = vA[b2] + 1;
+        lev[i] = L;
+        uW[a1] = L; if (L > uA[a1]) uA[a1] = L;
+        if (L > uA[a2]) uA[a2] = L;
+        if (L > vA[b1]) vA[b1] = L;
+        vW[b2] = L; if (L > vA[b2]) vA[b2] = L;
+        if (L + 1 > nlev) nlev = L + 1;
+    }
+    free(uW); free(uA); free(vW); free(vA);
+
+    long *start = (long *)malloc((size_t)(nlev + 1) * sizeof(long));
+    long *order = (long *)malloc((size_t)LEN_1D * sizeof(long));
+    for (int L = 0; L <= nlev; L++) start[L] = 0;
+    for (long i = 1; i < LEN_1D; i++) start[lev[i] + 1]++;
+    for (int L = 0; L < nlev; L++) start[L + 1] += start[L];
+    {
+        long *pos = (long *)malloc((size_t)(nlev + 1) * sizeof(long));
+        for (int L = 0; L <= nlev; L++) pos[L] = start[L];
+        for (long i = 1; i < LEN_1D; i++) order[pos[lev[i]]++] = i;
+        free(pos);
+    }
+    free(lev);
+
+    /* Executor: levels in order, iterations inside a level independent. */
     for (int nl = 0; nl < R; nl++) {
-        for (long i = 1; i < LEN_1D; i++) {
-            u[ju[i]] += v[kv[i]] * c[i];
-            v[jv[i]] = u[ku[i]] * d[i] + c[i];
+        for (int L = 0; L < nlev; L++) {
+            long lo = start[L], hi = start[L + 1];
+            for (long k = lo; k < hi; k++) {
+                long i = order[k];
+                u[ju[i]] += v[kv[i]] * c[i];
+                v[jv[i]] = u[ku[i]] * d[i] + c[i];
+            }
         }
         pb_mix(nl);
     }
+    free(start);
+    free(order);
     return (real_t)0;
 }
 