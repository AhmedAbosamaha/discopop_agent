@@ -14,10 +14,25 @@
 
 static real_t kernel_k19(void)
 {
+    /* Scratch for the values that are scattered into v.  Static storage, the
+     * same kind the program's own arrays use -- never on the stack. */
+    static real_t w[LEN_1D];
+
     for (int nl = 0; nl < R; nl++) {
+        /* The elements u[ku[i]] are never among the elements u[ju[i]] that the
+         * gather/scatter below updates, so every value destined for v depends
+         * only on data this repetition does not modify.  Each iteration here
+         * writes only its own w[i]: no dependence between iterations. */
+        #pragma omp parallel for 
+        for (long i = 1; i < LEN_1D; i++) {
+            w[i] = u[ku[i]] * d[i] + c[i];
+        }
+        /* Order-dependent part, kept in the original iteration order: each
+         * read of v[kv[i]] must see exactly the stores to v that preceded it,
+         * and the indirect update of u is applied as before. */
         for (long i = 1; i < LEN_1D; i++) {
             u[ju[i]] += v[kv[i]] * c[i];
-            v[jv[i]] = u[ku[i]] * d[i] + c[i];
+            v[jv[i]] = w[i];
         }
         pb_mix(nl);
     }
