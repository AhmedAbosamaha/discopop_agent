# working directories of the harness: regenerated or fetched, never tracked
agent/runs/
agent/prepared/
agent/prepared_single/
# Working directory for combined analyses. Git cannot un-ignore a file inside an ignored
# DIRECTORY, so the outputs the thesis quotes are copied into the tracked archive instead —
# `agent/benchmark plots` prints the command, and agent/results/_analysis/ holds them.
agent/analysis/
__pycache__/
*.pyc
.DS_Store
# the server's address and account (never tracked)
agent/tools/server.local
# the repository's root .gitignore has `data*/`, which would swallow PolyBench's datamining/ kernels
!benchmarks/polybench-c-3.2/datamining/
