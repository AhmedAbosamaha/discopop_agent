/*
 * example2.cpp  —  DiscoPoP Agentic Controller: Tier-2 demonstration
 *
 * Three compute functions.  DiscoPoP's pattern detectors work at the
 * LOOP level; they never emit a pattern for an entire function body.
 * The L1 planner therefore classifies every FUNCTION node (type=1 in
 * Data.xml) as a Tier-2 candidate and sends it to the LLM.
 *
 * Each function has a structural issue that prevents clean parallelisation
 * and has a clear, semantics-preserving LLM fix:
 *
 *  scalar_transform   — `float temp` declared OUTSIDE the loop creates a
 *                       WAR dependency on the stack slot across iterations.
 *                       Fix: move the declaration inside the loop body.
 *                       Result: Do-All on re-profiling.
 *
 *  normalize_fused    — Running maximum and normalisation are fused in one
 *                       pass.  `max_val` is loop-carried (conditional write
 *                       every iter, read every iter for the division) which
 *                       prevents a clean Do-All or Reduction pattern.
 *                       Fix: loop fission — first a max-reduction pass,
 *                       then a do-all division pass.
 *                       Result: Reduction + Do-All on re-profiling.
 *
 *  dot_fused          — Dot-product accumulated into *dot while also writing
 *                       to squared[].  The mixed write pattern (array write +
 *                       scalar reduction) may prevent the explorer from
 *                       detecting a clean standalone Do-All for squared[].
 *                       Fix: loop fission — compute squared[] first (Do-All),
 *                       then accumulate *dot (Reduction).
 *                       Result: Do-All + Reduction on re-profiling.
 */

#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define N 80000

/* ── Hotspot 1: scalar_transform ────────────────────────────────────────── */
void scalar_transform(const float *arr, float *out, int n) {
    for (int i = 0; i < n; i++) {
        float temp = arr[i] * arr[i] + 1.0f;
        out[i] = temp / (arr[i] + 1.0f);
    }
}

/* ── Hotspot 2: normalize_fused ─────────────────────────────────────────── */
void normalize_fused(const float *arr, float *out, int n) {
    float max_val = arr[0];
    for (int i = 1; i < n; i++)
        if (arr[i] > max_val) max_val = arr[i];
    for (int i = 0; i < n; i++)
        out[i] = arr[i] / max_val;
}

/* ── Hotspot 3: dot_fused ───────────────────────────────────────────────── */
void dot_fused(const int *a, const int *b, int *squared, long *dot, int n) {
    for (int i = 0; i < n; i++)
        squared[i] = a[i] * a[i];
    *dot = 0L;
    for (int i = 0; i < n; i++)
        *dot += (long)(a[i] * b[i]);
}

/* ── Driver ─────────────────────────────────────────────────────────────── */
int main(void) {
    float *farr    = (float *)malloc(N * sizeof(float));
    float *fout1   = (float *)malloc(N * sizeof(float));
    float *fout2   = (float *)malloc(N * sizeof(float));
    int   *a       = (int   *)malloc(N * sizeof(int));
    int   *b       = (int   *)malloc(N * sizeof(int));
    int   *squared = (int   *)malloc(N * sizeof(int));
    long   dot     = 0L;

    for (int i = 0; i < N; i++) {
        farr[i] = (float)(i % 200 + 1);
        a[i]    =  i % 50;
        b[i]    = (i * 3) % 50;
    }

    scalar_transform(farr, fout1, N);
    normalize_fused(farr, fout2, N);
    dot_fused(a, b, squared, &dot, N);

    printf("fout1[0]=%.4f  fout2[N-1]=%.4f  dot=%ld\n",
           fout1[0], fout2[N - 1], dot);

    free(farr); free(fout1); free(fout2);
    free(a); free(b); free(squared);
    return 0;
}
